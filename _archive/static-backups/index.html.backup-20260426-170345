        .features-hero p {
            font-size: 13px;
            color: var(--text-m);
        }
        .features-tab-nav {
            display: flex;
            gap: 2px;
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
            flex-shrink: 0;
            overflow-x: auto;
        }
        .features-tab-nav::-webkit-scrollbar {
            height: 2px;
        }
        .features-tab-nav::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 2px;
        }
        .feature-tab-btn {
            padding: 12px 18px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-d);
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: all .15s;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 7px;
