            font-size: 12px;
            color: var(--accent-l);
            font-weight: 600;
        }
        #cmdPalette {
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(0, 0, 0, .7);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding-top: 15vh;
            opacity: 0;
            pointer-events: none;
            transition: opacity .15s;
        }
        #cmdPalette.active {
            opacity: 1;
            pointer-events: all;
        }
        .cmd-box {
            width: 580px;
            max-width: calc(100vw - 48px);
            background: var(--bg-card);
            border: 1px solid var(--border-s);
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: 0 24px 64px rgba(0, 0, 0, .5);
        }
        .cmd-input-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
        }
        .cmd-input-row .material-symbols-outlined {
            font-size: 20px;
            color: var(--text-d);
        }
        #cmdInput {
            flex: 1;
            background: none;
            border: none;
            box-shadow: none;
            font-size: 15px;
            font-weight: 500;
            color: var(--text);
            padding: 0;
        }
        #cmdInput:focus {
            box-shadow: none;
            border-color: transparent;
        }
        .cmd-results {
            max-height: 360px;
            overflow-y: auto;
            padding: 8px 0;
        }
        .cmd-results::-webkit-scrollbar {
            width: 4px;
        }
        .cmd-results::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }
        .cmd-section-label {
            padding: 4px 20px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--text-d);
        }
        .cmd-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 20px;
            cursor: pointer;
            transition: background .1s;
        }
        .cmd-item:hover,
        .cmd-item.selected {
            background: var(--bg-elevated);
        }
        .cmd-item .material-symbols-outlined {
            font-size: 18px;
            color: var(--text-d);
        }
        .cmd-item-text {
            flex: 1;
            font-size: 13px;
            font-weight: 500;
        }
        .cmd-item-sub {
            font-size: 11px;
            color: var(--text-d);
        }
        .cmd-kbd {
            font-size: 10px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-s);
            border-radius: 4px;
            padding: 2px 6px;
            color: var(--text-d);
            font-family: monospace;
        }
        .cmd-footer {
            padding: 8px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 16px;
        }
        .cmd-hint {
            font-size: 11px;
            color: var(--text-d);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        #toastContainer {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 300;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }
        .toast {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-s);
            border-radius: var(--radius);
            padding: 10px 16px;
            min-width: 200px;
            max-width: 320px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text);
            box-shadow: var(--shadow);
            animation: toastIn .2s ease;
            transition: opacity .3s, transform .3s;
        }
        .toast .material-symbols-outlined {
            font-size: 18px;
            flex-shrink: 0;
        }
        .toast.success .material-symbols-outlined {
            color: var(--success);
        }
        .toast.error .material-symbols-outlined {
            color: var(--danger);
        }
        .toast.info .material-symbols-outlined {
            color: var(--accent-l);
        }
        .toast.warning .material-symbols-outlined {
            color: var(--warning);
        }
        .toast.premium .material-symbols-outlined {
            color: var(--gold);
        }
        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: none;
            }
        }
        .chat-turn {
            border: 1px solid var(--border-s);
            border-radius: var(--radius);
            overflow: hidden;
            margin-bottom: 8px;
            background: var(--bg-elevated);
        }
        .chat-turn-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
        }
        .chat-turn-role {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
        }
        .chat-role-select {
            border: none;
            box-shadow: none;
            padding: 2px 4px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            background: transparent;
            cursor: pointer;
        }
        .chat-role-select:focus {
            box-shadow: none;
        }
        .chat-turn-btn {
            width: 24px;
            height: 24px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-d);
            transition: background .15s, color .15s;
            cursor: pointer;
        }
        .chat-turn-btn:hover {
            background: var(--bg-elevated);
            color: var(--text-m);
        }
        .chat-turn-btn.danger:hover {
            color: var(--danger);
        }
        .chat-turn-btn .material-symbols-outlined {
            font-size: 14px;
        }
        .chat-turn-content {
            width: 100%;
            border: none;
            box-shadow: none;
            border-radius: 0;
            background: var(--bg-elevated);
            padding: 10px 12px;
            font-size: 13px;
            line-height: 1.6;
            resize: vertical;
            min-height: 60px;
        }
        .chat-turn-content:focus {
            box-shadow: none;
            border-color: transparent;
        }
        .inline-add-btn {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: var(--radius);
            background: var(--bg-elevated);
            border: 1px solid var(--border-s);
            color: var(--text-m);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .15s, color .15s;
        }
        .inline-add-btn:hover {
            background: var(--accent-muted);
            color: var(--accent-l);
            border-color: rgba(99, 102, 241, .3);
        }
        .inline-add-btn .material-symbols-outlined {
            font-size: 18px;
        }
        .hidden {
            display: none !important;
        }
        .relative {
            position: relative;
        }
        hr.divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 4px 0;
        }
        .tab-lock {
            margin-left: auto;
            font-size: 12px;
            color: var(--gold);
            opacity: .7;
        }
        .nav-lock {
            margin-left: auto;
        }

        @media (max-width: 900px) {
            .prompt-card {
                width: calc(50% - 8px);
                min-width: 200px;
            }
            .blog-card {
                width: calc(50% - 10px);
                min-width: 220px;
            }
            .features-tab-content {
                flex-direction: column;
            }
            .feature-visual {
                width: 100%;
                height: 160px;
            }
        }
        @media (max-width: 600px) {
            .prompt-card {
                width: 100%;
                min-width: 0;
            }
            .blog-card {
                width: 100%;
                min-width: 0;
            }
            #sidebar {
                width: 0 !important;
                border-right-width: 0;
            }
            #detailPanel.open {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div id="app">
