                        uses: 35, isFav: false, hasVars: true },
                    { title: 'Blog Post Outline', preview: 'Generate a detailed blog post outline for the topic...', colour: 'teal',
                        icon: 'article', category: 'Marketing', tags: 'blog, content', rating: 5, uses: 19, isFav: false,
