            flex: 1;
            align-content: flex-start;
        }
        .blog-card {
            width: calc(33.333% - 12px);
            min-width: 260px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-l);
            overflow: hidden;
            cursor: pointer;
            transition: all var(--transition-smooth);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
