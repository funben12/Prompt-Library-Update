            box-shadow: var(--card-shadow);
            transform: translateY(-2px);
            background: var(--bg-card-h);
        }
        .prompt-card.selected {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-muted);
        }
        .prompt-card .card-colour-strip {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }
        .prompt-card .card-colour-strip.red {
            background: #ef4444;
        }
        .prompt-card .card-colour-strip.orange {
            background: #f97316;
        }
        .prompt-card .card-colour-strip.yellow {
            background: #eab308;
        }
        .prompt-card .card-colour-strip.green {
            background: #22c55e;
        }
        .prompt-card .card-colour-strip.teal {
            background: #14b8a6;
        }
        .prompt-card .card-colour-strip.blue {
            background: #3b82f6;
        }
        .prompt-card .card-colour-strip.purple {
            background: #a855f7;
        }
        .prompt-card .card-colour-strip.pink {
            background: #ec4899;
        }
        .prompt-card .card-colour-strip.none {
            background: transparent;
        }
        .card-header-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card-header-row .material-symbols-outlined {
            font-size: 20px;
            color: var(--accent-l);
            flex-shrink: 0;
        }
        .card-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .card-fav-icon {
            font-size: 14px;
            color: var(--rose);
            flex-shrink: 0;
            font-variation-settings: 'FILL' 1;
        }
        .card-preview {
            font-size: 12px;
            color: var(--text-d);
            line-height: 1.5;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
        }
        .card-meta-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10.5px;
            color: var(--text-d);
        }
        .card-meta-item {
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .card-meta-item .material-symbols-outlined {
            font-size: 12px;
        }
        .card-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .card-rating {
            font-size: 11px;
            color: var(--gold);
            letter-spacing: .04em;
        }

        .list-group-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px 8px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--text-d);
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1;
            flex-shrink: 0;
        }
        .list-group-header .material-symbols-outlined {
            font-size: 14px;
        }
        .list-group-count {
            font-size: 10px;
            font-weight: 700;
            background: var(--bg-elevated);
            color: var(--text-d);
            padding: 1px 7px;
