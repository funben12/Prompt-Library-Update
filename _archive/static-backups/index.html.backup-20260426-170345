        }
        #blogView::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }
        .blog-filter-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
            flex-shrink: 0;
            align-items: center;
        }
        .blog-filter-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
