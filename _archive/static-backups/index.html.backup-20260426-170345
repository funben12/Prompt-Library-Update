        .feature-tab-btn:hover {
            color: var(--text-m);
        }
        .feature-tab-btn.active {
            color: var(--accent-l);
            border-bottom-color: var(--accent);
        }
        .feature-tab-btn .material-symbols-outlined {
            font-size: 16px;
        }
