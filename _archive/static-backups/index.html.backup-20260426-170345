    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const promptsList = document.getElementById('promptsList');
            const promptsGrid = document.getElementById('promptsGrid');
            const blogView = document.getElementById('blogView');
            const featuresView = document.getElementById('featuresView');
            const viewTitle = document.getElementById('viewTitle');
            const breadcrumb = document.getElementById('breadcrumb');
            const libraryFilterBar = document.getElementById('libraryFilterBar');
            const librarySortBar = document.getElementById('librarySortBar');
            const folderViewActions = document.getElementById('folderViewActions');
            const viewToggleGroup = document.getElementById('viewToggleGroup');
            const newPromptBtn = document.getElementById('newPromptBtn');
            let currentView = 'library';
            let currentViewMode = 'list';
            let activeBlogFilter = 'all';

            const navItems = document.querySelectorAll('.nav-item[data-view]');
            const viewToggleBtns = document.querySelectorAll('.view-toggle-btn');
            const blogFilterTags = document.querySelectorAll('.blog-filter-tag');
            const featureTabBtns = document.querySelectorAll('.feature-tab-btn');
            const featureTabContents = document.querySelectorAll('.features-tab-content');

            function setView(view) {
                currentView = view;
                navItems.forEach(n => n.classList.remove('active'));
                const navItem = document.querySelector(`.nav-item[data-view="${view}"]`);
                if (navItem) navItem.classList.add('active');
                promptsList.classList.add('hidden');
                promptsGrid.classList.remove('active');
                blogView.classList.remove('active');
                featuresView.classList.remove('active');
                if (libraryFilterBar) libraryFilterBar.classList.add('hidden');
                if (librarySortBar) librarySortBar.classList.add('hidden');
                if (folderViewActions) folderViewActions.style.display = 'none';
                if (viewToggleGroup) viewToggleGroup.classList.add('hidden');
                if (newPromptBtn) newPromptBtn.classList.add('hidden');
                switch (view) {
                    case 'library':
                        viewTitle.textContent = 'Library';
                        breadcrumb.textContent = 'PROMPTS';
                        if (libraryFilterBar) libraryFilterBar.classList.remove('hidden');
                        if (librarySortBar) librarySortBar.classList.remove('hidden');
                        if (viewToggleGroup) viewToggleGroup.classList.remove('hidden');
                        if (newPromptBtn) newPromptBtn.classList.remove('hidden');
                        if (currentViewMode === 'grid') {
                            promptsGrid.classList.add('active');
                            promptsList.classList.add('hidden');
                        } else {
                            promptsList.classList.remove('hidden');
                            promptsGrid.classList.remove('active');
                        }
                        break;
                    case 'blog':
                        viewTitle.textContent = 'Blog';
                        breadcrumb.textContent = 'ARTICLES';
                        blogView.classList.add('active');
                        break;
                    case 'features':
                        viewTitle.textContent = 'Features';
                        breadcrumb.textContent = 'EXPLORE';
                        featuresView.classList.add('active');
                        break;
                    case 'favorites':
                        viewTitle.textContent = 'Favorites';
                        breadcrumb.textContent = 'STARRED';
                        if (libraryFilterBar) libraryFilterBar.classList.remove('hidden');
                        if (librarySortBar) librarySortBar.classList.remove('hidden');
                        if (viewToggleGroup) viewToggleGroup.classList.remove('hidden');
                        if (newPromptBtn) newPromptBtn.classList.remove('hidden');
                        if (currentViewMode === 'grid') {
                            promptsGrid.classList.add('active');
                            promptsList.classList.add('hidden');
                        } else {
                            promptsList.classList.remove('hidden');
                            promptsGrid.classList.remove('active');
                        }
                        break;
                    default:
                        if (libraryFilterBar) libraryFilterBar.classList.remove('hidden');
                        if (librarySortBar) librarySortBar.classList.remove('hidden');
                        if (viewToggleGroup) viewToggleGroup.classList.remove('hidden');
                        if (newPromptBtn) newPromptBtn.classList.remove('hidden');
                        promptsList.classList.remove('hidden');
                }
            }

            navItems.forEach(item => {
                item.addEventListener('click', () => setView(item.dataset.view));
            });
            viewToggleBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    currentViewMode = btn.dataset.viewmode;
                    viewToggleBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    if (currentView === 'library' || currentView === 'favorites') {
                        if (currentViewMode === 'grid') {
                            promptsGrid.classList.add('active');
                            promptsList.classList.add('hidden');
                        } else {
                            promptsList.classList.remove('hidden');
                            promptsGrid.classList.remove('active');
                        }
                    }
                });
            });
            blogFilterTags.forEach(tag => {
                tag.addEventListener('click', () => {
                    activeBlogFilter = tag.dataset.blogFilter;
                    blogFilterTags.forEach(t => t.classList.remove('active'));
                    tag.classList.add('active');
                    filterBlogCards();
                });
            });
            featureTabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const feature = btn.dataset.feature;
                    featureTabBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    featureTabContents.forEach(c => c.classList.remove('active'));
                    const content = document.getElementById('feature-' + feature);
                    if (content) content.classList.add('active');
                });
            });

            function filterBlogCards() {
                const cards = document.querySelectorAll('.blog-card');
                cards.forEach(card => {
                    if (activeBlogFilter === 'all' || card.dataset.blogCategory === activeBlogFilter) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            function populateBlogCards() {
                const blogGrid = document.getElementById('blogGrid');
                if (!blogGrid) return;
                const blogPosts = [
                    { title: 'Mastering Prompt Variables', excerpt: 'Learn how to use dynamic placeholders to make your prompts reusable across different contexts and projects.',
                        category: 'development', imageIcon: 'code', date: 'Mar 12, 2026', readTime: '5 min', tag: 'Tips' },
                    { title: 'The Art of Prompt Chaining', excerpt: 'Build sophisticated AI workflows by linking multiple prompts together into a seamless chain of instructions.',
                        category: 'ai-ml', imageIcon: 'link', date: 'Mar 8, 2026', readTime: '7 min', tag: 'Advanced' },
                    { title: 'Organising Prompts for Teams', excerpt: 'Strategies for keeping your prompt library clean, searchable, and collaborative when working with a team.',
                        category: 'productivity', imageIcon: 'folder_special', date: 'Feb 28, 2026', readTime: '4 min',
                        tag: 'Guide' },
                    { title: 'Designing Prompts for Brand Voice', excerpt: 'Craft prompts that consistently produce on-brand copy by encoding your style guide into system instructions.',
                        category: 'marketing', imageIcon: 'campaign', date: 'Feb 20, 2026', readTime: '6 min', tag: 'Branding' },
                    { title: 'Colour-Coding Your Workflow', excerpt: 'Use visual labels to instantly identify prompt categories and streamline your daily AI interactions.',
                        category: 'design', imageIcon: 'palette', date: 'Feb 14, 2026', readTime: '3 min', tag: 'Workflow' },
                    { title: 'Analytics for Prompt Optimization', excerpt: 'Track which prompts perform best and use data to continuously refine your AI prompt collection.',
                        category: 'ai-ml', imageIcon: 'bar_chart', date: 'Feb 5, 2026', readTime: '8 min', tag: 'Data' },
                ];
                blogGrid.innerHTML = blogPosts.map(post => `
                <div class="blog-card" data-blog-category="${post.category}">
                    <div class="blog-card-image">
                        <span class="material-symbols-outlined">${post.imageIcon}</span>
                        <span class="blog-category-badge">${post.category.toUpperCase()}</span>
                    </div>
                    <div class="blog-card-body">
                        <h3 class="blog-card-title">${post.title}</h3>
                        <p class="blog-card-excerpt">${post.excerpt}</p>
                        <div class="blog-card-meta">
                            <span><span class="material-symbols-outlined">calendar_month</span> ${post.date}</span>
                            <span><span class="material-symbols-outlined">schedule</span> ${post.readTime} read</span>
                        </div>
                    </div>
                    <div class="blog-card-footer">
                        <span class="blog-tag-pill">${post.tag}</span>
                        <span style="font-size:11px;color:var(--accent-l);font-weight:600">Read more →</span>
                    </div>
                </div>`).join('');
                filterBlogCards();
                const blogCount = document.getElementById('blogCount');
                if (blogCount) blogCount.textContent = blogPosts.length;
            }

            function populateDemoCards() {
                const promptsGridEl = document.getElementById('promptsGrid');
                if (!promptsGridEl || promptsGridEl.children.length > 0) return;
                const demoPrompts = [
                    { title: 'Code Quality Reviewer', preview: 'Review the following code for best practices, performance, and security...',
                        colour: 'blue', icon: 'code', category: 'Development', tags: 'code, review', rating: 4,
                        uses: 23, isFav: true },
                    { title: 'Marketing Email Generator', preview: 'Create a compelling marketing email for the following product...', colour: 'green',
                        icon: 'mail', category: 'Marketing', tags: 'email, copy', rating: 5, uses: 47, isFav: false },
                    { title: 'UI Design Critique', preview: 'Analyze this UI design and provide actionable feedback on usability...',
                        colour: 'purple', icon: 'design_services', category: 'Design', tags: 'ui, review', rating: 3,
                        uses: 12, isFav: true },
                    { title: 'Meeting Notes Summarizer', preview: 'Summarize the following meeting transcript into key points and action items...',
                        colour: 'orange', icon: 'summarize', category: 'Productivity', tags: 'meetings, notes', rating: 4,
                        uses: 35, isFav: false },
                    { title: 'Blog Post Outline', preview: 'Generate a detailed blog post outline for the topic: {{topic}}...', colour: 'teal',
                        icon: 'article', category: 'Marketing', tags: 'blog, content', rating: 5, uses: 19, isFav: false },
                    { title: 'SQL Query Optimizer', preview: 'Analyze and optimize the following SQL query for better performance...',
                        colour: 'blue', icon: 'database', category: 'Development', tags: 'sql, database', rating: 4,
                        uses: 28, isFav: true },
                ];
                promptsGridEl.innerHTML = demoPrompts.map(p => `
                <div class="prompt-card">
                    <div class="card-colour-strip ${p.colour}"></div>
                    <div class="card-header-row">
                        <span class="material-symbols-outlined">${p.icon}</span>
                        <span class="card-title">${p.title}</span>
                        ${p.isFav ? '<span class="card-fav-icon material-symbols-outlined">favorite</span>' : ''}
                    </div>
                    <p class="card-preview">${p.preview}</p>
                    <div class="card-meta-row">
                        <span class="card-meta-item"><span class="material-symbols-outlined">category</span> ${p.category}</span>
                        <span class="card-meta-item"><span class="material-symbols-outlined">bolt</span> ${p.uses} uses</span>
                    </div>
                    <div class="card-chips">
                        ${p.tags.split(',').map(t => `<span class="chip chip-tag">${t.trim()}</span>`).join('')}
                        ${p.rating > 0 ? `<span class="card-rating">${'★'.repeat(p.rating)}${'☆'.repeat(5-p.rating)}</span>` : ''}
                    </div>
                </div>`).join('');
                const libraryCount = document.getElementById('libraryCount');
                if (libraryCount) libraryCount.textContent = demoPrompts.length;
            }

            function populateDemoList() {
                if (promptsList.children.length > 0) return;
                const demoPrompts = [
                    { title: 'Code Quality Reviewer', preview: 'Review the following code for best practices, performance, and security...',
                        colour: 'blue', icon: 'code', category: 'Development', tags: 'code, review', rating: 4,
                        uses: 23, isFav: true, hasVars: true },
                    { title: 'Marketing Email Generator', preview: 'Create a compelling marketing email for the following product...',
