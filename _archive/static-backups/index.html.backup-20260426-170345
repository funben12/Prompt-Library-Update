        /* ── PROMPT CARD GRID ── */
        #promptsGrid {
            flex: 1;
            overflow-y: auto;
            display: none;
            flex-wrap: wrap;
            gap: 14px;
            padding: 16px 20px;
            align-content: flex-start;
        }
        #promptsGrid.active {
            display: flex;
        }
        #promptsGrid::-webkit-scrollbar {
            width: 6px;
        }
        #promptsGrid::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }
        .prompt-card {
            width: calc(33.333% - 10px);
            min-width: 240px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-l);
            padding: 18px 16px 14px;
            cursor: pointer;
            transition: all var(--transition-smooth);
