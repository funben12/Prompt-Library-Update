        }
        .blog-card-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            line-height: 1.3;
        }
        .blog-card-excerpt {
            font-size: 12px;
            color: var(--text-m);
            line-height: 1.6;
            flex: 1;
        }
        .blog-card-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 11px;
            color: var(--text-d);
        }
        .blog-card-meta .material-symbols-outlined {
            font-size: 13px;
        }
        .blog-card-footer {
            padding: 10px 16px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .blog-card-footer .blog-tag-pill {
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            background: var(--bg-elevated);
            color: var(--text-d);
        }

        /* ── FEATURE TABS VIEW ── */
        #featuresView {
            display: none;
            flex: 1;
            overflow-y: auto;
            flex-direction: column;
        }
        #featuresView.active {
            display: flex;
        }
        #featuresView::-webkit-scrollbar {
            width: 6px;
        }
        #featuresView::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }
        .features-hero {
            padding: 32px 24px;
