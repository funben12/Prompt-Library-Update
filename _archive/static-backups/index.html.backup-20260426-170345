            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .colour-dot.red {
            background: #ef4444;
        }
        .colour-dot.orange {
            background: #f97316;
        }
        .colour-dot.yellow {
            background: #eab308;
        }
        .colour-dot.green {
            background: #22c55e;
        }
        .colour-dot.teal {
            background: #14b8a6;
        }
        .colour-dot.blue {
            background: #3b82f6;
        }
        .colour-dot.purple {
            background: #a855f7;
        }
        .colour-dot.pink {
            background: #ec4899;
        }
        .colour-dot.none {
            background: var(--border-s);
