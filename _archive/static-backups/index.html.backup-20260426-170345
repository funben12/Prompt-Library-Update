                <div class="prompt-row">
                    <div class="row-colbar ${p.colour}"></div>
                    <div class="row-icon"><span class="material-symbols-outlined">${p.icon}</span></div>
                    <div class="row-body">
                        <div class="row-title-line">
                            <span class="row-title">${p.title}</span>
                            ${p.isFav ? '<span class="row-fav-icon material-symbols-outlined">favorite</span>' : ''}
                            ${p.rating > 0 ? `<span class="row-rating">${'★'.repeat(p.rating)}</span>` : ''}
                        </div>
                        <div class="row-preview">${p.preview}</div>
                        <div class="row-meta">
                            <span class="row-meta-item"><span class="material-symbols-outlined">category</span>${p.category}</span>
                            <span class="row-meta-sep">·</span>
                            <span class="row-meta-item"><span class="material-symbols-outlined">bolt</span>${p.uses} uses</span>
                            <span class="row-meta-sep">·</span>
                            <span class="row-meta-item">${p.tags}</span>
                        </div>
                    </div>
                    <div class="row-chips">
                        ${p.hasVars ? '<span class="chip chip-vars"><span class="material-symbols-outlined">token</span>3 vars</span>' : ''}
                        <span class="chip chip-cat">${p.category}</span>
                    </div>
                    <div class="row-actions">
                        <button class="card-btn"><span class="material-symbols-outlined">edit</span></button>
                        <button class="card-btn fav-on"><span class="material-symbols-outlined">favorite</span></button>
                        <button class="row-use-btn"><span class="material-symbols-outlined">play_arrow</span></button>
                    </div>
                </div>`).join('');
                const libraryCount = document.getElementById('libraryCount');
                if (libraryCount) libraryCount.textContent = demoPrompts.length;
            }

            populateBlogCards();
            populateDemoCards();
            populateDemoList();
            setView('library');
        });

        function toggleSidebar() {
            document.body.classList.toggle('sidebar-hidden');
        }

        function toggleSidebarSection(name) {
            const content = document.getElementById('sidebar-' + name + '-content');
            const chevron = document.getElementById('sidebar-' + name + '-chevron');
            if (content) content.classList.toggle('collapsed');
            if (chevron) chevron.textContent = content && content.classList.contains('collapsed') ? 'expand_more' :
                'expand_less';
        }

        function clearAllFilters() { /* placeholder */ }

        function createFolderInline() { /* placeholder */ }
    </script>
</body>
