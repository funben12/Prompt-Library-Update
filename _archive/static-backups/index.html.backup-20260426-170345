<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prompt Library Pro</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        :root {
            --bg: #0b0f1a;
            --bg-card: #131929;
            --bg-card-h: #1a2338;
            --bg-elevated: #1e293b;
            --bg-input: #0f172a;
            --border: rgba(255, 255, 255, 0.07);
            --border-s: rgba(255, 255, 255, 0.12);
            --accent: #6366f1;
            --accent-l: #818cf8;
            --accent-muted: rgba(99, 102, 241, 0.15);
            --accent-glow: rgba(99, 102, 241, 0.25);
            --text: #f1f5f9;
            --text-m: #94a3b8;
            --text-d: #475569;
            --danger: #ef4444;
            --danger-muted: rgba(239, 68, 68, 0.12);
            --success: #22c55e;
            --warning: #f59e0b;
            --rose: #f43f5e;
            --gold: #f59e0b;
            --sidebar-w: 260px;
            --detail-w: 440px;
            --radius: 12px;
            --radius-l: 16px;
            --radius-xl: 20px;
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
            --transition-smooth: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        }

        [data-theme="light"] {
            --bg: #f8fafc;
            --bg-card: #ffffff;
            --bg-card-h: #f1f5f9;
            --bg-elevated: #e2e8f0;
            --bg-input: #ffffff;
            --border: rgba(0, 0, 0, 0.08);
            --border-s: rgba(0, 0, 0, 0.14);
            --accent: #6366f1;
            --accent-l: #4f46e5;
            --accent-muted: rgba(99, 102, 241, 0.1);
            --accent-glow: rgba(99, 102, 241, 0.2);
            --text: #0f172a;
            --text-m: #475569;
            --text-d: #94a3b8;
            --danger: #dc2626;
            --danger-muted: rgba(220, 38, 38, 0.08);
            --success: #16a34a;
            --warning: #d97706;
            --rose: #e11d48;
            --gold: #d97706;
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html,
        body {
            height: 100%;
            overflow: hidden;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            line-height: 1.5;
            -webkit-tap-highlight-color: transparent;
            transition: background 0.2s, color 0.2s;
        }
        button {
            cursor: pointer;
            border: none;
            background: none;
            font-family: inherit;
            color: inherit;
        }
        input,
        textarea,
        select {
            font-family: inherit;
            font-size: 14px;
            outline: none;
            background: var(--bg-input);
            color: var(--text);
            border: 1px solid var(--border-s);
            border-radius: var(--radius);
            padding: 10px 14px;
            transition: border-color .2s, background .2s;
        }
        input:focus,
        textarea:focus,
        select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-muted);
        }
        select {
            appearance: none;
            cursor: pointer;
        }
        textarea {
            resize: vertical;
        }
        a {
            color: var(--accent-l);
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
            user-select: none;
        }

        #app {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ── SIDEBAR ── */
        #sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border);
            background: var(--bg-card);
            overflow: hidden;
            transition: background .2s, width var(--transition-smooth);
            z-index: 10;
        }
        body.sidebar-hidden #sidebar {
            width: 0 !important;
            border-right-width: 0;
        }
        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 16px 14px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }
        .brand-icon .material-symbols-outlined {
            font-size: 18px;
            font-variation-settings: 'FILL' 1, 'wght' 600;
        }
        .brand-text {
            flex: 1;
            min-width: 0;
        }
        .brand-name {
            font-weight: 800;
            font-size: 14px;
            color: var(--text);
            display: block;
        }
        .brand-sub {
            font-size: 10px;
            color: var(--text-d);
            display: block;
        }
        .premium-badge {
            display: none;
            align-items: center;
            gap: 3px;
            background: linear-gradient(135deg, #f59e0b, #f97316);
            color: white;
            font-size: 9px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 10px;
            letter-spacing: .06em;
        }
        .premium-badge .material-symbols-outlined {
            font-size: 11px;
            font-variation-settings: 'FILL' 1;
        }
        .premium-badge.show {
            display: flex;
        }

        .sidebar-nav {
            padding: 10px 8px 4px;
            flex-shrink: 0;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 9px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-m);
            transition: background .15s, color .15s;
            cursor: pointer;
            position: relative;
        }
        .nav-item:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .nav-item.active {
            background: var(--accent-muted);
            color: var(--accent-l);
            font-weight: 600;
        }
        .nav-item .material-symbols-outlined {
            font-size: 18px;
        }
        .nav-count {
            margin-left: auto;
            font-size: 10px;
            font-weight: 700;
            background: var(--bg-elevated);
            color: var(--text-d);
            padding: 1px 6px;
            border-radius: 20px;
            min-width: 20px;
            text-align: center;
        }
        .nav-lock {
            margin-left: auto;
            font-size: 12px;
            color: var(--gold);
            opacity: 0.7;
        }

        #sidebarScroll {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }
        #sidebarScroll::-webkit-scrollbar {
            width: 4px;
        }
        #sidebarScroll::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }

        .sidebar-section-label {
            padding: 12px 16px 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--text-d);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border);
            margin-top: 4px;
        }
        #sidebarScroll>.sidebar-section-label:first-child {
            border-top: none;
            margin-top: 0;
        }
        .sidebar-collapsible {
            cursor: pointer;
            user-select: none;
            transition: color .15s;
        }
        .sidebar-collapsible:hover {
            color: var(--text);
        }
        .sidebar-collapse-icon {
            font-size: 14px;
            color: var(--text-d);
            transition: transform .2s;
        }
        .sidebar-section-content {
            overflow: hidden;
        }
        .sidebar-section-content.collapsed {
            display: none;
        }

        #foldersList {
            padding: 0 8px 4px;
        }
        .sidebar-filter-list {
            padding: 0 8px 8px;
        }
        .sidebar-filter-item {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 7px 10px;
            border-radius: 8px;
            font-size: 12px;
            color: var(--text-m);
            cursor: pointer;
            transition: background .15s, color .15s;
            text-align: left;
        }
        .sidebar-filter-item:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .sidebar-filter-item.active {
            background: var(--accent-muted);
            color: var(--accent-l);
            font-weight: 600;
        }
        .sidebar-filter-item .material-symbols-outlined {
            font-size: 14px;
            flex-shrink: 0;
        }
        .sidebar-filter-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500;
        }
        .sidebar-filter-empty {
            display: block;
            padding: 4px 10px 8px;
            font-size: 11px;
            color: var(--text-d);
            font-style: italic;
        }

        .sidebar-icon-btn {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-d);
            transition: background .15s, color .15s;
        }
        .sidebar-icon-btn:hover {
            background: var(--bg-elevated);
            color: var(--accent-l);
        }
        .sidebar-icon-btn .material-symbols-outlined {
            font-size: 15px;
        }

        .folder-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 12px;
            color: var(--text-m);
            cursor: pointer;
            transition: background .15s, color .15s;
            position: relative;
        }
        .folder-item:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .folder-item.active {
            background: var(--accent-muted);
            color: var(--accent-l);
        }
        .folder-item .material-symbols-outlined {
            font-size: 15px;
            flex-shrink: 0;
        }
        .folder-item-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500;
        }
        .folder-count {
            font-size: 10px;
            color: var(--text-d);
            flex-shrink: 0;
        }
        .fi-actions {
            display: none;
            gap: 2px;
            flex-shrink: 0;
        }
        .folder-item:hover .fi-actions {
            display: flex;
        }
        .fi-btn {
            width: 22px;
            height: 22px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-d);
            transition: background .15s, color .15s;
        }
        .fi-btn:hover {
            background: var(--bg-card);
            color: var(--text);
        }
        .fi-btn.danger:hover {
            color: var(--danger);
        }
        .fi-btn .material-symbols-outlined {
            font-size: 13px;
        }

        .sidebar-footer {
            padding: 10px 8px 14px;
            border-top: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .sidebar-footer-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 12px;
            color: var(--text-m);
            transition: background .15s, color .15s;
            width: 100%;
        }
        .sidebar-footer-btn:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .sidebar-footer-btn .material-symbols-outlined {
            font-size: 16px;
        }
        .sidebar-footer-row {
            display: flex;
            gap: 4px;
        }
        .sidebar-footer-row .sidebar-footer-btn {
            flex: 1;
        }

        /* ── MAIN CONTENT ── */
        #mainContent {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--bg);
        }
        #contentHeader {
            padding: 16px 24px 0;
            flex-shrink: 0;
        }
        .header-row-1 {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }
        .header-title-group {
            min-width: 0;
        }
        #breadcrumb {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-d);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        #viewTitle {
            font-size: 20px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.2;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        #newPromptBtn {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--accent);
            color: white;
            padding: 9px 16px;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 700;
            transition: background .15s, transform .1s;
            box-shadow: 0 4px 12px var(--accent-glow);
        }
        #newPromptBtn:hover {
            background: #4f52e0;
        }
        #newPromptBtn:active {
            transform: scale(.97);
        }
        #newPromptBtn .material-symbols-outlined {
            font-size: 16px;
        }
        .icon-header-btn {
            width: 38px;
            height: 38px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-elevated);
            border: 1px solid var(--border-s);
            color: var(--text-m);
            transition: background .15s, color .15s;
        }
        .icon-header-btn:hover {
            background: var(--bg-card-h);
            color: var(--text);
        }
        .icon-header-btn .material-symbols-outlined {
            font-size: 18px;
        }
        #folderViewActions {
            display: none;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }
        .fva-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid var(--border-s);
            background: var(--bg-card);
            color: var(--text-m);
            transition: background .15s, color .15s;
        }
        .fva-btn:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .fva-btn.danger:hover {
            border-color: rgba(239, 68, 68, .4);
            color: var(--danger);
            background: var(--danger-muted);
        }
        .fva-btn .material-symbols-outlined {
            font-size: 14px;
        }

        .filter-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0;
            flex-wrap: wrap;
            padding-bottom: 10px;
        }
        #searchWrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }
        #searchWrap .material-symbols-outlined {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-d);
            font-size: 18px;
            pointer-events: none;
        }
        #searchInput {
            width: 100%;
            padding: 10px 14px 10px 40px;
            border-radius: var(--radius);
            font-size: 13px;
        }
        .filter-chip {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            border: 1px solid var(--border-s);
            background: var(--bg-card);
            color: var(--text-m);
            cursor: pointer;
            transition: all .15s;
            white-space: nowrap;
        }
        .filter-chip:hover {
            background: var(--bg-elevated);
            color: var(--text);
        }
        .filter-chip.active {
            background: var(--accent-muted);
            color: var(--accent-l);
            border-color: rgba(99, 102, 241, .3);
        }
        .filter-chip .material-symbols-outlined {
            font-size: 13px;
        }
        #viewCount {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-d);
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        .sort-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: var(--bg-card);
            flex-shrink: 0;
        }
        .sort-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--text-d);
            white-space: nowrap;
        }
        .sort-select {
            padding: 5px 10px;
            font-size: 11px;
            border-radius: 8px;
            min-width: 150px;
            cursor: pointer;
        }
        .sort-spacer {
            flex: 1;
        }
        .sort-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            border: 1px solid var(--border-s);
            background: var(--bg-elevated);
            color: var(--text-m);
            cursor: pointer;
            transition: all .15s;
            white-space: nowrap;
        }
        .sort-btn:hover {
            background: var(--bg-card-h);
            color: var(--text);
        }
        .sort-btn.active {
            background: var(--accent-muted);
            color: var(--accent-l);
            border-color: rgba(99, 102, 241, .3);
        }
        .sort-btn .material-symbols-outlined {
            font-size: 14px;
        }
        .view-toggle-group {
            display: flex;
            gap: 2px;
            background: var(--bg-elevated);
            border-radius: 8px;
            padding: 2px;
        }
        .view-toggle-btn {
            padding: 4px 9px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-d);
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            transition: all .15s;
        }
        .view-toggle-btn.active {
            background: var(--bg-card);
            color: var(--text);
            box-shadow: 0 1px 3px rgba(0, 0, 0, .2);
        }
        .view-toggle-btn:hover {
            color: var(--text);
        }
        .view-toggle-btn .material-symbols-outlined {
            font-size: 15px;
        }

        /* ── PROMPT LIST (ROW VIEW) ── */
        #promptsList {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }
        #promptsList::-webkit-scrollbar {
            width: 6px;
        }
        #promptsList::-webkit-scrollbar-thumb {
            background: var(--bg-elevated);
            border-radius: 4px;
        }

        .prompt-row {
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: background .1s;
            position: relative;
            min-height: 68px;
            flex-shrink: 0;
        }
        .prompt-row:hover {
            background: rgba(255, 255, 255, .022);
        }
        .prompt-row.selected {
            background: var(--accent-muted);
        }
        .prompt-row.selected::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--accent-l);
        }
        [data-theme="light"] .prompt-row:hover {
            background: rgba(0, 0, 0, .03);
        }
        [data-theme="light"] .prompt-row.selected {
            background: rgba(99, 102, 241, .08);
        }

        .row-colbar {
            width: 3px;
            align-self: stretch;
            flex-shrink: 0;
        }
        .row-colbar.red {
            background: #ef4444;
        }
        .row-colbar.orange {
            background: #f97316;
        }
        .row-colbar.yellow {
            background: #eab308;
        }
        .row-colbar.green {
            background: #22c55e;
        }
        .row-colbar.teal {
            background: #14b8a6;
        }
        .row-colbar.blue {
            background: #3b82f6;
        }
        .row-colbar.purple {
            background: #a855f7;
        }
        .row-colbar.pink {
            background: #ec4899;
        }
        .row-colbar.none {
            background: transparent;
        }

        .row-icon {
            width: 50px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .row-icon .material-symbols-outlined {
            font-size: 18px;
        }
        .row-body {
            flex: 1;
            min-width: 0;
            padding: 12px 0;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .row-title-line {
            display: flex;
            align-items: center;
            gap: 7px;
            overflow: hidden;
        }
        .row-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
            min-width: 0;
        }
        .row-fav-icon {
            font-size: 13px;
            color: var(--rose);
            flex-shrink: 0;
            font-variation-settings: 'FILL' 1;
        }
        .row-rating {
            font-size: 11px;
            color: var(--gold);
            flex-shrink: 0;
            letter-spacing: .04em;
        }
        .row-preview {
