        }
        .feature-info p {
            font-size: 13px;
            color: var(--text-m);
            line-height: 1.7;
            margin-bottom: 12px;
        }
        .feature-info .feature-bullet {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-m);
            margin-bottom: 6px;
