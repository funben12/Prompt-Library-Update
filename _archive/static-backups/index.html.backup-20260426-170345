            gap: 12px;
            color: var(--text-d);
        }
        .empty-state .material-symbols-outlined {
            font-size: 44px;
            opacity: .4;
        }
        .empty-state h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-m);
        }
        .empty-state p {
            font-size: 13px;
            text-align: center;
        }

        /* ── BLOG VIEW ── */
        #blogView {
            display: none;
            flex: 1;
            overflow-y: auto;
            flex-direction: column;
        }
        #blogView.active {
