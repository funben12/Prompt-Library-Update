        return `
          <div class="filter-list-item" onclick="window.PL_filterByCategory(${safe})">
            <span class="material-symbols-outlined">category</span>
            <span>${escapeHtml(c.value)}</span>
            <span class="filter-count">${c.count}</span>
          </div>`;
      }).join('');
    }
  }
  if (tags) {
    if (!state.filters.tags.length) {
      tags.innerHTML = '<p class="filter-list-empty">None yet</p>';
    } else {
      tags.innerHTML = state.filters.tags.map(t => {
        const safe = JSON.stringify(t.value).replace(/'/g, '&#39;');
        return `
          <div class="filter-list-item" onclick="window.PL_filterByTag(${safe})">
            <span class="material-symbols-outlined">tag</span>
