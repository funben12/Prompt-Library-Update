function updateChainSelect(currentId) {
  const sel = $('#chainPromptSelect');
  if (!sel) return;
  sel.innerHTML = '<option value="">Select a prompt to add...</option>' +
    state.prompts.filter(p => p.id !== currentId)
      .map(p => `<option value="${p.id}">${escapeHtml(p.title)}</option>`).join('');
