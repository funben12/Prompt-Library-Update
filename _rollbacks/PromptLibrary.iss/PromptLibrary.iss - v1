//  Runs before anything is shown.
// ---------------------------------------------------------------------------
function InitializeSetup(): Boolean;
begin
  Result := True;
  // Inno Setup handles upgrades automatically via AppId.
  // Add custom upgrade logic here if needed in future versions.
end;


// ---------------------------------------------------------------------------
//  CurStepChanged
//  Fires at each stage of the install.
// ---------------------------------------------------------------------------
procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
  begin
    // Reserved for pre-install cleanup in future versions.
  end;
end;


// ---------------------------------------------------------------------------
//  InitializeUninstall
//  Confirms the user wants to uninstall before proceeding.
// ---------------------------------------------------------------------------
function InitializeUninstall(): Boolean;
begin
  Result := MsgBox(
    'Are you sure you want to uninstall {#AppName}?' + Chr(13) + Chr(10) + Chr(13) + Chr(10) +
    'Your saved prompts in Documents\{#AppDataFolder} will NOT be deleted.',
    mbConfirmation, MB_YESNO
  ) = IDYES;
end;
