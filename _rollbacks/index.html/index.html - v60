<div id="chainWorkspace" role="dialog" aria-modal="true" aria-label="Prompt Chain">
  <div class="ws-header">
    <div class="ws-header-left">
      <span class="material-symbols-outlined ws-header-icon">account_tree</span>
      <div>
        <h2 class="ws-title">Prompt Chain</h2>
        <p class="ws-subtitle">Build a sequence of prompt steps. Each step's output feeds the next as <code>{{input}}</code>.</p>
      </div>
    </div>
    <div class="ws-header-actions">
      <button class="btn btn-ghost" id="chainAddStepBtn"><span class="material-symbols-outlined">add</span> Add Step</button>
      <button class="btn btn-ghost" id="chainClearBtn"><span class="material-symbols-outlined">restart_alt</span> Clear</button>
      <button class="btn btn-ghost" id="chainRunAllBtn"><span class="material-symbols-outlined">play_circle</span> Run Chain</button>
      <button class="btn btn-accent" id="chainSaveBtn"><span class="material-symbols-outlined">save</span> Save Chain</button>
      <button class="icon-btn" id="closeChainBtn" aria-label="Close Chain"><span class="material-symbols-outlined">close</span></button>
    </div>
  </div>
  <div class="ws-body chain-body">
    <div class="chain-seed">
      <label class="forge-label"><span class="material-symbols-outlined">input</span> Initial Input <span class="forge-hint">What gets passed into Step 1 as <code>{{input}}</code></span></label>
      <textarea id="chainSeedInput" class="forge-input" rows="3" placeholder="Paste the raw material — a document, a brief, a question — that starts the chain..."></textarea>
    </div>
    <div class="chain-steps-wrap">
      <div id="chainStepsList" class="chain-steps-list">
        <!-- steps injected by JS -->
      </div>
    </div>
    <div class="chain-final-output" id="chainFinalOutput" hidden>
      <div class="chain-final-header">
        <span class="material-symbols-outlined" style="color:var(--success)">check_circle</span>
        <span>Final Output</span>
        <button class="btn btn-ghost btn-sm" id="chainCopyFinalBtn"><span class="material-symbols-outlined">content_copy</span> Copy</button>
        <button class="btn btn-ghost btn-sm" id="chainSaveFinalBtn"><span class="material-symbols-outlined">save</span> Save to Library</button>
      </div>
      <div id="chainFinalBody" class="chain-final-body"></div>
    </div>
  </div>
</div>

<!-- ============================================================
     WORKSPACE: Metaprompting
     ============================================================ -->
<div id="metaWorkspace" role="dialog" aria-modal="true" aria-label="Metaprompting">
  <div class="ws-header">
    <div class="ws-header-left">
      <span class="material-symbols-outlined ws-header-icon">auto_fix_high</span>
      <div>
        <h2 class="ws-title">Metaprompting</h2>
        <p class="ws-subtitle">Paste a weak prompt. Describe the goal. The AI rewrites it into a production-quality version.</p>
      </div>
    </div>
    <div class="ws-header-actions">
      <button class="btn btn-ghost" id="metaRefineBtn"><span class="material-symbols-outlined">auto_fix_high</span> Refine Again</button>
      <button class="btn btn-accent" id="metaSaveBtn"><span class="material-symbols-outlined">save</span> Save Improved</button>
      <button class="icon-btn" id="closeMetaBtn" aria-label="Close Metaprompting"><span class="material-symbols-outlined">close</span></button>
    </div>
  </div>
  <div class="ws-body meta-body">
    <div class="meta-left">
      <div class="meta-section">
        <label class="forge-label"><span class="material-symbols-outlined">edit_note</span> Your Rough Prompt <span class="forge-hint">Paste what you have — even a single sentence is fine</span></label>
        <textarea id="metaRoughPrompt" class="forge-input" rows="8" placeholder="e.g. Write a good email about the project update..."></textarea>
      </div>
      <div class="meta-section">
        <label class="forge-label"><span class="material-symbols-outlined">target</span> What should it do? <span class="forge-hint">Describe the outcome you want</span></label>
        <textarea id="metaGoal" class="forge-input" rows="3" placeholder="e.g. It should produce a concise professional email that summarises progress, highlights blockers, and ends with a clear ask..."></textarea>
      </div>
      <div class="meta-section">
        <label class="forge-label"><span class="material-symbols-outlined">tune</span> Technique <span class="forge-hint">Metaprompting strategy to apply</span></label>
        <select id="metaTechnique" class="form-input">
          <option value="structured">Structured (Role + Task + Format + Constraints)</option>
          <option value="chain_of_thought">Chain of Thought (step-by-step reasoning)</option>
          <option value="few_shot">Few-Shot (include examples)</option>
          <option value="persona">Persona-driven (strong character voice)</option>
          <option value="compression">Compression (same quality, fewer tokens)</option>
          <option value="adversarial">Adversarial hardening (stress-test edge cases)</option>
        </select>
      </div>
      <button class="btn btn-accent" id="metaRunBtn" style="align-self:flex-start;">
        <span class="material-symbols-outlined">auto_fix_high</span> Improve with AI
      </button>
    </div>
    <div class="meta-right">
      <div class="meta-output-header">
        <span class="forge-preview-title">Improved Prompt</span>
        <div style="display:flex;gap:var(--sp-2);align-items:center;" id="metaOutputActions" hidden>
          <button class="btn btn-ghost btn-sm" id="metaCopyBtn"><span class="material-symbols-outlined">content_copy</span> Copy</button>
          <button class="btn btn-ghost btn-sm" id="metaIterateBtn"><span class="material-symbols-outlined">refresh</span> Iterate</button>
        </div>
      </div>
      <div id="metaOutputBody" class="forge-output meta-output-body">
        <span class="hint">Your improved prompt will appear here. Fill in the fields on the left and click Improve with AI.</span>
      </div>
      <div id="metaScoreBlock" class="meta-score-block" hidden>
        <div class="meta-score-row">
          <span class="meta-score-label">AI Assessment</span>
          <div id="metaAssessment" class="meta-assessment"></div>
        </div>
      </div>
    </div>
  </div>
</div>


