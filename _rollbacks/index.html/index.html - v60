<!doctype html>
<html lang="en-GB" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Prompt Library Pro</title>

<!-- Neumorphism typography: Space Mono (display/UI) + JetBrains Mono (code/mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

<link rel="stylesheet" href="/static/app.css?v=e56bab63">
</head>
<body>

<div id="app">

  <!-- ============================================================
       SIDEBAR
       ============================================================ -->
  <aside id="sidebar">
    <div class="brand">
      <div class="brand-mark">P</div>
      <div>
        <span class="brand-name">Prompt Library</span>
        <span class="brand-pro" id="premiumBadge" hidden>PRO</span>
      </div>
    </div>

    <nav class="nav-section">
      <button class="nav-item active" data-view="library">
        <span class="material-symbols-outlined">menu_book</span>
        <span>Library</span>
        <span class="nav-count" id="libraryCount">0</span>
      </button>
      <button class="nav-item" data-view="favorites">
        <span class="material-symbols-outlined">star</span>
        <span>Favourites</span>
        <span class="nav-count" id="favCount">0</span>
      </button>
      <button class="nav-item premium-locked" data-view="analytics" data-premium="true" id="analyticsNavBtn">
        <span class="material-symbols-outlined">monitoring</span>
        <span>Analytics</span>
        <span class="nav-lock material-symbols-outlined">lock</span>
      </button>
      <button class="nav-item" data-view="roles" id="rolesNavBtn">
        <span class="material-symbols-outlined">smart_toy</span>
        <span>Agents</span>
        <span class="nav-count" id="rolesCount">0</span>
      </button>
      <button class="nav-item" data-view="playground" id="playgroundNavBtn" title="Prompt Playground (Ctrl+Shift+P)">
        <span class="material-symbols-outlined nav-icon">science</span>
        <span class="nav-label">Playground</span>
      </button>
      <button class="nav-item" data-view="forge" id="forgeNavBtn" title="Prompt Forge — build structured prompts">
        <span class="material-symbols-outlined nav-icon">construction</span>
        <span class="nav-label">Prompt Forge</span>
      </button>
      <button class="nav-item" data-view="lab" id="labNavBtn" title="Prompt Lab — A/B test your prompts">
        <span class="material-symbols-outlined nav-icon">biotech</span>
        <span class="nav-label">Prompt Lab</span>
      </button>
      <button class="nav-item" data-view="chain" id="chainNavBtn" title="Prompt Chain — multi-step pipeline">
        <span class="material-symbols-outlined nav-icon">account_tree</span>
        <span class="nav-label">Prompt Chain</span>
      </button>
      <button class="nav-item" data-view="meta" id="metaNavBtn" title="Metaprompting — improve any prompt with AI">
        <span class="material-symbols-outlined nav-icon">auto_fix_high</span>
        <span class="nav-label">Metaprompting</span>
      </button>

    </nav>

    <div id="sidebarScroll">

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="folders" aria-expanded="true">
          <span>Folders</span>
          <span style="display:inline-flex; align-items:center; gap:4px;">
            <button class="nav-icon-btn" id="newFolderBtn" title="New folder" aria-label="New folder">
              <span class="material-symbols-outlined">add</span>
            </button>
            <span class="material-symbols-outlined chev">expand_more</span>
          </span>
        </div>
        <div class="nav-section-content" id="folders-content">
          <div id="foldersList" class="filter-list"></div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="categories" aria-expanded="true">
          <span>Categories</span>
          <span class="material-symbols-outlined chev">expand_more</span>
        </div>
        <div class="nav-section-content" id="categories-content">
          <div id="categoriesList" class="filter-list"></div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="tags" aria-expanded="true">
          <span>Tags</span>
          <span class="material-symbols-outlined chev">expand_more</span>
        </div>
        <div class="nav-section-content" id="tags-content">
          <div id="tagsList" class="filter-list"></div>
        </div>
      </div>

    </div>

    <div class="sidebar-footer">
      <div class="sidebar-footer-row">
        <button class="sidebar-footer-btn" id="importBtn">
          <span class="material-symbols-outlined">upload</span>
          <span>Import</span>
        </button>
        <button class="sidebar-footer-btn" id="exportBtn">
          <span class="material-symbols-outlined">download</span>
          <span>Export</span>
        </button>
      </div>
      <button class="sidebar-footer-btn" id="themeToggleBtn">
        <span class="material-symbols-outlined" id="themeIcon">dark_mode</span>
        <span id="themeLabel">Dark mode</span>
      </button>
      <button class="sidebar-footer-btn" id="licenceBtn">
        <span class="material-symbols-outlined">workspace_premium</span>
        <span id="licenceBtnLabel">Unlock Pro</span>
      </button>
      <button class="sidebar-footer-btn" id="configToggleBtn" title="API settings" aria-label="Open API settings">
        <span class="material-symbols-outlined">settings</span>
        <span>API settings</span>
      </button>
    </div>
  </aside>

  <!-- ============================================================
       MAIN
       ============================================================ -->
  <main id="main">

    <header id="contentHeader">
      <div class="header-top">
        <div class="header-title-group">
          <div id="breadcrumb"></div>
          <h1 id="viewTitle">Library</h1>
        </div>
        <div class="header-actions">
          <button class="icon-btn" id="sidebarToggleBtn" title="Toggle sidebar" aria-label="Toggle sidebar">
            <span class="material-symbols-outlined">menu_open</span>
          </button>
          <button class="icon-btn" id="cmdBtn" title="Command palette (Ctrl+K)" aria-label="Open command palette">
            <span class="material-symbols-outlined">search</span>
          </button>
          <button class="btn btn-ghost" id="surpriseMeBtn" title="Open a random prompt" aria-label="Surprise me">
            <span class="material-symbols-outlined">shuffle</span>
            <span>Surprise me</span>
          </button>
          <button class="btn btn-accent" id="newPromptBtn">
            <span class="material-symbols-outlined">add</span>
            <span>New prompt</span>
          </button>
        </div>
      </div>

      <div id="folderViewActions" class="filter-bar" style="display:none; margin-bottom: var(--sp-3);"></div>

      <div class="filter-bar" id="libraryFilterBar">
        <div id="searchWrap">
          <span class="material-symbols-outlined">search</span>
          <input type="search" id="searchInput" placeholder="Search prompts, descriptions, tags..." autocomplete="off" />
          <span class="search-kbd">/</span>
        </div>
        <button class="chip" id="filterFavChip">
          <span class="material-symbols-outlined">star</span>
          Favourites
        </button>
        <button class="chip premium-locked" id="filterRatedChip" data-premium="true">
          <span class="material-symbols-outlined">star_rate</span>
          Rated
        </button>
        <button class="chip" id="activeFilterPill" hidden>
          <span class="material-symbols-outlined">close</span>
          <span id="activeFilterLabel"></span>
        </button>
        <span id="viewCount">0 prompts</span>
      </div>

      <div class="sort-bar">
        <span>Sort</span>
        <select id="sortSelect">
          <option value="updated">Recently updated</option>
          <option value="created">Date created</option>
          <option value="title">Title A-Z</option>
          <option value="used">Most used</option>
          <option value="rating">Top rated</option>
        </select>
        <div class="view-toggle" id="viewToggle">
          <button data-mode="list" class="active">
            <span class="material-symbols-outlined">view_agenda</span>
            List
          </button>
          <button data-mode="grid">
            <span class="material-symbols-outlined">grid_view</span>
            Grid
          </button>
        </div>
        <button class="chip" id="groupFolderBtn">
          <span class="material-symbols-outlined">folder_special</span>
          Group by folder
        </button>
      </div>
    </header>

    <div id="content">
      <div id="promptsContainer" class="list-view"></div>
    </div>

    <!-- ============================================================
         DETAIL PANEL
         ============================================================ -->
    <aside id="detailPanel" aria-hidden="true">
      <div class="detail-header">
        <div class="detail-actions">
          <button class="icon-btn" id="panelFavBtn" title="Toggle favourite">
            <span class="material-symbols-outlined">favorite</span>
          </button>
          <button class="icon-btn premium-locked" id="panelDuplicateBtn" data-premium="true" title="Duplicate">
            <span class="material-symbols-outlined">content_copy</span>
          </button>
          <button class="icon-btn" id="panelEditBtn" title="Edit">
            <span class="material-symbols-outlined">edit</span>
          </button>
          <button class="icon-btn danger" id="panelDeleteBtn" title="Delete">
            <span class="material-symbols-outlined">delete</span>
          </button>
        </div>
        <button class="icon-btn" id="closeDetailPanel" title="Close" aria-label="Close panel">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <nav class="detail-tabs">
        <button class="detail-tab active" data-tab="prompt">Prompt</button>
        <button class="detail-tab premium-locked" data-tab="notes" data-premium="true">Notes &amp; rating <span class="lock material-symbols-outlined">lock</span></button>
        <button class="detail-tab premium-locked" data-tab="chain" data-premium="true">Chain <span class="lock material-symbols-outlined">lock</span></button>
        <button class="detail-tab premium-locked" data-tab="history" data-premium="true">History <span class="lock material-symbols-outlined">lock</span></button>
      </nav>

      <div id="detailBody">

        <div class="detail-tab-pane active" id="tab-prompt">
          <div id="detailChips" class="detail-chips"></div>
          <h2 id="detailTitle"></h2>
          <div id="detailRoleChip" class="detail-role-chip" hidden></div>
          <p id="detailDesc"></p>

          <div class="detail-section-label">
            Prompt
            <span class="vars-badge" id="detailVarBadge" hidden>
              <span class="material-symbols-outlined">token</span>
              <span id="detailVarCount">0 variables</span>
            </span>
          </div>
          <div id="detailPromptText"></div>

          <div id="usePromptSection" hidden>
            <div class="detail-section-label">Fill variables</div>
            <div id="variableFields"></div>
          </div>

          <div class="meta-grid">
            <div class="meta-cell">
              <span class="material-symbols-outlined">calendar_month</span>
              <div>
                <div class="meta-label">Created</div>
                <div class="meta-value" id="metaCreated">-</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">bolt</span>
              <div>
                <div class="meta-label">Total uses</div>
                <div class="meta-value" id="metaUseCount">0</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">folder</span>
              <div>
                <div class="meta-label">Folder</div>
                <div class="meta-value" id="metaFolder">-</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">schedule</span>
              <div>
                <div class="meta-label">Last used</div>
                <div class="meta-value" id="metaLastUsed">Never</div>
              </div>
            </div>
          </div>
        </div>

        <div class="detail-tab-pane" id="tab-notes">
          <div class="detail-section-label">Rating</div>
          <div class="stars" id="detailRatingStars"></div>
          <div class="detail-section-label" style="margin-top: var(--sp-5)">Personal notes</div>
          <textarea class="form-textarea" id="detailNotes" rows="6" placeholder="Notes, reminders, things to revise..."></textarea>
          <button class="btn btn-primary" id="saveNotesBtn" style="margin-top: var(--sp-3); width: 100%; justify-content: center;">
            <span class="material-symbols-outlined">save</span>
            Save notes &amp; rating
          </button>
        </div>

        <div class="detail-tab-pane" id="tab-chain">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--sp-3);">
            <p style="font-size: var(--fs-sm); color: var(--ink-3); margin:0;">
              Steps in this prompt's workflow.
            </p>
            <button class="btn btn-accent" id="runChainBtn" style="display:none; font-size: 12px; padding: 6px 12px;">
              <span class="material-symbols-outlined" style="font-size:15px;">play_arrow</span>
              Run chain
            </button>
          </div>
          <div id="detailChainSteps"></div>
          <div id="chainRunnerWrap" style="display:none;"></div>
          <p id="detailChainEmpty" class="hidden" style="font-size: var(--fs-sm); color: var(--ink-3);">
            No chain yet. Edit this prompt to add steps.
          </p>
        </div>

        <div class="detail-tab-pane" id="tab-history">
          <p style="font-size: var(--fs-sm); color: var(--ink-3); margin-bottom: var(--sp-3);">
            Up to 20 versions kept per prompt. Click any version to restore.
          </p>
          <div id="versionList"></div>
          <p id="versionEmpty" class="hidden" style="font-size: var(--fs-sm); color: var(--ink-3);">
            No previous versions.
          </p>
        </div>

      </div>

      <div class="detail-footer">
        <button class="icon-btn" id="footerExportBtn" title="Export this prompt as JSON">
          <span class="material-symbols-outlined">ios_share</span>
        </button>
        <button class="icon-btn premium-locked" id="footerMdBtn" data-premium="true" title="Export as Markdown">
          <span class="material-symbols-outlined">description</span>
        </button>
        <button class="btn btn-accent" id="copyToClipboardBtn">
          <span class="material-symbols-outlined">content_copy</span>
          Copy to clipboard
        </button>
      </div>
    </aside>

  
  <!-- AGENT WORKSPACE -->
  <div id="rolesWorkspace" role="dialog" aria-modal="true" aria-label="Agent workspace">

    <!-- Header -->
    <div class="roles-header">
      <span class="material-symbols-outlined" style="font-size:24px;color:var(--accent)">smart_toy</span>
      <h2>Agents</h2>
      <button class="btn btn-ghost" id="rolesNewBtn"><span class="material-symbols-outlined">add</span> New agent</button>
      <button class="icon-btn" id="rolesCloseBtn" title="Close" aria-label="Close"><span class="material-symbols-outlined">close</span></button>
    </div>

    <div class="roles-body">

      <!-- Left pane: agent list -->
      <div class="roles-list-pane">
        <div class="roles-list-search">
          <input type="search" id="rolesSearch" class="form-input" placeholder="Search agents…" autocomplete="off" />
        </div>
        <div class="roles-list-scroll" id="rolesListScroll">
          <div class="roles-list-empty" id="rolesListEmpty" style="display:none;">
            <span class="material-symbols-outlined" style="font-size:32px;display:block;margin-bottom:8px;">smart_toy</span>
            No agents yet. Create one to get started.
          </div>
          <div id="rolesList"></div>
        </div>
        <!-- Stats -->
        <div class="roles-sidebar-stats" id="rolesStats">
          <div class="roles-stat-row">
            <span class="material-symbols-outlined">smart_toy</span>
            <span>Agents</span>
            <span class="roles-stat-value" id="rolesStatAgents">0</span>
          </div>
          <div class="roles-stat-row">
            <span class="material-symbols-outlined">star</span>
            <span>Favourites</span>
            <span class="roles-stat-value" id="rolesStatFavs">0</span>
          </div>
          <div class="roles-stat-row">
            <span class="material-symbols-outlined">library_books</span>
            <span>KB entries</span>
            <span class="roles-stat-value" id="rolesStatKb">0</span>
          </div>
          <div class="roles-stat-row">
            <span class="material-symbols-outlined">psychology</span>
            <span>Skills</span>
            <span class="roles-stat-value" id="rolesStatSkills">0</span>
          </div>
        </div>
      </div>

      <!-- Right pane: editor -->
      <div class="roles-editor-pane" id="rolesEditorPane">

        <!-- Empty state -->
        <div class="roles-editor-empty" id="rolesEditorEmpty">
          <span class="material-symbols-outlined">arrow_back</span>
          <p style="font-size:var(--fs-sm);margin:0;">Select an agent or create a new one</p>
        </div>

