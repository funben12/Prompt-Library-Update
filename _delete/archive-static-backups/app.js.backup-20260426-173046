function loadVarTemplate(index) {
    const templates = JSON.parse(localStorage.getItem('varTemplates') || '[]');
    if (index >= 0 && index < templates.length) {
        // Store template meta in a data attribute for the variable meta list
        const template = templates[index];
        const content = document.getElementById('promptContent').value;
        
        // Add variables to content if they don't exist
        let updatedContent = content;
        Object.keys(template.meta).forEach(v => {
            if (!content.includes(`[${v}]`) && !content.includes(`{{${v}}}`)) {
                updatedContent += `\n[${v}]`;
            }
        });
        
        document.getElementById('promptContent').value = updatedContent;
        updateEditorPreview();
        
        // Apply meta to the rendered variable list
        setTimeout(() => {
            Object.entries(template.meta).forEach(([v, m]) => {
                const row = document.querySelector(`.var-meta-row[data-var="${CSS.escape(v)}"]`);
                if (row) {
                    const typeSelect = row.querySelector('[data-field="type"]');
                    const defaultInput = row.querySelector('[data-field="default"]');
                    const visibleCheckbox = row.querySelector('[data-field="visible"]');
                    const optionsTextarea = row.querySelector('[data-field="options"]');
                    
                    if (typeSelect) typeSelect.value = m.type || 'text';
                    if (defaultInput) defaultInput.value = m.default || '';
                    if (visibleCheckbox) visibleCheckbox.checked = m.visible !== false;
                    if (optionsTextarea && m.options) {
                        optionsTextarea.value = m.options.join(', ');
                        onVarTypeChange(typeSelect);
                        // Populate dropdown options
                        const optsList = row.querySelector('.var-dropdown-options-list');
                        if (optsList && m.options.length > 0) {
                            optsList.innerHTML = m.options.map((o, i) => `
                                <div class="var-dropdown-option-item">
                                    <input type="text" class="var-dropdown-option-input" value="${escapeHtml(o)}" 
                                           data-option-index="${i}" onchange="updateDropdownOption(event)"/>
                                    <button type="button" class="var-dropdown-option-remove" onclick="removeDropdownOption(event)">
                                        <span class="material-symbols-outlined">close</span>
                                    </button>
                                </div>
                            `).join('');
                        }
                    }
                }
            });
            document.getElementById('varTemplateModal').classList.remove('active');
        }, 100);
    }
}

