});

/* ─────────────────────────────────────────────────────
   VIEW MANAGEMENT
───────────────────────────────────────────────────── */
function getViewPrompts() {
    if (currentView === 'favorites') return allPrompts.filter(p => p.is_favorite);
    if (currentView === 'library')   return allPrompts;
    return allPrompts.filter(p => p.folder_id === currentView);
}

function setView(view) {
    currentView = view;
    closeDetailPanel();

    // Nav active state
    document.querySelectorAll('[data-view]').forEach(el => {
        el.classList.toggle('active', el.dataset.view === String(view));
    });

    // Breadcrumb + title
    const bcEl    = document.getElementById('breadcrumb');
    const titleEl = document.getElementById('viewTitle');
    const fva     = document.getElementById('folderViewActions');
    const grid    = document.getElementById('promptsGrid');

    if (view === 'library') {
        bcEl.innerHTML = '';
        titleEl.textContent = 'Library';
        fva.style.display = 'none';
        grid.classList.remove('list-mode');
    } else if (view === 'favorites') {
        bcEl.innerHTML = '';
        titleEl.textContent = 'Favorites';
        fva.style.display = 'none';
        grid.classList.remove('list-mode');
    } else {
        // Folder view
        const folder = allFolders.find(f => f.id === view);
        const name   = folder ? folder.name : 'Folder';
        bcEl.innerHTML = `<span>Folders</span><span class="bc-sep material-symbols-outlined" style="font-size:14px">chevron_right</span><span>${escapeHtml(name)}</span>`;
        titleEl.textContent = name;
        grid.classList.add('list-mode');

        // Folder action buttons
        const safeName = JSON.stringify(name);
        fva.style.display = 'flex';
        fva.innerHTML = `
            <button class="fva-btn" onclick="openNewPromptInFolder(${view})">
                <span class="material-symbols-outlined">add</span> New Prompt
            </button>
            <button class="fva-btn" onclick="renameFolder(${view}, ${safeName})">
                <span class="material-symbols-outlined">edit</span> Rename
            </button>
            <button class="fva-btn danger" onclick="deleteFolder(${view})">
                <span class="material-symbols-outlined">delete</span> Delete
            </button>`;
    }

    const filtered = getViewPrompts();
    renderPrompts(filtered);
    document.getElementById('searchInput').value = '';
    updateCounts();
}

function updateCounts() {
    document.getElementById('libraryCount').textContent = allPrompts.length;
    document.getElementById('favCount').textContent     = allPrompts.filter(p => p.is_favorite).length;
    const filtered = getViewPrompts();
    document.getElementById('viewCount').textContent = `${filtered.length} prompt${filtered.length !== 1 ? 's' : ''}`;
}

/* ─────────────────────────────────────────────────────
   DATA LOADING
───────────────────────────────────────────────────── */
async function loadPrompts() {
    try {
        const res = await fetch(`${API_BASE}/prompts`);
        if (!res.ok) throw new Error('Network error');
        allPrompts = await res.json();
        setView(currentView);
    } catch (err) {
        console.error('loadPrompts:', err);
        toast('Could not load prompts — is the server running?', 'error');
    }
}

async function loadFolders() {
    try {
        const res = await fetch(`${API_BASE}/folders`);
        if (!res.ok) throw new Error();
        allFolders = await res.json();
        renderFolders();
        updateFolderDropdown();
    } catch (err) {
        console.error('loadFolders:', err);
    }
}

/* ─────────────────────────────────────────────────────
   RENDER PROMPTS
───────────────────────────────────────────────────── */
function renderPrompts(prompts) {
    const grid = document.getElementById('promptsGrid');
    document.getElementById('viewCount').textContent = `${prompts.length} prompt${prompts.length !== 1 ? 's' : ''}`;

    if (!prompts || prompts.length === 0) {
        grid.innerHTML = `
            <div class="empty-state">
                <span class="material-symbols-outlined">auto_awesome</span>
                <h3>No prompts here yet</h3>
                <p>Click <strong>New Prompt</strong> to create your first one</p>
            </div>`;
        return;
    }

    grid.innerHTML = prompts.map(p => {
        const vars      = detectVariables(p.content);
        const cats      = Array.isArray(p.categories) ? p.categories.filter(Boolean) : [];
        const tags      = Array.isArray(p.tags)       ? p.tags.filter(Boolean)       : [];
        const preview   = (p.content || '').substring(0, 150) + (p.content?.length > 150 ? '…' : '');
        const timeLbl   = relativeTime(p.updated_at || p.created_at);
        const folderObj = allFolders.find(f => f.id === p.folder_id);
        const favStyle  = p.is_favorite ? "font-variation-settings:'FILL' 1" : '';

        return `
        <div class="prompt-card" onclick="openDetailPanel(${p.id})">
            <div class="card-header">
                <h3 class="card-title">${escapeHtml(p.title)}</h3>
                <div class="card-actions">
                    <button class="card-btn ${p.is_favorite ? 'fav-on' : ''}"
                        onclick="event.stopPropagation(); toggleFavorite(${p.id})"
                        title="${p.is_favorite ? 'Remove from favorites' : 'Add to favorites'}">
                        <span class="material-symbols-outlined" style="${favStyle}">star</span>
                    </button>
                    <button class="card-btn" onclick="event.stopPropagation(); editPrompt(${p.id})" title="Edit">
                        <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="card-btn danger" onclick="event.stopPropagation(); deletePrompt(${p.id})" title="Delete">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </div>
            </div>

            <p class="card-content">${escapeHtml(preview)}</p>

            <div class="card-chips">
                ${vars.length > 0 ? `<span class="chip chip-vars">Variables: ${vars.length}</span>` : ''}
                ${cats.map(c => `<span class="chip chip-cat">${escapeHtml(c)}</span>`).join('')}
                ${tags.map(t => `<span class="chip chip-tag">${escapeHtml(t)}</span>`).join('')}
            </div>

            <div class="card-footer">
                <div class="card-meta">
                    ${folderObj ? `<span class="material-symbols-outlined">folder</span>${escapeHtml(folderObj.name)}` : ''}
                    ${timeLbl ? `<span>Updated ${timeLbl}</span>` : ''}
                </div>
                <button class="card-use-btn" onclick="event.stopPropagation(); usePromptFromCard(${p.id})" title="Copy to clipboard">
                    <span class="material-symbols-outlined">content_copy</span>
                    Use
                </button>
            </div>
        </div>`;
    }).join('');
}

/* ─────────────────────────────────────────────────────
   RENDER FOLDERS (sidebar)
───────────────────────────────────────────────────── */
function renderFolders() {
    const list = document.getElementById('foldersList');

    if (!allFolders.length) {
        list.innerHTML = '<p style="font-size:11px;color:var(--text-d);padding:8px 10px">No folders yet</p>';
        return;
    }

    list.innerHTML = allFolders.map(f => {
        const safeName = JSON.stringify(f.name);
        const count    = allPrompts.filter(p => p.folder_id === f.id).length;
        const isActive = currentView === f.id;
        return `
        <div class="folder-item ${isActive ? 'active' : ''}" data-folder-id="${f.id}" onclick="setView(${f.id})">
            <span class="material-symbols-outlined">folder</span>
            <span class="folder-item-name">${escapeHtml(f.name)}</span>
            ${count > 0 ? `<span class="folder-count">${count}</span>` : ''}
            <div class="fi-actions">
                <button class="fi-btn" onclick="event.stopPropagation(); renameFolder(${f.id}, ${safeName})" title="Rename">
                    <span class="material-symbols-outlined">edit</span>
                </button>
                <button class="fi-btn danger" onclick="event.stopPropagation(); deleteFolder(${f.id})" title="Delete">
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </div>
        </div>`;
    }).join('');
}

function updateFolderDropdown() {
    const sel = document.getElementById('promptFolder');
    if (!sel) return;
    const current = sel.value;
    sel.innerHTML = '<option value="">No Folder</option>' +
        allFolders.map(f => `<option value="${f.id}">${escapeHtml(f.name)}</option>`).join('');
    if (current) sel.value = current;
}

/* ─────────────────────────────────────────────────────
   VARIABLE META RENDERING
───────────────────────────────────────────────────── */
function renderVarMetaList() {
    const content = document.getElementById('promptContent')?.value || '';
    const vars    = detectVariables(content);
    const list    = document.getElementById('varMetaList');

    if (!vars.length) {
        list.innerHTML = '<p style="font-size:12px;color:var(--text-d)">No variables detected. Add [[variable_name]] to your content.</p>';
        return;
    }

    const existingMeta = collectVarMeta();

    list.innerHTML = vars.map(v => {
        const m    = existingMeta[v] || {};
        const type = m.type || 'text';
        const def  = m.default || '';
        const opts = (m.options || []).join(', ');
        const visible = m.visible !== false;

        return `<div class="var-meta-row" data-var="${escapeHtml(v)}">
            <div class="var-meta-header">
                <span class="var-meta-name">${escapeHtml(v)}</span>
                <div class="var-meta-controls">
                    <label class="var-meta-required" title="Show when filling variables">
                        <input type="checkbox" data-field="visible" ${visible ? 'checked' : ''} />
                        <span class="material-symbols-outlined">visibility</span>
                    </label>
                </div>
            </div>
            <div class="var-meta-type-row">
                <label class="var-meta-field-label">Type</label>
                <select class="var-meta-select" data-field="type" onchange="onVarTypeChange(this)">
                    <option value="text"     ${type === 'text'     ? 'selected' : ''}>Text</option>
                    <option value="number"   ${type === 'number'   ? 'selected' : ''}>Number</option>
                    <option value="date"     ${type === 'date'     ? 'selected' : ''}>Date</option>
                    <option value="dropdown" ${type === 'dropdown' ? 'selected' : ''}>Dropdown</option>
                </select>
            </div>
            <div class="var-meta-default-row">
                <label class="var-meta-field-label">Default Value</label>
                <input class="var-meta-default" type="text" data-field="default" placeholder="(optional)" value="${escapeHtml(def)}"/>
            </div>
            ${type === 'dropdown' ? `<div class="var-dropdown-opts">
                <label class="var-meta-field-label">Dropdown Options</label>
                <div class="var-dropdown-options-list">
                    ${opts.split(',').filter(o => o.trim()).map((option, i) => `
                        <div class="var-dropdown-option-item">
                            <input type="text" class="var-dropdown-option-input" value="${escapeHtml(option.trim())}" 
                                   data-option-index="${i}" onchange="updateDropdownOption(event)"/>
                            <button type="button" class="var-dropdown-option-remove" onclick="removeDropdownOption(event)">
                                <span class="material-symbols-outlined">close</span>
                            </button>
                        </div>
                    `).join('')}
                </div>
                <button type="button" class="var-dropdown-option-add" onclick="addDropdownOption(event, '${v}')">
                    <span class="material-symbols-outlined">add</span> Add Option
                </button>
                <textarea class="var-dropdown-options-textarea" data-field="options" placeholder="Comma-separated options" style="display:none">${opts}</textarea>
            </div>` : `<textarea class="var-dropdown-options-textarea" data-field="options" placeholder="(not used for this type)" style="display:none"></textarea>`}
        </div>`;
    }).join('');
}

function onVarTypeChange(selectEl) {
    const row  = selectEl.closest('.var-meta-row');
    const type = selectEl.value;

    let optsEl = row.querySelector('.var-dropdown-opts');
    if (type === 'dropdown') {
        if (!optsEl) {
            const d = document.createElement('div');
            d.className = 'var-dropdown-opts';
            d.innerHTML = `
                <label class="var-meta-field-label">Dropdown Options</label>
                <div class="var-dropdown-options-list"></div>
                <button type="button" class="var-dropdown-option-add" onclick="addDropdownOption(event, '')">
                    <span class="material-symbols-outlined">add</span> Add Option
                </button>
                <textarea class="var-dropdown-options-textarea" data-field="options" placeholder="Comma-separated options"></textarea>
            `;
            row.appendChild(d);
        }
        if (optsEl) optsEl.style.display = '';
    } else {
        if (optsEl) optsEl.style.display = 'none';
    }
}

function addDropdownOption(e, varName) {
    const row = e.target.closest('.var-meta-row');
    const list = row?.querySelector('.var-dropdown-options-list') || 
                 document.querySelector('.var-dropdown-options-list');
    
    if (!list) return;
    
    const newOption = document.createElement('div');
    newOption.className = 'var-dropdown-option-item';
    newOption.innerHTML = `
        <input type="text" class="var-dropdown-option-input" placeholder="New option" onchange="updateAllDropdownOptions()"/>
        <button type="button" class="var-dropdown-option-remove" onclick="removeDropdownOption(event)">
            <span class="material-symbols-outlined">close</span>
        </button>
    `;
    list.appendChild(newOption);
    const lastInput = list.querySelectorAll('input').length > 0 ? list.querySelectorAll('input')[list.querySelectorAll('input').length - 1] : null;
    if (lastInput) lastInput.focus();
}

function removeDropdownOption(e) {
    e.target.closest('.var-dropdown-option-item').remove();
    updateAllDropdownOptions();
}

function updateDropdownOption(e) {
    updateAllDropdownOptions();
}

function updateAllDropdownOptions() {
    document.querySelectorAll('.var-dropdown-opts').forEach(opts => {
        const inputs = opts.querySelectorAll('.var-dropdown-option-input');
        const values = Array.from(inputs)
            .map(i => i.value.trim())
            .filter(v => v);
        const textarea = opts.querySelector('.var-dropdown-options-textarea');
        if (textarea) textarea.value = values.join(', ');
    });
}

function collectVarMeta() {
    const meta = {};
    document.querySelectorAll('#varMetaList .var-meta-row').forEach(row => {
        const v    = row.dataset.var;
        const type = row.querySelector('[data-field="type"]')?.value || 'text';
        const def  = row.querySelector('[data-field="default"]')?.value || '';
        const visible = row.querySelector('[data-field="visible"]')?.checked !== false;
        const optsEl = row.querySelector('[data-field="options"]');
        const options = optsEl?.value
            ? optsEl.value.split(',').map(o => o.trim()).filter(Boolean)
            : [];
        meta[v] = { type, default: def, visible, options };
    });
    return meta;
}

/* ─────────────────────────────────────────────────────
   CHAIN SYSTEM
───────────────────────────────────────────────────── */
function updateChainSelect(currentId) {
    const sel = document.getElementById('chainPromptSelect');
    if (!sel) return;
    sel.innerHTML = '<option value="">Select a prompt to add...</option>' +
        allPrompts
            .filter(p => p.id !== currentId)
            .map(p => `<option value="${p.id}">${escapeHtml(p.title)}</option>`)
            .join('');
}

function addChainStep() {
    const sel = document.getElementById('chainPromptSelect');
    const id  = sel?.value;
    if (!id) return;
    
    const current = JSON.parse(document.getElementById('promptChainIds').value || '[]');
    current.push(parseInt(id));
    document.getElementById('promptChainIds').value = JSON.stringify(current);
    renderChainEditor(current);
    sel.value = '';
}

function renderChainEditor(chainIds) {
    const list = document.getElementById('chainList');
    if (!chainIds.length) {
        list.innerHTML = '<p style="font-size:12px;color:var(--text-d)">No steps added yet. Build a multi-step workflow.</p>';
        return;
    }

    list.innerHTML = chainIds.map((id, i) => {
        const p = allPrompts.find(x => x.id === id);
        const title = p ? escapeHtml(p.title) : `Prompt #${id}`;
        const isLast = i === chainIds.length - 1;
        
        return `<div class="chain-step-wrapper">
            <div class="chain-item">
                <div class="chain-step-num">${i + 1}</div>
                <div class="chain-step-content">
                    <span class="chain-step-label">${title}</span>
                    ${i > 0 ? `<span class="chain-step-meta">receives context from step ${i}</span>` : ''}
                </div>
                <div class="chain-item-actions">
                    ${i > 0 ? `<button type="button" class="chain-move-btn" onclick="moveChainStep(${i},-1)" title="Move up">
                        <span class="material-symbols-outlined">arrow_upward</span>
                    </button>` : ''}
                    ${!isLast ? `<button type="button" class="chain-move-btn" onclick="moveChainStep(${i},1)" title="Move down">
                        <span class="material-symbols-outlined">arrow_downward</span>
                    </button>` : ''}
                    <button type="button" class="chain-remove-btn" onclick="removeChainStep(${i})">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
            </div>
            ${!isLast ? `<div class="chain-arrow">
                <span class="material-symbols-outlined">arrow_downward</span>
                <span class="chain-arrow-label">output flows to next step</span>
            </div>` : ''}
        </div>`;
    }).join('');
}

function moveChainStep(index, direction) {
    const current = JSON.parse(document.getElementById('promptChainIds').value || '[]');
    if (index < 0 || index >= current.length) return;
    
    const newIdx = index + direction;
    if (newIdx < 0 || newIdx >= current.length) return;
    
    [current[index], current[newIdx]] = [current[newIdx], current[index]];
    document.getElementById('promptChainIds').value = JSON.stringify(current);
    renderChainEditor(current);
}

function removeChainStep(index) {
    const current = JSON.parse(document.getElementById('promptChainIds').value || '[]');
    current.splice(index, 1);
    document.getElementById('promptChainIds').value = JSON.stringify(current);
    renderChainEditor(current);
}

/* ─────────────────────────────────────────────────────
   DETAIL PANEL
───────────────────────────────────────────────────── */
async function openDetailPanel(id) {
    try {
        const res = await fetch(`${API_BASE}/prompts/${id}`);
        if (!res.ok) throw new Error();
        const p = await res.json();
        currentDetailId = id;
