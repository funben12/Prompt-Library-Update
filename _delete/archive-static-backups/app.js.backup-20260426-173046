function renderDetailPanel(p) {
    const vars    = detectVariables(p.content);
    const cats    = Array.isArray(p.categories) ? p.categories.filter(Boolean) : [];
    const tags    = Array.isArray(p.tags)       ? p.tags.filter(Boolean)       : [];
    const folder  = allFolders.find(f => f.id === p.folder_id);

    // Favorite button
    const favBtn  = document.getElementById('panelFavBtn');
    const favIcon = favBtn.querySelector('.material-symbols-outlined');
    favBtn.classList.toggle('fav-on', !!p.is_favorite);
    favIcon.textContent = p.is_favorite ? 'favorite' : 'favorite_border';
    if (p.is_favorite) favIcon.style.fontVariationSettings = "'FILL' 1";
    else               favIcon.style.fontVariationSettings = "'FILL' 0";

    // Chips
    const chipsEl = document.getElementById('detailChips');
    chipsEl.innerHTML =
        cats.map(c => `<span class="detail-chip">${escapeHtml(c)}</span>`).join('') +
        tags.map(t => `<span class="detail-chip plain">${escapeHtml(t)}</span>`).join('');

    // Title + description
    document.getElementById('detailTitle').textContent = p.title;
    const descEl = document.getElementById('detailDesc');
    descEl.textContent = p.description || '';
    descEl.style.display = p.description ? '' : 'none';

    // Prompt text with chips
    const varBadge = document.getElementById('detailVarBadge');
    if (vars.length > 0) {
        varBadge.style.display = 'flex';
        document.getElementById('detailVarCount').textContent = `${vars.length} Variable${vars.length !== 1 ? 's' : ''}`;
    } else {
        varBadge.style.display = 'none';
    }
    document.getElementById('detailPromptText').innerHTML = renderChips(p.content);

    // Variable fill section with visibility control
    const useSec = document.getElementById('usePromptSection');
    const varMeta = p.variableMeta || {};
    
    if (vars.length > 0) {
        useSec.style.display = '';
        renderVariableFields(vars, varMeta);
    } else {
        useSec.style.display = 'none';
        document.getElementById('variableFields').innerHTML = '';
    }

    // Metadata
    document.getElementById('metaCreated').textContent  = p.created_at ? new Date(p.created_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '—';
    document.getElementById('metaUseCount').textContent  = (p.use_count || 0).toLocaleString();
    document.getElementById('metaFolder').textContent    = folder ? folder.name : '—';
    document.getElementById('metaLastUsed').textContent  = p.last_used ? relativeTime(p.last_used) : 'Never';
}

function renderVariableFields(vars, varMeta) {
    const fields = document.getElementById('variableFields');
    if (!vars || !vars.length) return;
    
    // Filter to only visible variables
    const visibleVars = vars.filter(v => {
        const meta = varMeta[v] || {};
        return meta.visible !== false;
    });

    if (visibleVars.length === 0) {
        fields.innerHTML = '<p style="font-size:11px;color:var(--text-d)">All variables are hidden.</p>';
        return;
    }

    fields.innerHTML = visibleVars.map(v => {
        const vm = varMeta[v] || {};
        const type     = vm.type || 'text';
        const defVal   = vm.default || '';
        const options  = vm.options || [];

        let inputHtml = '';
        if (type === 'dropdown' && options.length) {
            inputHtml = `<select class="variable-select" data-variable="${escapeHtml(v)}">
                <option value="">Select...</option>
                ${options.map(o => `<option value="${escapeHtml(o)}">${escapeHtml(o)}</option>`).join('')}
            </select>`;
        } else if (type === 'number') {
            inputHtml = `<input type="number" class="variable-input" data-variable="${escapeHtml(v)}" placeholder="Enter value..." value="${escapeHtml(defVal)}"/>`;
        } else if (type === 'date') {
            inputHtml = `<input type="date" class="variable-input" data-variable="${escapeHtml(v)}" value="${escapeHtml(defVal)}"/>`;
        } else {
            inputHtml = `<input type="text" class="variable-input" data-variable="${escapeHtml(v)}" placeholder="Enter value..." value="${escapeHtml(defVal)}"/>`;
        }

        return `<div class="var-field-group">
            <div class="var-field-label">
                ${escapeHtml(v)}
                <span class="var-field-type">${type}</span>
            </div>
            ${inputHtml}
        </div>`;
    }).join('');
}

