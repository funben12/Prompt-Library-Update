const API_BASE = 'http://localhost:5000/api';

let allPrompts  = [];
let allFolders  = [];
let currentView = 'library';   // 'library' | 'favorites' | <folder id number>
let currentDetailId = null;    // prompt id currently open in detail panel

/* ─────────────────────────────────────────────────────
   VARIABLE DETECTION  (all 6 bracket types)
───────────────────────────────────────────────────── */
function detectVariables(content) {
    if (!content) return [];
    const vars = new Set();

    // Double-bracket variants (any content)
    [/\[\[(.+?)\]\]/g, /\{\{(.+?)\}\}/g, /\(\((.+?)\)\)/g].forEach(re => {
        let m; re.lastIndex = 0;
        while ((m = re.exec(content)) !== null) {
            const v = m[1].trim();
            if (v && v.length < 100) vars.add(v);
        }
    });

    // Single-bracket word-char variants
    [/\[(\w[\w\s.]*?\w|\w)\]/g, /\{(\w[\w\s.]*?\w|\w)\}/g, /\((\w[\w\s.]*?\w|\w)\)/g].forEach(re => {
        let m; re.lastIndex = 0;
        while ((m = re.exec(content)) !== null) {
            const v = m[1].trim();
            if (v && v.length < 100) vars.add(v);
        }
    });

    return Array.from(vars).sort();
}

/* ─────────────────────────────────────────────────────
   VARIABLE REPLACEMENT  (regex-safe)
───────────────────────────────────────────────────── */
function replaceVariables(content, varMap) {
    let out = content;
    for (const [varName, value] of Object.entries(varMap)) {
        const ev = varName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        out = out
            .replace(new RegExp(`\\[\\[${ev}\\]\\]`, 'g'), value)
            .replace(new RegExp(`\\{\\{${ev}\\}\\}`, 'g'), value)
            .replace(new RegExp(`\\(\\(${ev}\\)\\)`, 'g'), value)
            .replace(new RegExp(`\\[${ev}\\]`,        'g'), value)
            .replace(new RegExp(`\\{${ev}\\}`,         'g'), value)
            .replace(new RegExp(`\\(${ev}\\)`,         'g'), value);
    }
    return out;
}

/* ─────────────────────────────────────────────────────
   CHIP RENDERING  (variable → highlighted span)
───────────────────────────────────────────────────── */
function renderChips(content) {
    const vars = detectVariables(content);
    let html = escapeHtml(content);
    vars.forEach(v => {
        const ev   = v.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const chip = `<span class="var-chip">${escapeHtml(v)}</span>`;
        html = html
            .replace(new RegExp(`\\[\\[${ev}\\]\\]`, 'g'), chip)
            .replace(new RegExp(`\\{\\{${ev}\\}\\}`, 'g'), chip)
            .replace(new RegExp(`\\(\\(${ev}\\)\\)`, 'g'), chip)
            .replace(new RegExp(`\\[${ev}\\]`,        'g'), chip)
            .replace(new RegExp(`\\{${ev}\\}`,         'g'), chip)
            .replace(new RegExp(`\\(${ev}\\)`,         'g'), chip);
    });
    return html;
}

/* ─────────────────────────────────────────────────────
   TOAST NOTIFICATIONS
───────────────────────────────────────────────────── */
function toast(msg, type = 'success') {
    const icons = { success: 'check_circle', error: 'error', info: 'info', warning: 'warning' };
    const container = document.getElementById('toastContainer');
    if (!container) return;
    const el = document.createElement('div');
    el.className = `toast ${type}`;
    el.innerHTML = `<span class="material-symbols-outlined">${icons[type] || 'info'}</span><span>${escapeHtml(msg)}</span>`;
    container.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transform = 'translateX(8px)'; }, 2700);
    setTimeout(() => el.remove(), 3000);
}

