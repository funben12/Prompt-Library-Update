    document.getElementById('promptContent')   .addEventListener('input',  updateEditorPreview);

    // Prompt modal close on overlay click
    document.getElementById('promptModal').addEventListener('click', e => {
        if (e.target === e.currentTarget) closePromptModal();
    });

    // Folder modal
    document.getElementById('newFolderBtn')    .addEventListener('click',  openNewFolderModal);
    document.getElementById('closeFolderModal').addEventListener('click',  closeFolderModal);
    document.getElementById('cancelFolderBtn') .addEventListener('click',  closeFolderModal);
    document.getElementById('folderForm')      .addEventListener('submit', handleFolderSubmit);
    document.getElementById('folderModal').addEventListener('click', e => {
        if (e.target === e.currentTarget) closeFolderModal();
    });

    // Import/Export
    document.getElementById('importBtn')       .addEventListener('click', openImportModal);
    document.getElementById('exportBtn')       .addEventListener('click', handleExport);
    document.getElementById('closeImportModal').addEventListener('click', closeImportModal);
    document.getElementById('cancelImportBtn') .addEventListener('click', closeImportModal);
    document.getElementById('importForm')      .addEventListener('submit', handleImport);
    document.getElementById('importModal').addEventListener('click', e => {
        if (e.target === e.currentTarget) closeImportModal();
    });

    // Detail panel
    document.getElementById('closeDetailPanel').addEventListener('click', closeDetailPanel);
    document.getElementById('panelFavBtn')     .addEventListener('click', handlePanelFavorite);
    document.getElementById('panelEditBtn')    .addEventListener('click', handlePanelEdit);
