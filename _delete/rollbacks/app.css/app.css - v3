    font-family: var(--ff-mono, monospace); font-size: 12px; line-height: 1.6;
    color: var(--ink-2); white-space: pre-wrap; word-break: break-word;
    max-height: 320px; overflow-y: auto; margin-bottom: var(--sp-3);
  }
  .import-template-note { font-size: 12px; color: var(--ink-3); margin-bottom: var(--sp-3); line-height: 1.5; }


  /* ============================================================
     PROMPT PLAYGROUND WORKSPACE
     A full-screen scratch-pad for drafting, splitting, and
     comparing prompts before adding them to the library.
     ============================================================ */

  #playgroundWorkspace {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 100);
    background: var(--surface);
    flex-direction: column;
    overflow: hidden;
  }
  #playgroundWorkspace.open { display: flex; }

  /* ── Header ── */
  .pg-header {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    flex-shrink: 0;
    z-index: 2;
  }
  .pg-header-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg); font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
    flex: 1;
  }
  .pg-header-sub {
    font-size: 12px; color: var(--ink-4);
    font-family: var(--ff-sans);
    font-weight: 400;
    margin-left: 8px;
    letter-spacing: 0;
  }
  .pg-header-actions { display: flex; gap: var(--sp-2); align-items: center; }

  /* ── Two-column layout: sessions list + canvas ── */
  .pg-body {
    display: grid;
    grid-template-columns: 260px 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Sessions sidebar ── */
  .pg-sessions {
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface-2);
  }
  .pg-sessions-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .pg-sessions-title {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .pg-sessions-list {
    flex: 1; overflow-y: auto;
    padding: var(--sp-2);
    display: flex; flex-direction: column; gap: 2px;
  }
  .pg-session-item {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: 8px var(--sp-3);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background var(--t-fast);
    position: relative;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .pg-session-item:hover { background: var(--surface-3); color: var(--ink); }
  .pg-session-item.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .pg-session-item .pg-session-pin {
    font-size: 14px !important;
    color: var(--warn);
    flex-shrink: 0;
  }
  .pg-session-item .pg-session-name {
    flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pg-session-item .pg-session-time {
    font-size: 10.5px; color: var(--ink-4);
    flex-shrink: 0;
    display: none;
  }
  .pg-session-item:hover .pg-session-time { display: block; }
  .pg-session-del {
    display: none;
    color: var(--danger);
    opacity: 0.7;
    padding: 2px;
    border-radius: 4px;
    flex-shrink: 0;
    font-size: 15px !important;
  }
  .pg-session-item:hover .pg-session-del { display: grid; place-items: center; }
  .pg-session-del:hover { opacity: 1; background: var(--danger-soft); }

  /* ── Canvas ── */
  .pg-canvas {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .pg-canvas-toolbar {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    flex-shrink: 0;
  }
  .pg-session-title-input {
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    font-weight: 500;
    letter-spacing: -0.01em;
    background: transparent;
    border: 0;
    border-bottom: 1px dashed var(--line);
    color: var(--ink);
    padding: 2px 0;
    width: 240px;
    transition: border-color var(--t-fast);
  }
  .pg-session-title-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .pg-mode-toggle {
    display: inline-flex;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 2px;
    margin-left: auto;
  }
  .pg-mode-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px; font-weight: 500;
    color: var(--ink-3);
    transition: background var(--t-fast), color var(--t-fast);
  }
  .pg-mode-btn .material-symbols-outlined { font-size: 15px; }
  .pg-mode-btn:hover { color: var(--ink); }
  .pg-mode-btn.active { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }

  /* ── Panels grid ── */
  .pg-panels {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    overflow: hidden;
    min-height: 0;
  }
  .pg-panels.split-2 { grid-template-columns: 1fr 1fr; }
  .pg-panels.split-3 { grid-template-columns: 1fr 1fr 1fr; }

  .pg-panel {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    overflow: hidden;
    min-width: 0;
  }
  .pg-panel:last-child { border-right: 0; }

  .pg-panel-header {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .pg-panel-label {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    flex: 1;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .pg-panel-label:focus { outline: none; color: var(--accent); }
  .pg-panel-model {
    font-size: 11px; color: var(--ink-4);
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 7px;
    font-family: var(--ff-mono);
    max-width: 110px;
  }
  .pg-panel-model:focus { outline: none; border-color: var(--accent); }

  .pg-panel-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .pg-panel-prompt {
    flex: 1;
    padding: var(--sp-4);
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink);
    background: var(--surface-sunk);
    border: 0;
    resize: none;
    outline: none;
    overflow-y: auto;
    min-height: 0;
  }
  .pg-panel-prompt:focus { background: var(--surface); }
  .pg-panel-prompt::placeholder { color: var(--ink-4); font-style: italic; font-family: var(--ff-sans); }

  /* Score bar at bottom of panel */
  .pg-panel-footer {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-4);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .pg-score-label { font-size: 11px; color: var(--ink-3); white-space: nowrap; }
  .pg-score-stars { display: flex; gap: 2px; }
  .pg-score-star {
    font-size: 16px !important;
    color: var(--ink-4);
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
    padding: 1px;
  }
  .pg-score-star:hover, .pg-score-star.on { color: var(--gold); }
  .pg-score-star.on { font-variation-settings: "FILL" 1; }
  .pg-panel-save-btn {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11.5px; font-weight: 600;
    color: var(--accent);
    padding: 3px 9px;
    border-radius: var(--r-sm);
    transition: background var(--t-fast);
  }
  .pg-panel-save-btn:hover { background: var(--accent-soft); }
  .pg-panel-save-btn .material-symbols-outlined { font-size: 14px; }
  .pg-char-count {
    font-size: 10.5px; color: var(--ink-4);
    font-family: var(--ff-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ── Empty state ── */
  .pg-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    flex: 1;
    gap: var(--sp-4);
    color: var(--ink-3);
    padding: var(--sp-8);
  }
  .pg-empty .material-symbols-outlined { font-size: 56px; color: var(--ink-4); }
  .pg-empty h3 {
    font-family: var(--ff-display);
    font-size: var(--fs-lg); font-weight: 400;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }
  .pg-empty p { font-size: var(--fs-sm); color: var(--ink-3); max-width: 36ch; text-align: center; line-height: 1.6; }

  /* ── Note textarea in toolbar ── */
  .pg-note-input {
    font-size: 12px; color: var(--ink-3);
    background: transparent;
    border: 0;
    border-bottom: 1px dashed transparent;
    padding: 2px 0;
    width: 220px;
    font-family: var(--ff-sans);
    transition: border-color var(--t-fast);
    resize: none;
    height: 22px;
    overflow: hidden;
  }
  .pg-note-input:focus { outline: none; border-color: var(--line); color: var(--ink); }
  .pg-note-input::placeholder { color: var(--ink-4); }

  /* ── API Settings panel (pops up above sidebar footer) ──────────── */
  #configPanel {
    position: fixed;
    bottom: 0;
    left: 0;
    width: var(--sidebar-w, 264px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 1px solid var(--line);
    border-radius: var(--radius-lg, 10px) var(--radius-lg, 10px) 0 0;
    box-shadow: 0 -4px 24px rgba(0,0,0,.14);
    z-index: 200;
    display: none;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(100%);
    transition: transform 0.2s ease;
  }
  #configPanel.open {
    display: flex;
    transform: translateY(0);
  }
  #configToggleBtn.active .material-symbols-outlined {
    color: var(--accent);
  }

  /* ── Config Panel internals ─────────────────────────────────────────────── */
  .config-panel-header {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .config-panel-header h4 {
    flex: 1; margin: 0;
    font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
  }
  .config-panel-body {
    padding: var(--sp-4);
    display: flex; flex-direction: column; gap: var(--sp-3);
    overflow-y: auto;
  }
  .config-section-label {
    font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3);
    margin-bottom: var(--sp-2);
  }
  .config-provider-tabs {
    display: flex; gap: 4px; margin-bottom: var(--sp-3);
  }
  .config-provider-tab {
    flex: 1; padding: 6px 0;
    font-size: var(--fs-sm); font-weight: 500;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); color: var(--ink-2);
    cursor: pointer; transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .config-provider-tab:hover { background: var(--surface-3); color: var(--ink); }
  .config-provider-tab.active {
    background: var(--accent-soft); border-color: var(--accent);
    color: var(--accent); font-weight: 600;
  }
  .config-api-row { display: flex; flex-direction: column; gap: var(--sp-2); }


/* =============================================================
   PROMPT MODAL — PHASE 2 ENHANCEMENTS
   Prompt block (system/conversation tabs), category chips,
   advanced section, form hints.
   ============================================================= */
/* Note: intentionally outside @layer so these override reliably in WebView2 */

  /* ── Prompt block container ─────────────────────────────────── */
  .prompt-block {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface-sunk);
    overflow: hidden;
  }

  /* ── Prompt block sub-tabs (System / Conversation) ──────────── */
  .prompt-block-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    padding: 0 var(--sp-3);
  }
  .prompt-block-tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 9px 14px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--t-fast), border-color var(--t-fast);
    white-space: nowrap;
  }
  .prompt-block-tab:hover { color: var(--ink); }
  .prompt-block-tab.active {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  /* ── Prompt block panes ─────────────────────────────────────── */
  .prompt-block-pane { display: none; padding: var(--sp-3); }
  .prompt-block-pane.active { display: block; }

  .vars-badge-row {
    display: flex;
    justify-content: flex-end;
    min-height: 22px;
    margin-bottom: var(--sp-2);
  }

  /* ── Conversation add-message row ───────────────────────────── */
  .convo-add-row {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }

  /* ── Category chip grid ─────────────────────────────────────── */
  .category-chip-add-row {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
    align-items: center;
  }
  .category-chip-add-row .form-input-sm {
    flex: 1;
    height: 34px;
    padding: 6px 10px;
    font-size: var(--fs-sm);
  }

  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast);
    white-space: nowrap;
  }
  .cat-chip:hover {
    background: var(--accent-soft);
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .cat-chip.selected {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
    box-shadow: 0 0 0 2px var(--accent-line);
  }
  .cat-chip.custom-chip {
    padding-right: 6px;
    gap: 6px;
  }
  .cat-chip.custom-chip .chip-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    font-size: 11px;
    line-height: 1;
    color: var(--ink-3);
    background: var(--surface-3);
    transition: background var(--t-fast), color var(--t-fast);
  }
  .cat-chip.custom-chip .chip-remove:hover {
    background: var(--danger-soft);
    color: var(--danger);
  }

  /* ── Form hint text ─────────────────────────────────────────── */
  .form-hint {
    font-size: var(--fs-xs);
    color: var(--ink-4);
    margin-top: var(--sp-2);
    line-height: 1.4;
  }
  .form-hint code {
    font-family: var(--ff-mono);
    font-size: 11px;
    background: var(--surface-3);
    padding: 1px 4px;
    border-radius: 3px;
    color: var(--accent);
  }

  /* ── Private toggle ─────────────────────────────────────────── */
  .private-toggle-row {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
  }
  .toggle-label {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    cursor: pointer;
    user-select: none;
  }
  .toggle-check { display: none; }
  .toggle-track {
    position: relative;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: var(--surface-3);
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
    transition: background var(--t-base), border-color var(--t-base);
  }
  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ink-4);
    transition: transform var(--t-base), background var(--t-base);
  }
  .toggle-check:checked + .toggle-track {
    background: var(--accent);
    border-color: var(--accent);
  }
  .toggle-check:checked + .toggle-track .toggle-thumb {
    transform: translateX(16px);
    background: white;
  }
  .toggle-text {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
  }

  /* ── Advanced settings collapsible ─────────────────────────── */
  .advanced-section {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    margin-top: var(--sp-4);
  }
  .advanced-toggle {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    background: var(--surface-2);
    cursor: pointer;
    list-style: none;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .advanced-toggle::-webkit-details-marker { display: none; }
  .advanced-toggle:hover { background: var(--surface-3); color: var(--ink); }
  .advanced-toggle .material-symbols-outlined {
    font-size: 18px;
    color: var(--ink-3);
    transition: transform var(--t-base);
  }
  details[open] .advanced-toggle .material-symbols-outlined {
    transform: rotate(180deg);
  }
  .advanced-body {
    padding: var(--sp-4);
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  /* ── Small button variant ───────────────────────────────────── */
  .btn-sm {
    padding: 6px 12px;
    font-size: var(--fs-sm);
    height: auto;
  }

  /* ── Responsive adjustments for new elements ────────────────── */
@media (max-width: 600px) {
  .convo-add-row { flex-direction: column; }
  .category-chip-add-row { flex-wrap: wrap; }
  .prompt-block-tabs { padding: 0 var(--sp-2); overflow-x: auto; scrollbar-width: none; }
  .prompt-block-tabs::-webkit-scrollbar { display: none; }
}

/* ── Surprise Me — card flash ──────────────────────────────── */
@keyframes surprise-flash {
  0%   { box-shadow: 0 0 0 0 oklch(38% 0.14 190 / 0.6); }
  50%  { box-shadow: 0 0 0 8px oklch(38% 0.14 190 / 0.15); }
  100% { box-shadow: 0 0 0 0 oklch(38% 0.14 190 / 0); }
}
.prompt-card.surprise-flash {
  animation: surprise-flash 0.8s var(--ease-out-expo) forwards;
}

/* =============================================================
   PROMPT FORGE & PROMPT LAB WORKSPACES
   ============================================================= */

/* ── Shared workspace chrome ─────────────────────────────────── */
#forgeWorkspace,
#labWorkspace {
  display: none;
  position: fixed;
  inset: 0;
  z-index: var(--z-modal, 100);
  background: var(--bg);
  flex-direction: column;
}
#forgeWorkspace.open,
#labWorkspace.open { display: flex; }

.ws-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  flex-shrink: 0;
  gap: var(--sp-4);
}
.ws-header-left {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.ws-header-icon {
  font-size: 28px;
  color: var(--accent);
}
.ws-title {
  font-family: var(--ff-display, serif);
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.ws-subtitle {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin-top: 1px;
}
.ws-header-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex-shrink: 0;
}
.ws-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* ── Forge layout ────────────────────────────────────────────── */
.forge-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  height: 100%;
}
.forge-form {
  overflow-y: auto;
  padding: var(--sp-5);
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}
.forge-section {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.forge-label {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.forge-label .material-symbols-outlined {
  font-size: 16px;
  color: var(--accent);
}
.forge-hint {
  font-size: var(--fs-xs);
  font-weight: 400;
  color: var(--ink-4);
  text-transform: none;
  letter-spacing: 0;
  margin-left: auto;
}
.forge-input {
  width: 100%;
  padding: var(--sp-3);
  background: var(--surface-sunk);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  font-family: var(--ff-mono);
  font-size: 13px;
  line-height: 1.6;
  color: var(--ink);
  resize: vertical;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}
.forge-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: var(--ring);
}
.forge-meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-3);
}
.forge-meta-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.forge-meta-label {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
}

/* ── Forge preview ───────────────────────────────────────────── */
.forge-preview {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.forge-preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-5);
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
  flex-shrink: 0;
}
.forge-preview-title {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.forge-char-count {
  font-size: var(--fs-xs);
  color: var(--ink-4);
  font-family: var(--ff-mono);
}
.forge-output {
  flex: 1;
  overflow-y: auto;
  padding: var(--sp-5);
  font-family: var(--ff-mono);
  font-size: 13px;
  line-height: 1.75;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
}
.forge-output .hint {
  font-family: var(--ff-sans);
  font-style: italic;
  color: var(--ink-4);
}
.forge-section-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  padding: var(--sp-1) 0;
  border-top: 1px solid var(--accent-line);
  margin-top: var(--sp-2);
}
.forge-assembled-block {
  margin-bottom: var(--sp-3);
}
.forge-assembled-block .forge-block-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-4);
  margin-bottom: 4px;
}
.forge-assembled-block .forge-block-body {
  color: var(--ink);
}

/* ── Lab layout ──────────────────────────────────────────────── */
.lab-body {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
}
.lab-shared {
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.lab-variants {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  overflow: hidden;
}
.lab-variant {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-4) var(--sp-5);
  overflow-y: auto;
}
.lab-vs {
  display: flex;
  align-items: center;
  justify-content: center;
  writing-mode: vertical-rl;
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink-4);
  letter-spacing: 0.2em;
  padding: 0 var(--sp-3);
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  background: var(--surface-2);
  user-select: none;
}
.lab-variant-header {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.lab-variant-badge {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}
.lab-badge-a { background: var(--accent-soft); color: var(--accent); }
.lab-badge-b { background: var(--warn-soft);   color: var(--warn); }
.lab-variant-title {
  flex: 1;
  font: 600 var(--fs-sm) / 1 var(--ff-sans);
  color: var(--ink);
  background: none;
  border: none;
  border-bottom: 1px solid var(--line);
  padding: 4px 0;
}
.lab-variant-title:focus { outline: none; border-color: var(--accent); }
.lab-score-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-left: auto;
}
.lab-score-label {
  font-size: var(--fs-xs);
  color: var(--ink-4);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.lab-stars { display: flex; gap: 2px; cursor: pointer; }
.lab-star {
  font-size: 18px;
  color: var(--line-strong);
  transition: color var(--t-fast);
  user-select: none;
}
.lab-star.lit { color: var(--gold); }
.lab-notes { min-height: 48px; font-size: 12px; }
.lab-copy-btn { align-self: flex-start; }

/* ── Lab winner bar ──────────────────────────────────────────── */
.lab-winner-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-5);
  background: var(--success-soft);
  border-top: 1px solid var(--success);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--ink);
  flex-shrink: 0;
}
.lab-winner-bar[hidden] { display: none; }

/* ── Load from Library modal (lab) ───────────────────────────── */
#labLoadModal .modal-box-sm { width: min(520px, 92vw); }

/* ── Responsive ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  .forge-body { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
  .forge-form { border-right: none; border-bottom: 1px solid var(--line); }
  .lab-variants { grid-template-columns: 1fr; grid-template-rows: auto auto auto; }
  .lab-vs { writing-mode: horizontal-tb; padding: var(--sp-2); border: none; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ws-header-actions .btn span:last-child { display: none; }
}

/* =============================================================
   LAB OUTPUT AREAS + AI SCORING
   ============================================================= */
.lab-output {
  background: var(--surface-2);
  border: 1px solid var(--accent-line);
  border-radius: var(--r-md);
  overflow: hidden;
}
.lab-output[hidden] { display: none; }
.lab-output-header {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  background: var(--accent-soft);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--accent);
  border-bottom: 1px solid var(--accent-line);
}
.lab-output-header .material-symbols-outlined { font-size: 15px; }
.lab-output-body {
  padding: var(--sp-3);
  font-size: 13px;
  line-height: 1.65;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 200px;
  overflow-y: auto;
}
.lab-ai-reasoning {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-style: italic;
  margin-top: 4px;
  line-height: 1.4;
}
.lab-ai-reasoning[hidden] { display: none; }
.lab-running {
  opacity: 0.6;
  pointer-events: none;
}

/* =============================================================
   PROMPT CHAIN WORKSPACE
   ============================================================= */
#chainWorkspace {
  display: none;
  position: fixed;
  inset: 0;
  z-index: var(--z-modal, 100);
  background: var(--bg);
  flex-direction: column;
}
#chainWorkspace.open { display: flex; }

.chain-body {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 100%;
  gap: 0;
}
.chain-seed {
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.chain-steps-wrap {
  flex: 1;
  overflow-y: auto;
  padding: var(--sp-4) var(--sp-5);
}
.chain-steps-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}
.chain-step {
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  overflow: hidden;
}
.chain-step-header {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  background: var(--surface-2);
  border-bottom: 1px solid var(--line);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
}
.chain-step-num {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}
.chain-step-label {
  flex: 1;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
  background: none;
  border: none;
  border-bottom: 1px solid var(--line);
  padding: 4px 2px;
  min-width: 0;
}
.chain-step-label:focus { outline: none; border-color: var(--accent); }
.chain-step-body {
  padding: var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.chain-step-hint {
  font-size: var(--fs-xs);
  color: var(--ink-4);
  line-height: 1.4;
}
.chain-step-hint code {
  font-family: var(--ff-mono);
  font-size: 11px;
  background: var(--surface-3);
  padding: 1px 4px;
  border-radius: 3px;
  color: var(--accent);
}
.chain-step-from-library {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
.chain-step-picker {
  flex: 1;
  padding: 6px 10px;
  font-size: var(--fs-sm);
  background: var(--surface-sunk);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  color: var(--ink);
}
.chain-step-picker:focus { outline: none; border-color: var(--accent); }
.chain-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  padding: var(--sp-2) 0;
  opacity: 0.5;
}
.chain-arrow .material-symbols-outlined { font-size: 22px; }
.chain-final-output {
  border-top: 2px solid var(--success);
  background: var(--success-soft);
  flex-shrink: 0;
}
.chain-final-output[hidden] { display: none; }
.chain-final-header {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-5);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--success);
  border-bottom: 1px solid var(--success);
}
.chain-final-body {
  padding: var(--sp-4) var(--sp-5);
  font-family: var(--ff-mono);
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  max-height: 200px;
  overflow-y: auto;
}

/* =============================================================
   METAPROMPTING WORKSPACE
   ============================================================= */
#metaWorkspace {
  display: none;
  position: fixed;
  inset: 0;
  z-index: var(--z-modal, 100);
  background: var(--bg);
  flex-direction: column;
}
#metaWorkspace.open { display: flex; }

.meta-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  height: 100%;
}
.meta-left {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  padding: var(--sp-5);
  border-right: 1px solid var(--line);
  overflow-y: auto;
}
.meta-section { display: flex; flex-direction: column; gap: var(--sp-2); }
.meta-right {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.meta-output-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-5);
  background: var(--surface-2);
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}
.meta-output-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--sp-5);
  font-family: var(--ff-mono);
  font-size: 13px;
  line-height: 1.75;
  white-space: pre-wrap;
  color: var(--ink);
}
.meta-score-block {
  border-top: 1px solid var(--line);
  padding: var(--sp-3) var(--sp-5);
  background: var(--surface-2);
  flex-shrink: 0;
}
.meta-score-block[hidden] { display: none; }
.meta-score-row { display: flex; align-items: flex-start; gap: var(--sp-3); }
.meta-score-label {
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-4);
  padding-top: 2px;
  white-space: nowrap;
}
.meta-assessment {
  font-size: var(--fs-sm);
  color: var(--ink-2);
  line-height: 1.5;
}
@media (max-width: 900px) {
  .meta-body { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
  .meta-left { border-right: none; border-bottom: 1px solid var(--line); }
  #chainWorkspace .ws-header-actions .btn span:last-child { display: none; }
}

/* =============================================================
   COLLAPSIBLE WORKSPACE NAV GROUP
   ============================================================= */
.nav-group { display: flex; flex-direction: column; }

.nav-group-toggle {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  width: 100%;
  padding: var(--sp-3) var(--sp-4);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--ink-2);
  border-radius: var(--r-md);
  transition: background var(--t-fast), color var(--t-fast);
  cursor: pointer;
}
.nav-group-toggle:hover { background: var(--surface-2); color: var(--ink); }
.nav-group-toggle .nav-group-chev {
  font-size: 16px;
  color: var(--ink-4);
  margin-left: auto;
  transition: transform var(--t-base);
}
.nav-group[data-open="true"] .nav-group-chev { transform: rotate(180deg); }
.nav-group[data-open="true"] .nav-group-toggle { color: var(--ink); }

.nav-group-items {
  display: none;
  flex-direction: column;
  padding-left: var(--sp-4);
  border-left: 2px solid var(--line);
  margin-left: var(--sp-5);
  margin-bottom: var(--sp-2);
}
.nav-group[data-open="true"] .nav-group-items { display: flex; }

.nav-sub-item {
  padding-left: var(--sp-3);
  font-size: var(--fs-sm);
}

/* =============================================================
   CATEGORY CHIPS — COLLAPSIBLE WRAP
   ============================================================= */
.category-chips-wrap {
  max-height: 48px;
  overflow: hidden;
  transition: max-height 0.3s var(--ease-out-expo);
  position: relative;
}
.category-chips-wrap.expanded { max-height: 600px; }
.category-chips-wrap:not(.expanded)::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 20px;
  background: linear-gradient(transparent, var(--surface));
  pointer-events: none;
}
.cat-chips-toggle {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: var(--sp-2);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--accent);
  cursor: pointer;
  transition: color var(--t-fast);
}
.cat-chips-toggle:hover { color: var(--accent-hover); }
.cat-chips-toggle .material-symbols-outlined { font-size: 15px; transition: transform var(--t-base); }
.cat-chips-toggle.open .material-symbols-outlined { transform: rotate(180deg); }

/* =============================================================
   PROMPT SCORE PANE
   ============================================================= */
.score-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3) 0 var(--sp-4);
  border-bottom: 1px solid var(--line);
  margin-bottom: var(--sp-4);
}
.score-total-label {
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-4);
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}
.score-total-ring {
  position: relative;
  width: 56px;
  height: 56px;
  flex-shrink: 0;
}
.score-ring-svg {
  width: 56px;
  height: 56px;
  transform: rotate(-90deg);
}
.score-ring-bg {
  fill: none;
  stroke: var(--surface-3);
  stroke-width: 4;
}
.score-ring-fill {
  fill: none;
  stroke: var(--accent);
  stroke-width: 4;
  stroke-linecap: round;
  stroke-dasharray: 113;
  stroke-dashoffset: 113;
  transition: stroke-dashoffset 0.6s var(--ease-out-expo), stroke 0.3s;
}
.score-total-num {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--ff-mono);
}
.score-tagline {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  line-height: 1.4;
  flex: 1;
}
.score-dimensions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.score-dim {
  display: grid;
  grid-template-columns: 130px 1fr auto;
  align-items: center;
  gap: var(--sp-3);
}
.score-dim-label {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--ink-2);
}
.score-bar-wrap {
  height: 6px;
  background: var(--surface-3);
  border-radius: 3px;
  overflow: hidden;
}
.score-bar {
  height: 100%;
  border-radius: 3px;
  transition: width 0.5s var(--ease-out-expo), background 0.3s;
  width: 0%;
}
.score-bar.good   { background: var(--success); }
.score-bar.ok     { background: var(--warn); }
.score-bar.poor   { background: var(--danger); }
.score-dim-val {
  font-size: var(--fs-xs);
  font-weight: 700;
  font-family: var(--ff-mono);
  color: var(--ink-3);
  width: 28px;
  text-align: right;
}
.score-dim-tip {
  grid-column: 2 / 4;
  font-size: var(--fs-xs);
  color: var(--ink-4);
  line-height: 1.4;
  margin-top: -6px;
}

/* ============================================================================
   TOKEN COUNTER PANE
   ============================================================================ */
.token-summary-strip {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3) 0 var(--sp-4);
  border-bottom: 1px solid var(--line);
  margin-bottom: var(--sp-4);
  flex-wrap: wrap;
}
.token-summary-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.token-summary-label {
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-4);
}
.token-summary-val {
  font-size: var(--fs-lg);
  font-weight: 700;
  font-family: var(--ff-mono);
  color: var(--ink);
  line-height: 1;
  transition: color 0.25s;
}
.token-summary-divider {
  width: 1px;
  height: 32px;
  background: var(--line);
  flex-shrink: 0;
}
.token-summary-hint {
  font-size: var(--fs-xs);
  color: var(--ink-4);
  margin-left: auto;
  align-self: center;
}

/* Model rows */
.token-model-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.token-model-row {
  display: grid;
  grid-template-columns: 100px 64px 1fr 52px 90px;
  align-items: center;
  gap: var(--sp-3);
}
.token-model-name {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.token-model-count {
  font-size: var(--fs-sm);
  font-weight: 700;
  font-family: var(--ff-mono);
  color: var(--ink);
  text-align: right;
  white-space: nowrap;
}
.token-bar-wrap {
  height: 6px;
  background: var(--surface-3);
  border-radius: 3px;
  overflow: hidden;
}
.token-bar {
  height: 100%;
  border-radius: 3px;
  width: 0%;
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s;
  will-change: width;
}
.token-bar.safe   { background: var(--success); }
.token-bar.warn   { background: var(--warn); }
.token-bar.danger { background: var(--danger); }
.token-pct {
  font-size: var(--fs-xs);
  font-family: var(--ff-mono);
  color: var(--ink-4);
  text-align: right;
  white-space: nowrap;
}
.token-status {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 10px;
  white-space: nowrap;
  text-align: center;
}
.token-status.safe   { color: var(--success); background: color-mix(in srgb, var(--success) 12%, transparent); }
.token-status.warn   { color: var(--warn);    background: color-mix(in srgb, var(--warn)    12%, transparent); }
.token-status.danger { color: var(--danger);  background: color-mix(in srgb, var(--danger)  12%, transparent); }
/* Token Counter — responsive + reduced motion */
@media (max-width: 540px) {
  .token-model-row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    row-gap: var(--sp-1);
  }
  .token-model-name { grid-column: 1; grid-row: 1; }
  .token-model-count { grid-column: 2; grid-row: 1; }
  .token-bar-wrap { grid-column: 1; grid-row: 2; }
  .token-pct { grid-column: 2; grid-row: 2; text-align: right; }
  .token-status { display: none; }
  .token-summary-hint { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .token-bar { transition: none; }
}

