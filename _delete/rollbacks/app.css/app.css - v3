  }
  .stars button .material-symbols-outlined { font-size: 22px; }
  .stars button:hover { color: var(--gold); transform: scale(1.1); }
  .stars button.on { color: var(--gold); }
  .stars button.on .material-symbols-outlined { font-variation-settings: "FILL" 1; }

  /* Notes textarea */
  .form-textarea, .form-input {
    width: 100%;
    padding: 10px 12px;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--ink);
    box-shadow: var(--neu-inset);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .form-textarea:focus, .form-input:focus {
    border-color: var(--accent);
    box-shadow: var(--ring), var(--neu-inset);
  }

  /* Chain prompt search */
  .chain-search-wrap { position: relative; }
  .chain-search-results {
    position: absolute; top: calc(100% + 3px); left: 0; right: 0;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius-md, 8px); z-index: 50;
    max-height: 220px; overflow-y: auto;
    box-shadow: 0 6px 18px rgba(0,0,0,.22);
    display: none;
  }
  .chain-search-results.open { display: block; }
  .chain-search-result {
    padding: var(--sp-2) var(--sp-3); cursor: pointer;
    border-bottom: 1px solid var(--line);
  }
  .chain-search-result:last-child { border-bottom: 0; }
  .chain-search-result:hover { background: var(--surface-2); }
  .chain-search-result-title { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); }
  .chain-search-tags { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 3px; }
  .chain-search-tag {
    font-size: 10px; padding: 1px 6px; border-radius: 20px;
    background: var(--surface-3); color: var(--ink-3);
  }
  .chain-search-empty { padding: var(--sp-3); font-size: var(--fs-sm); color: var(--ink-3); text-align: center; }

  /* Chain steps */
  .chain-step {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    gap: var(--sp-3);
    align-items: center;
    padding: var(--sp-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    margin-bottom: var(--sp-2);
  }
  .chain-step-num {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    font-family: var(--ff-display);
    font-size: 13px; font-weight: 600;
    font-variation-settings: "opsz" 24;
  }
  .chain-step-body { min-width: 0; }
  .chain-step-title { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chain-step-meta { font-size: 11px; color: var(--ink-3); margin-top: 2px; }
  .chain-step-actions { display: flex; gap: 2px; }

  /* Version history list */
  .version-item {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    margin-bottom: var(--sp-2);
    cursor: pointer;
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .version-item:hover { background: var(--surface-3); border-color: var(--line-strong); }
  .version-meta { flex: 1; min-width: 0; }
  .version-title { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .version-time { font-size: 11px; color: var(--ink-3); margin-top: 2px; }

  /* Detail footer */
  .detail-footer {
    flex-shrink: 0;
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
    display: flex; gap: var(--sp-2);
    align-items: center;
  }
  .detail-footer #copyToClipboardBtn { flex: 1; justify-content: center; }

  .modal-overlay {
    position: fixed; inset: 0;
    background: oklch(15% 0.012 75 / 0.4);
    backdrop-filter: blur(2px);
    display: none;
    z-index: var(--z-overlay);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out-quart);
  }
  .modal-overlay.active { display: grid; place-items: center; opacity: 1; }
  :root[data-theme="dark"] .modal-overlay { background: oklch(0% 0 0 / 0.55); }

  .modal-box, .modal-box-sm {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg), var(--neu-raised);
    width: min(900px, 92vw);
    max-height: 88vh;
    display: flex; flex-direction: column;
    min-height: 0;
    transform: scale(0.97) translateY(8px);
    transition: transform var(--t-base) var(--ease-out-quart);
    overflow: hidden;
  }
  /* The form inside the modal must also be flex column so its body scrolls
     while the footer stays pinned visible. */
  .modal-box form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }
  .modal-box-sm { width: min(440px, 92vw); }
  .modal-overlay.active .modal-box,
  .modal-overlay.active .modal-box-sm { transform: scale(1) translateY(0); }

  .modal-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-5) var(--sp-3);
  }
  .modal-header h2 {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 64, "SOFT" 40;
  }
  .modal-header h3 { font-family: var(--ff-display); font-size: var(--fs-lg); font-weight: 500; letter-spacing: -0.015em; }
  .modal-header p { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 2px; }
  .modal-body { padding: var(--sp-2) var(--sp-5) var(--sp-5); overflow-y: auto; flex: 1 1 auto; min-height: 0; }
  .modal-footer { flex: 0 0 auto; }
  .modal-footer {
    display: flex; align-items: center; justify-content: flex-end; gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); margin-bottom: var(--sp-4); }
  .form-row.single { grid-template-columns: 1fr; }
  .form-group label.form-label {
    display: block;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .form-label .req { color: var(--danger); }

  .colour-swatches { display: flex; gap: 6px; flex-wrap: wrap; }
  .swatch {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 2px solid var(--line);
    cursor: pointer;
    transition: transform var(--t-fast), border-color var(--t-fast);
  }
  .swatch:hover { transform: scale(1.12); }
  .swatch.active { border-color: var(--ink); transform: scale(1.12); }
  .swatch.none { background: repeating-linear-gradient(45deg, var(--surface-3) 0 4px, var(--surface-2) 4px 8px); }
  .swatch.c-red    { background: var(--c-red); }
  .swatch.c-orange { background: var(--c-orange); }
  .swatch.c-yellow { background: var(--c-yellow); }
  .swatch.c-green  { background: var(--c-green); }
  .swatch.c-teal   { background: var(--c-teal); }
  .swatch.c-blue   { background: var(--c-blue); }
  .swatch.c-purple { background: var(--c-purple); }
  .swatch.c-pink   { background: var(--c-pink); }

  /* Editor tabs (inside the prompt modal) */
  .editor-tabs {
    display: flex; gap: 2px;
    border-bottom: 1px solid var(--line);
    margin: var(--sp-4) 0 var(--sp-4);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .editor-tabs::-webkit-scrollbar { display: none; }
  .editor-tab {
    padding: 8px 12px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .editor-tab:hover { color: var(--ink); }
  .editor-tab.active { color: var(--ink); border-color: var(--accent); font-weight: 600; }
  .editor-pane { display: none; }
  .editor-pane.active { display: block; }

  .editor-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    min-height: 320px;
  }
  .editor-grid-2 textarea {
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.65;
    padding: var(--sp-3);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: var(--ink);
    min-height: 320px;
    resize: vertical;
  }
  .editor-grid-2 textarea:focus { border-color: var(--accent); box-shadow: var(--ring); outline: none; }
  #editorPreview {
    padding: var(--sp-3);
    background: var(--surface-2);
    border: 1px dashed var(--line);
    border-radius: var(--r-sm);
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink);
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 320px;
  }
  #editorPreview .hint { color: var(--ink-4); font-style: italic; font-family: var(--ff-sans); }

  .vars-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; font-weight: 600; color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: var(--sp-2);
  }
  .vars-badge .material-symbols-outlined { font-size: 13px; }

  /* Variable meta editor row */
  .var-meta-row {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .var-meta-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-2);
  }
  .var-meta-name {
    font-family: var(--ff-mono);
    font-size: 13px; font-weight: 600;
    color: var(--accent);
  }
  .var-meta-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
  .var-meta-fields select, .var-meta-fields input {
    padding: 6px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 12px;
    color: var(--ink);
  }
  .var-meta-fields select:focus, .var-meta-fields input:focus { border-color: var(--accent); box-shadow: var(--ring); outline: none; }
  .visibility-toggle { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: var(--ink-3); cursor: pointer; }

  .dropdown-options { margin-top: var(--sp-2); display: flex; flex-direction: column; gap: 4px; }
  .dropdown-option-row { display: flex; gap: 4px; }
  .dropdown-option-row input { flex: 1; padding: 5px 8px; font-size: 12px; }

  /* Chat turns (system/user/assistant) */
  .chat-turn {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
    align-items: flex-start;
  }
  .chat-turn select { width: 100%; padding: 6px 8px; font-size: 12px; }
  .chat-turn textarea { min-height: 60px; font-size: 13px; }
  .chat-turn-add {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--accent);
    font-size: 12px; font-weight: 600;
    padding: 6px 10px;
    border-radius: var(--r-sm);
  }
  .chat-turn-add:hover { background: var(--accent-soft); }

  /* Export modal options */
  .export-option {
    width: 100%;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    margin-bottom: var(--sp-2);
    text-align: left;
    color: var(--ink);
    transition: background var(--t-fast), border-color var(--t-fast);
    cursor: pointer;
  }
  .export-option:hover { background: var(--surface-2); border-color: var(--line-strong); }
  .export-option .material-symbols-outlined { color: var(--ink-3); font-size: 22px; }
  .export-option-body { flex: 1; min-width: 0; }
  .export-option-title { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); }
  .export-option-desc { font-size: 11.5px; color: var(--ink-3); margin-top: 1px; }
  .export-option .premium-mark { color: var(--gold); font-size: 16px; margin-left: auto; }

  .premium-hero {
    text-align: center;
    padding: var(--sp-7) var(--sp-5) var(--sp-5);
    background:
      radial-gradient(circle at 20% 0%, oklch(80% 0.13 85 / 0.18), transparent 50%),
      radial-gradient(circle at 80% 0%, oklch(72% 0.13 245 / 0.15), transparent 50%);
  }
  .premium-mark-big {
    width: 56px; height: 56px;
    margin: 0 auto var(--sp-4);
    border-radius: var(--r-md);
    background: var(--ink);
    color: var(--gold);
    display: grid; place-items: center;
  }
  .premium-mark-big .material-symbols-outlined { font-size: 30px; font-variation-settings: "FILL" 1; }

  .feature-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .feature-item {
    display: flex; align-items: flex-start; gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .feature-item .material-symbols-outlined {
    font-size: 18px;
    color: var(--success);
    flex-shrink: 0;
    font-variation-settings: "FILL" 1;
  }

  .licence-row {
    display: flex; gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  .licence-row input { flex: 1; }
  #licenceError {
    font-size: 12px; color: var(--danger);
    display: none;
    margin-bottom: var(--sp-3);
  }
  #licenceError.show { display: block; }

  .premium-links {
    display: flex; gap: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
    font-size: 12px;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .stats-bar-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-4) var(--sp-4) var(--sp-3);
    transition: border-color var(--t-fast), background var(--t-fast);
    position: relative;
  }
  .stats-bar-card:hover { border-color: var(--line-strong); background: var(--surface-3); }
  .stats-bar-icon {
    color: var(--ink-3);
    font-size: 18px !important;
    margin-bottom: var(--sp-3);
    display: block;
  }
  .stats-bar-value {
    font-family: var(--ff-display);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variation-settings: "opsz" 64, "SOFT" 30;
    font-variant-numeric: tabular-nums;
    margin-bottom: 4px;
  }
  .stats-bar-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .stat-cell {
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .stat-value {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 400;
    color: var(--ink);
    margin-top: 4px;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 72, "SOFT" 30;
    font-variant-numeric: tabular-nums;
  }
  .stats-section { margin-bottom: var(--sp-5); }
  .stats-section h3 { font-family: var(--ff-display); font-size: var(--fs-md); font-weight: 500; letter-spacing: -0.015em; margin-bottom: var(--sp-3); }
  .top-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .top-list-item {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
  }
  .top-list-item .name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .top-list-item .count { font-variant-numeric: tabular-nums; color: var(--ink-3); font-size: 12px; }
  .bar-row { display: grid; grid-template-columns: 1fr 60px; gap: var(--sp-3); align-items: center; padding: 4px 0; }
  .bar-bg { height: 8px; background: var(--surface-3); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; transition: width var(--t-slow) var(--ease-out-expo); }

  #cmdPalette {
    position: fixed; inset: 0;
    z-index: var(--z-palette);
    display: none;
    background: oklch(15% 0.012 75 / 0.4);
    backdrop-filter: blur(2px);
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }
  #cmdPalette.active { display: flex; }
  :root[data-theme="dark"] #cmdPalette { background: oklch(0% 0 0 / 0.55); }
  .cmd-box {
    width: min(620px, 92vw);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .cmd-input-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .cmd-input-row .material-symbols-outlined { color: var(--ink-3); font-size: 20px; }
  #cmdInput {
    flex: 1; background: transparent; border: 0; outline: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    color: var(--ink);
    font-variation-settings: "opsz" 24, "SOFT" 40;
  }
  #cmdInput::placeholder { color: var(--ink-4); }
  .cmd-results {
    max-height: 50vh;
    overflow-y: auto;
    padding: var(--sp-2);
  }
  .cmd-result {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-sm);
    cursor: pointer;
    color: var(--ink);
  }
  .cmd-result .material-symbols-outlined { color: var(--ink-3); font-size: 18px; }
  .cmd-result:hover, .cmd-result.active { background: var(--surface-2); }
  .cmd-result .name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-sm); font-weight: 500; }
  .cmd-result .hint { font-size: 11px; color: var(--ink-3); }
  .cmd-empty { padding: var(--sp-5); text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }
  .cmd-footer {
    display: flex; gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    font-size: 11px;
    color: var(--ink-3);
  }
  .cmd-kbd {
    font-family: var(--ff-mono);
    font-size: 10.5px;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 4px;
  }

  #toastContainer {
    position: fixed;
    bottom: var(--sp-5);
    right: var(--sp-5);
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-2);
    z-index: var(--z-toast);
    pointer-events: none;
  }
  .toast {
    pointer-events: auto;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: 10px var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-sm); color: var(--ink);
    animation: toast-in var(--t-base) var(--ease-out-quart);
    min-width: 240px;
    max-width: 380px;
  }
  .toast.success { border-color: var(--success); }
  .toast.success .material-symbols-outlined { color: var(--success); }
  .toast.error   { border-color: var(--danger); }
  .toast.error   .material-symbols-outlined { color: var(--danger); }
  .toast.warning { border-color: var(--warn); }
  .toast.warning .material-symbols-outlined { color: var(--warn); }
  .toast.info    .material-symbols-outlined { color: var(--accent); }

  /* Skeleton loading */
  .skeleton {
    background: linear-gradient(90deg,
      var(--surface-2) 0%,
      var(--surface-3) 50%,
      var(--surface-2) 100%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.6s infinite linear;
    border-radius: var(--r-sm);
  }
  .skeleton-card { height: 90px; margin-bottom: var(--sp-3); }
}

/* =============================================================
   LAYER: motion - keyframes and reduced-motion override.
   ============================================================= */
@layer motion {
  @keyframes toast-in {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes skeleton-shimmer {
    from { background-position: 200% 0; }
    to   { background-position: -200% 0; }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    #detailPanel, .modal-box, .modal-box-sm { transition: none !important; }
  }
}

