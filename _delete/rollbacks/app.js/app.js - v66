      action: () => { closeCmdPalette(); showPremiumModal(); } },
    { kind:'action', icon:'auto_awesome',       label:'Load starter set',        hint:'demo',      keywords:'starters templates examples demo seed',
      action: () => { closeCmdPalette(); window.PL_loadStarters(); } },
  ];
