    } catch { toast('Could not save', 'error'); }
  });
  $('#closeChainBtn')?.addEventListener('click', closeChainWorkspace);
  ws.addEventListener('keydown', e => { if (e.key === 'Escape') closeChainWorkspace(); });
}

