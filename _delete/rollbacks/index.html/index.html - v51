          </div>
        </div>
      </div>
      <div class="shortcuts-editor-pane" id="shortcutsEditorPane">
        <div class="shortcuts-editor-empty" id="shortcutsEditorEmpty">
          <span class="material-symbols-outlined">keyboard_double_arrow_right</span>
          <span>Select a shortcut or create a new one</span>
        </div>
        <div class="shortcuts-editor-scroll" id="shortcutsEditorScroll" style="display:none">
          <div class="sc-field-group">
            <label class="sc-field-label">Trigger shortcut</label>
            <div style="display:flex;align-items:center;gap:var(--sp-2)">
              <span style="color:var(--ink-3);font-size:var(--fs-sm)">Must start with :</span>
              <input class="form-input" id="scTriggerInput" placeholder=":emailDraft" style="font-family:monospace;font-weight:700;max-width:220px">
            </div>
            <div style="margin-top:var(--sp-2);font-size:var(--fs-sm);color:var(--ink-3)">
              Press <kbd style="background:var(--surface-2);border:1px solid var(--line);border-radius:4px;padding:1px 6px;font-size:11px">Tab</kbd> after typing the trigger in the prompt editor to expand.
            </div>
          </div>
          <div class="sc-type-tabs" id="scTypeTabs">
            <div class="sc-type-tab active" data-type="prompt">Linked prompt</div>
            <div class="sc-type-tab" data-type="custom">Custom text</div>
          </div>
          <div id="scPromptPanel" class="sc-field-group">
            <label class="sc-field-label">Select prompt</label>
            <select class="form-input" id="scPromptSelect">
              <option value="">— choose a prompt —</option>
            </select>
            <div id="scPromptPreview" style="margin-top:var(--sp-2);padding:var(--sp-3);background:var(--surface-2);border-radius:var(--radius-md,8px);font-size:var(--fs-sm);color:var(--ink-2);max-height:120px;overflow-y:auto;display:none"></div>
          </div>
          <div id="scCustomPanel" class="sc-field-group" style="display:none">
            <label class="sc-field-label">Expansion text</label>
            <textarea class="form-input" id="scCustomText" rows="6" placeholder="Type the full text this shortcut expands to…" style="resize:vertical;font-family:inherit"></textarea>
          </div>
        </div>
        <div class="shortcuts-editor-toolbar" id="shortcutsEditorToolbar" style="display:none">
          <button class="btn btn-ghost btn-sm" id="scDeleteBtn" style="color:#ef4444">
            <span class="material-symbols-outlined">delete</span> Delete
          </button>
          <div style="flex:1"></div>
          <button class="btn btn-ghost btn-sm" id="scCancelBtn">Cancel</button>
          <button class="btn btn-primary btn-sm" id="scSaveBtn">Save shortcut</button>
        </div>
      </div>
    </div>
