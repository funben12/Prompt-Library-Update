    overflow: hidden;
  }
  #playgroundWorkspace.open { display: flex; }
  /* ── Text Expansion Workspace ─────────────────────────────────────── */
  #shortcutsWorkspace {
    position: fixed; inset: 0; z-index: var(--z-modal, 60);
