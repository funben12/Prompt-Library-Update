  }
  .shortcut-card-meta { flex: 1; min-width: 0; }
  .shortcut-card-title { font-size: var(--fs-sm); color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .shortcut-card-type { font-size: 11px; color: var(--ink-3); }
  .shortcut-card-del { opacity: 0; padding: 4px; border-radius: 4px; color: var(--ink-3); flex-shrink: 0; }
  .shortcut-card:hover .shortcut-card-del { opacity: 1; }
  .shortcut-card-del:hover { color: #ef4444; background: rgba(239,68,68,.1); }
  .shortcuts-list-empty { text-align: center; padding: var(--sp-8) var(--sp-4); color: var(--ink-3); font-size: var(--fs-sm); }
  .shortcuts-list-empty .material-symbols-outlined { font-size: 40px; display: block; margin-bottom: var(--sp-2); }
  .shortcuts-editor-pane { display: flex; flex-direction: column; overflow: hidden; }
  .shortcuts-editor-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--ink-3); gap: var(--sp-2); }
  .shortcuts-editor-empty .material-symbols-outlined { font-size: 48px; }
  .shortcuts-editor-scroll { flex: 1; overflow-y: auto; padding: var(--sp-5); }
  .shortcuts-editor-toolbar { padding: var(--sp-3) var(--sp-5); border-top: 1px solid var(--line); display: flex; gap: var(--sp-2); align-items: center; background: var(--surface); flex-shrink: 0; }
  .shortcut-suggest-strip { padding: var(--sp-2) var(--sp-3); border-bottom: 1px solid var(--line); background: rgba(99,102,241,.04); flex-shrink: 0; display: none; }
  .shortcut-suggest-strip.has-items { display: block; }
  .shortcut-suggest-label { font-size: 11px; font-weight: 600; color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; margin-bottom: var(--sp-1); }
  .shortcut-suggest-list { display: flex; flex-wrap: wrap; gap: var(--sp-1); }
  .shortcut-suggest-chip { font-size: var(--fs-sm); padding: 2px 10px; border-radius: 20px; border: 1px solid var(--accent); color: var(--accent); cursor: pointer; background: transparent; transition: background .12s; }
  .shortcut-suggest-chip:hover { background: rgba(99,102,241,.1); }
  .sc-field-group { margin-bottom: var(--sp-4); }
  .sc-field-label { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2); margin-bottom: var(--sp-1); display: block; }
  .sc-type-tabs { display: flex; gap: 2px; margin-bottom: var(--sp-4); background: var(--surface-2); padding: 3px; border-radius: var(--radius-md, 8px); }
  .sc-type-tab { flex: 1; padding: var(--sp-1) var(--sp-3); border-radius: calc(var(--radius-md, 8px) - 2px); font-size: var(--fs-sm); font-weight: 500; color: var(--ink-3); cursor: pointer; text-align: center; transition: background .15s, color .15s; }
  .sc-type-tab.active { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.1); }

  /* ── Header ── */
  .pg-header {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    flex-shrink: 0;
    z-index: 2;
  }
  .pg-header-title {
    font-family: var(--ff-display);
    font-size: var(--fs-lg); font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
    flex: 1;
  }
  .pg-header-sub {
    font-size: 12px; color: var(--ink-4);
    font-family: var(--ff-sans);
    font-weight: 400;
    margin-left: 8px;
    letter-spacing: 0;
  }
  .pg-header-actions { display: flex; gap: var(--sp-2); align-items: center; }

  /* ── Two-column layout: sessions list + canvas ── */
  .pg-body {
    display: grid;
    grid-template-columns: 260px 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Sessions sidebar ── */
  .pg-sessions {
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface-2);
  }
  .pg-sessions-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .pg-sessions-title {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .pg-sessions-list {
    flex: 1; overflow-y: auto;
    padding: var(--sp-2);
    display: flex; flex-direction: column; gap: 2px;
  }
  .pg-session-item {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: 8px var(--sp-3);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background var(--t-fast);
    position: relative;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .pg-session-item:hover { background: var(--surface-3); color: var(--ink); }
  .pg-session-item.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .pg-session-item .pg-session-pin {
    font-size: 14px !important;
    color: var(--warn);
    flex-shrink: 0;
  }
  .pg-session-item .pg-session-name {
    flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pg-session-item .pg-session-time {
    font-size: 10.5px; color: var(--ink-4);
    flex-shrink: 0;
    display: none;
  }
  .pg-session-item:hover .pg-session-time { display: block; }
  .pg-session-del {
    display: none;
    color: var(--danger);
    opacity: 0.7;
    padding: 2px;
    border-radius: 4px;
    flex-shrink: 0;
    font-size: 15px !important;
  }
  .pg-session-item:hover .pg-session-del { display: grid; place-items: center; }
  .pg-session-del:hover { opacity: 1; background: var(--danger-soft); }

  /* ── Canvas ── */
  .pg-canvas {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .pg-canvas-toolbar {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    flex-shrink: 0;
  }
  .pg-session-title-input {
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    font-weight: 500;
    letter-spacing: -0.01em;
    background: transparent;
    border: 0;
    border-bottom: 1px dashed var(--line);
    color: var(--ink);
    padding: 2px 0;
    width: 240px;
    transition: border-color var(--t-fast);
  }
  .pg-session-title-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .pg-mode-toggle {
    display: inline-flex;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 2px;
    margin-left: auto;
  }
  .pg-mode-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px; font-weight: 500;
    color: var(--ink-3);
    transition: background var(--t-fast), color var(--t-fast);
  }
  .pg-mode-btn .material-symbols-outlined { font-size: 15px; }
  .pg-mode-btn:hover { color: var(--ink); }
  .pg-mode-btn.active { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }

  /* ── Panels grid ── */
  .pg-panels {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    overflow: hidden;
    min-height: 0;
  }
  .pg-panels.split-2 { grid-template-columns: 1fr 1fr; }
  .pg-panels.split-3 { grid-template-columns: 1fr 1fr 1fr; }

  .pg-panel {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    overflow: hidden;
    min-width: 0;
  }
  .pg-panel:last-child { border-right: 0; }

  .pg-panel-header {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .pg-panel-label {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    flex: 1;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .pg-panel-label:focus { outline: none; color: var(--accent); }
  .pg-panel-model {
    font-size: 11px; color: var(--ink-4);
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 7px;
    font-family: var(--ff-mono);
    max-width: 110px;
  }
  .pg-panel-model:focus { outline: none; border-color: var(--accent); }

  .pg-panel-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .pg-panel-prompt {
    flex: 1;
    padding: var(--sp-4);
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink);
    background: var(--surface-sunk);
    border: 0;
    resize: none;
    outline: none;
    overflow-y: auto;
    min-height: 0;
  }
  .pg-panel-prompt:focus { background: var(--surface); }
  .pg-panel-prompt::placeholder { color: var(--ink-4); font-style: italic; font-family: var(--ff-sans); }

  /* Score bar at bottom of panel */
  .pg-panel-footer {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-4);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .pg-score-label { font-size: 11px; color: var(--ink-3); white-space: nowrap; }
  .pg-score-stars { display: flex; gap: 2px; }
  .pg-score-star {
    font-size: 16px !important;
    color: var(--ink-4);
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
    padding: 1px;
  }
  .pg-score-star:hover, .pg-score-star.on { color: var(--gold); }
  .pg-score-star.on { font-variation-settings: "FILL" 1; }
  .pg-panel-save-btn {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11.5px; font-weight: 600;
    color: var(--accent);
    padding: 3px 9px;
    border-radius: var(--r-sm);
    transition: background var(--t-fast);
  }
  .pg-panel-save-btn:hover { background: var(--accent-soft); }
  .pg-panel-save-btn .material-symbols-outlined { font-size: 14px; }
  .pg-char-count {
    font-size: 10.5px; color: var(--ink-4);
    font-family: var(--ff-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ── Empty state ── */
  .pg-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    flex: 1;
    gap: var(--sp-4);
    color: var(--ink-3);
    padding: var(--sp-8);
  }
  .pg-empty .material-symbols-outlined { font-size: 56px; color: var(--ink-4); }
  .pg-empty h3 {
    font-family: var(--ff-display);
    font-size: var(--fs-lg); font-weight: 400;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }
  .pg-empty p { font-size: var(--fs-sm); color: var(--ink-3); max-width: 36ch; text-align: center; line-height: 1.6; }

  /* ── Note textarea in toolbar ── */
  .pg-note-input {
    font-size: 12px; color: var(--ink-3);
    background: transparent;
    border: 0;
    border-bottom: 1px dashed transparent;
    padding: 2px 0;
    width: 220px;
    font-family: var(--ff-sans);
    transition: border-color var(--t-fast);
    resize: none;
    height: 22px;
    overflow: hidden;
  }
  .pg-note-input:focus { outline: none; border-color: var(--line); color: var(--ink); }
  .pg-note-input::placeholder { color: var(--ink-4); }

  /* ── API Settings panel (pops up above sidebar footer) ──────────── */
  #configPanel {
    position: fixed;
    bottom: 0;
    left: 0;
    width: var(--sidebar-w, 264px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 1px solid var(--line);
    border-radius: var(--radius-lg, 10px) var(--radius-lg, 10px) 0 0;
    box-shadow: 0 -4px 24px rgba(0,0,0,.14);
    z-index: 200;
    display: none;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(100%);
    transition: transform 0.2s ease;
  }
  #configPanel.open {
    display: flex;
    transform: translateY(0);
  }
  #configToggleBtn.active .material-symbols-outlined {
    color: var(--accent);
  }

  /* ── Config Panel internals ─────────────────────────────────────────────── */
  .config-panel-header {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .config-panel-header h4 {
    flex: 1; margin: 0;
    font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
  }
  .config-panel-body {
    padding: var(--sp-4);
    display: flex; flex-direction: column; gap: var(--sp-3);
    overflow-y: auto;
  }
  .config-section-label {
    font-size: 11px; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3);
    margin-bottom: var(--sp-2);
  }
  .config-provider-tabs {
    display: flex; gap: 4px; margin-bottom: var(--sp-3);
  }
  .config-provider-tab {
    flex: 1; padding: 6px 0;
    font-size: var(--fs-sm); font-weight: 500;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); color: var(--ink-2);
    cursor: pointer; transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .config-provider-tab:hover { background: var(--surface-3); color: var(--ink); }
  .config-provider-tab.active {
    background: var(--accent-soft); border-color: var(--accent);
    color: var(--accent); font-weight: 600;
  }
  .config-api-row { display: flex; flex-direction: column; gap: var(--sp-2); }

</style>
