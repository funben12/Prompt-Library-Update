<!doctype html>
<html lang="en-GB" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Prompt Library Pro</title>

<!-- Neumorphism typography: Space Mono (display/UI) + JetBrains Mono (code/mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

<style>
/* =============================================================
   CSS ARCHITECTURE - explicit cascade layers, predictable order.
   ============================================================= */
@layer reset, tokens, base, layout, components, utilities, motion;

/* =============================================================
   LAYER: tokens - design system in OKLCH, semantic naming.
   ============================================================= */
@layer tokens {
  :root {
    --fs-xs:   clamp(0.7rem, 0.67rem + 0.17vw, 0.75rem);
    --fs-sm:   clamp(0.75rem, 0.72rem + 0.17vw, 0.8rem);
    --fs-base: clamp(1rem, 1rem + 0vw, 1rem);
    --fs-md:   clamp(1.1rem, 1.06rem + 0.25vw, 1.15rem);
    --fs-lg:   clamp(1.3rem, 1.22rem + 0.42vw, 1.5rem);
    --fs-xl:   clamp(1.6rem, 1.45rem + 0.65vw, 2rem);
    --fs-2xl:  clamp(2.5rem, 2rem + 1.8vw, 3rem);

    --ff-display: "Fraunces", "Iowan Old Style", "Charter", Georgia, serif;
    --ff-sans:    "Instrument Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --ff-mono:    "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;

    --sp-1: 0.22rem;   /* 3.5  */
    --sp-2: 0.4rem;    /* 6.5  */
    --sp-3: 0.65rem;   /* 10.4 */
    --sp-4: 0.85rem;   /* 13.6 */
    --sp-5: 1.25rem;   /* 20 */
    --sp-6: 1.7rem;    /* 27.2 */
    --sp-7: 2.5rem;    /* 40 */
    --sp-8: 3.4rem;    /* 54.4 */
    --sp-9: 5rem;      /* 80 */

    --sidebar-w: 264px;
    --detail-w: clamp(360px, 32vw, 480px);
    --content-max: 920px;

    --r-sm: 4px;
    --r-md: 8px;
    --r-lg: 12px;
    --r-xl: 16px;

    --t-fast:   120ms;
    --t-base:   200ms;
    --t-slow:   320ms;
    --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
    --ease-out-expo:  cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in:        cubic-bezier(0.7, 0, 0.84, 0);

    /* Teal primary (#006666), warm beige surfaces (#E7E5E4), dark blue text (#1E2938) */
    --bg:           oklch(93.5% 0.01 70);    /* page */
    --surface:      oklch(95.2% 0.008 70);   /* cards / panels */
    --surface-2:    oklch(92%   0.012 70);   /* hover, sidebar */
    --surface-3:    oklch(88.5% 0.015 70);   /* deep wells, inputs at rest */
    --surface-sunk: oklch(91%   0.012 70);   /* recessed (search, textarea) */

    --line:         oklch(85%   0.016 70);
    --line-strong:  oklch(78%   0.020 70);

    --ink:          oklch(18%   0.04  260);  /* primary text */
    --ink-2:        oklch(32%   0.03  260);  /* body */
    --ink-3:        oklch(50%   0.015 260);  /* muted */
    --ink-4:        oklch(68%   0.010 260);  /* hint */

    --accent:       oklch(38%   0.14  190);  /* teal primary */
    --accent-hover: oklch(33%   0.15  190);
    --accent-soft:  oklch(93%   0.05  190);  /* tinted background */
    --accent-line:  oklch(80%   0.08  190);

    --warn:         oklch(63%   0.18  52);   /* #FE9900 */
    --warn-soft:    oklch(94%   0.05  52);
    --danger:       oklch(51%   0.21  30);   /* #FF2157 */
    --danger-soft:  oklch(94%   0.04  30);
    --success:      oklch(54%   0.14  140);  /* #00A63D */
    --success-soft: oklch(94%   0.04  140);

    --gold:         oklch(70%   0.14  85);   /* ratings, premium */

    --c-red:    oklch(60% 0.17 25);
    --c-orange: oklch(70% 0.15 55);
    --c-yellow: oklch(80% 0.13 90);
    --c-green:  oklch(58% 0.13 145);
    --c-teal:   oklch(60% 0.10 195);
    --c-blue:   oklch(55% 0.13 245);
    --c-purple: oklch(52% 0.16 295);
    --c-pink:   oklch(63% 0.16 350);

    --shadow-sm: 0 1px 2px oklch(18% 0.04 260 / 0.08);
    --shadow-md: 0 6px 20px -8px oklch(18% 0.04 260 / 0.12), 0 2px 6px oklch(18% 0.04 260 / 0.06);
    --shadow-lg: 0 20px 50px -16px oklch(18% 0.04 260 / 0.20), 0 6px 14px oklch(18% 0.04 260 / 0.09);
    --ring:      0 0 0 3px oklch(38% 0.14 190 / 0.20);

    /* Neuromorphic shadows — warm light source from top-left */
    --neu-raised:
      5px 5px 10px oklch(83% 0.016 70 / 0.70),
      -5px -5px 10px oklch(99.5% 0.004 70 / 0.55);
    --neu-raised-sm:
      3px 3px 6px oklch(83% 0.016 70 / 0.55),
      -3px -3px 6px oklch(99.5% 0.004 70 / 0.42);
    --neu-inset:
      inset 2px 2px 5px oklch(83% 0.016 70 / 0.55),
      inset -2px -2px 5px oklch(99.5% 0.004 70 / 0.40);
    --neu-pressed:
      inset 3px 3px 7px oklch(80% 0.016 70 / 0.65),
      inset -2px -2px 5px oklch(99.5% 0.004 70 / 0.35);

    --z-sidebar: 10;
    --z-detail:  20;
    --z-overlay: 50;
    --z-modal:   60;
    --z-toast:   80;
    --z-palette: 90;
  }

  :root[data-theme="dark"] {
    --bg:           oklch(16%   0.012 70);
    --surface:      oklch(20%   0.014 70);
    --surface-2:    oklch(24%   0.016 70);
    --surface-3:    oklch(28%   0.018 70);
    --surface-sunk: oklch(14%   0.012 70);

    --line:         oklch(30%   0.016 70);
    --line-strong:  oklch(38%   0.018 70);

    --ink:          oklch(93%   0.015 260);
    --ink-2:        oklch(80%   0.015 260);
    --ink-3:        oklch(62%   0.012 260);
    --ink-4:        oklch(48%   0.010 260);

    --accent:       oklch(72%   0.14  190);
    --accent-hover: oklch(78%   0.14  190);
    --accent-soft:  oklch(26%   0.08  190);
    --accent-line:  oklch(38%   0.12  190);

    --warn:         oklch(78%   0.17  52);
    --warn-soft:    oklch(26%   0.08  52);
    --danger:       oklch(74%   0.19  30);
    --danger-soft:  oklch(26%   0.08  30);
    --success:      oklch(74%   0.14  140);
    --success-soft: oklch(24%   0.06  140);

    --gold:         oklch(80%   0.14  85);

    --shadow-sm: 0 1px 2px oklch(0% 0 0 / 0.5);
    --shadow-md: 0 8px 24px -10px oklch(0% 0 0 / 0.65), 0 2px 8px oklch(0% 0 0 / 0.4);
    --shadow-lg: 0 24px 60px -20px oklch(0% 0 0 / 0.80), 0 8px 18px oklch(0% 0 0 / 0.5);
    --ring:      0 0 0 3px oklch(72% 0.14 190 / 0.35);

    /* Neuromorphic shadows — dark mode */
    --neu-raised:
      5px 5px 10px oklch(10% 0.010 70 / 0.80),
      -5px -5px 10px oklch(28% 0.016 70 / 0.50);
    --neu-raised-sm:
      3px 3px 6px oklch(10% 0.010 70 / 0.65),
      -3px -3px 6px oklch(28% 0.016 70 / 0.40);
    --neu-inset:
      inset 2px 2px 5px oklch(10% 0.010 70 / 0.65),
      inset -2px -2px 5px oklch(28% 0.016 70 / 0.40);
    --neu-pressed:
      inset 3px 3px 7px oklch(10% 0.010 70 / 0.75),
      inset -2px -2px 5px oklch(28% 0.016 70 / 0.30);

    --c-red:    oklch(72% 0.17 25);
    --c-orange: oklch(80% 0.15 55);
    --c-yellow: oklch(88% 0.13 90);
    --c-green:  oklch(72% 0.14 140);
    --c-teal:   oklch(70% 0.10 190);
    --c-blue:   oklch(70% 0.14 190);
    --c-purple: oklch(70% 0.16 295);
    --c-pink:   oklch(76% 0.16 350);
  }

  /* ── Neumorphic depth utilities ──────────────────────────────────────
     Soft raised / inset depth for dark & light themes.
     Dark: shadow pair on the dark bg.
     Light: handled with lighter inset shadow pair.
  ────────────────────────────────────────────────────────────────────── */
  .nm-raised {
    box-shadow:
      4px 4px 10px rgba(0,0,0,.35),
      -2px -2px 6px rgba(255,255,255,.045);
    border: 1px solid transparent;
  }
  .nm-inset {
    box-shadow:
      inset 2px 2px 6px rgba(0,0,0,.35),
      inset -1px -1px 4px rgba(255,255,255,.04);
  }
  .nm-badge {
    background: linear-gradient(135deg, rgba(99,102,241,.18), rgba(168,85,247,.12));
    box-shadow:
      2px 2px 6px rgba(0,0,0,.3),
      -1px -1px 4px rgba(168,85,247,.08);
    border: 1px solid rgba(99,102,241,.25);
  }
  :root:not([data-theme="dark"]) .nm-raised {
    box-shadow:
      4px 4px 10px rgba(160,160,180,.35),
      -2px -2px 6px rgba(255,255,255,.8);
  }
  :root:not([data-theme="dark"]) .nm-inset {
    box-shadow:
      inset 2px 2px 6px rgba(160,160,180,.3),
      inset -1px -1px 4px rgba(255,255,255,.75);
  }
  :root:not([data-theme="dark"]) .nm-badge {
    background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(168,85,247,.08));
    box-shadow:
      2px 2px 5px rgba(160,160,180,.3),
      -1px -1px 3px rgba(255,255,255,.9);
  }

  /* ── Premium modal feature cards ─────────────────────────────────────── */
  .premium-feature-card {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-md, 8px);
    background: var(--surface-2);
    display: flex; align-items: center; gap: var(--sp-3);
    box-shadow:
      3px 3px 8px rgba(0,0,0,.3),
      -1px -1px 4px rgba(255,255,255,.04);
    border: 1px solid rgba(99,102,241,.15);
    transition: box-shadow .2s;
  }
  .premium-feature-card:hover {
    box-shadow:
      4px 4px 12px rgba(0,0,0,.38),
      -2px -2px 6px rgba(99,102,241,.08);
    border-color: rgba(99,102,241,.3);
  }
  .premium-feature-card .material-symbols-outlined {
    font-size: 22px; color: var(--accent); flex-shrink: 0;
  }
  .premium-feature-card-label {
    font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
  }
  .premium-feature-card-desc {
    font-size: 11px; color: var(--ink-3); margin-top: 1px;
  }
  .premium-features-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-2);
    margin: var(--sp-4) 0;
  }

  /* ── Workspace header neumorphic depth ──────────────────────────────── */
  .roles-header,
  .shortcuts-header {
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
}
/* =============================================================
   LAYER: reset - minimal modern.
   ============================================================= */
@layer reset {
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  html, body, #app { height: 100%; }
  body { overflow: hidden; }
  img, svg { display: block; max-width: 100%; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  input, textarea, select { font: inherit; color: inherit; }
  textarea { resize: vertical; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 2px; }
  ::selection { background: var(--accent-soft); color: var(--ink); }
  :focus { outline: none; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
}

/* =============================================================
   LAYER: base - typography, root surface.
   ============================================================= */
@layer base {
  body {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--ink);
    background: var(--bg);
    font-feature-settings: "ss01", "cv11";
  }

  h1, h2, h3, h4 {
    font-family: var(--ff-display);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variation-settings: "opsz" 32, "SOFT" 30;
  }
  h1 { font-size: var(--fs-2xl); font-variation-settings: "opsz" 96, "SOFT" 40; letter-spacing: -0.025em; }
  h2 { font-size: var(--fs-xl); }
  h3 { font-size: var(--fs-lg); }
  h4 { font-size: var(--fs-md); font-weight: 600; }

  p, li { color: var(--ink-2); }

  /* Material symbols default sizing */
  .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 20;
    user-select: none;
    flex-shrink: 0;
  }

  .eyebrow {
    font-family: var(--ff-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Pull-quote styled prompt content rendering */
  .serif { font-family: var(--ff-display); font-weight: 400; }
  .mono  { font-family: var(--ff-mono); font-feature-settings: "ss01"; }
}

/* =============================================================
   LAYER: layout - app shell.
   ============================================================= */
@layer layout {
  #app {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    height: 100vh;
    background: var(--bg);
    overflow: hidden; /* clip sidebar when collapsed */
  }

  body.sidebar-hidden #app { grid-template-columns: 0 minmax(0, 1fr); }
  body.sidebar-hidden #sidebar {
    transform: translateX(calc(-1 * var(--sidebar-w)));
    pointer-events: none;
    opacity: 0;
  }

  #sidebar {
    grid-column: 1;
    width: var(--sidebar-w);   /* explicit width — makes translateX(-sidebar-w) work */
    background: var(--surface-2);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    transition: transform var(--t-base) var(--ease-out-quart),
                opacity var(--t-fast) linear;
    z-index: var(--z-sidebar);
  }

  #main {
    grid-column: 2;
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    min-height: 0;
    position: relative;
  }

  #content {
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--sp-5) clamp(var(--sp-5), 4vw, var(--sp-7)) var(--sp-7);
    scroll-padding-top: var(--sp-5);
  }
  #content > * + * { margin-top: var(--sp-5); }

  #detailPanel {
    position: absolute;
    inset: 0 0 0 auto;
    width: var(--detail-w);
    background: var(--surface);
    border-left: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform var(--t-slow) var(--ease-out-expo);
    z-index: var(--z-detail);
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  #detailPanel.open { transform: translateX(0); }
}

/* =============================================================
   LAYER: components - reusable UI pieces.
   ============================================================= */
@layer components {

  .brand {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-5) var(--sp-5) var(--sp-4);
  }
  .brand-mark {
    width: 32px; height: 32px;
    border-radius: var(--r-sm);
    display: grid; place-items: center;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--ff-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 24, "SOFT" 50;
  }
  .brand-name {
    font-family: var(--ff-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variation-settings: "opsz" 32, "SOFT" 40;
  }
  .brand-pro {
    font-family: var(--ff-sans);
    font-size: 9.5px; font-weight: 700; letter-spacing: 0.16em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 6px; border-radius: 4px;
    margin-left: 4px;
  }

  .nav-section {
    padding: 0 var(--sp-3);
    margin-top: var(--sp-2);
  }
  .nav-section + .nav-section { margin-top: var(--sp-4); }

  .nav-section-label {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-2) var(--sp-3);
    color: var(--ink-3);
    font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    cursor: pointer;
    user-select: none;
  }
  .nav-section-label:hover { color: var(--ink-2); }
  .nav-section-label .chev { transition: transform var(--t-base) var(--ease-out-quart); }
  .nav-section-content.collapsed { display: none; }
  .nav-section-content.collapsed ~ .chev,
  .nav-section-label[aria-expanded="false"] .chev { transform: rotate(-90deg); }

  .nav-icon-btn {
    width: 22px; height: 22px;
    display: grid; place-items: center;
    border-radius: 4px;
    color: var(--ink-3);
    transition: color var(--t-fast), background var(--t-fast);
  }
  .nav-icon-btn:hover { color: var(--ink); background: var(--surface-3); }
  .nav-icon-btn .material-symbols-outlined { font-size: 16px; }

  .nav-item {
    width: 100%;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: 7px var(--sp-3);
    border-radius: var(--r-sm);
    color: var(--ink-2);
    font-size: var(--fs-sm); font-weight: 500;
    text-align: left;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .nav-item:hover { background: var(--surface-3); color: var(--ink); }
  .nav-item.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .nav-item .material-symbols-outlined { font-size: 18px; }
  .nav-count {
    margin-left: auto;
    font-size: 11px; font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .nav-item.active .nav-count { color: var(--accent); }
  .nav-lock { font-size: 14px !important; color: var(--ink-4); margin-left: auto; }

  /* Folder list items in sidebar */
  .folder-item {
    width: 100%;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: 6px var(--sp-3);
    border-radius: var(--r-sm);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: background var(--t-fast);
    position: relative;
  }
  .folder-item:hover { background: var(--surface-3); }
  .folder-item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .folder-item .folder-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .folder-item .folder-count {
    font-size: 11px; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .folder-item .material-symbols-outlined { font-size: 16px; color: var(--ink-3); }
  .folder-item.active .material-symbols-outlined { color: var(--accent); }
  .folder-actions {
    display: none; gap: 2px;
    position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    background: var(--surface-2);
    padding-left: 6px;
  }
  .folder-item:hover .folder-actions { display: flex; }
  .folder-item:hover .folder-count { display: none; }
  .folder-mini-btn {
    width: 22px; height: 22px;
    border-radius: 4px;
    display: grid; place-items: center;
    color: var(--ink-3);
    transition: background var(--t-fast), color var(--t-fast);
  }
  .folder-mini-btn:hover { background: var(--surface-3); color: var(--ink); }
  .folder-mini-btn.danger:hover { color: var(--danger); }
  .folder-mini-btn .material-symbols-outlined { font-size: 14px; }

  /* Filter list (categories, tags) */
  .filter-list {
    display: flex; flex-direction: column; gap: 1px;
  }
  .filter-list-item {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: 5px var(--sp-3);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    color: var(--ink-2);
    cursor: pointer;
    transition: background var(--t-fast);
  }
  .filter-list-item:hover { background: var(--surface-3); }
  .filter-list-item.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .filter-list-item .filter-count {
    margin-left: auto;
    font-size: 11px; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .filter-list-empty {
    font-size: 12px; color: var(--ink-4);
    padding: var(--sp-2) var(--sp-3);
    font-style: italic;
  }

  /* Sidebar scroll area */
  #sidebarScroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
