  .shortcuts-header h2 { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); margin: 0; flex: 1; }
  .shortcuts-body { display: grid; grid-template-columns: 280px 1fr; flex: 1; overflow: hidden; }
  .shortcuts-list-pane { border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow: hidden; }
  .shortcuts-list-header { padding: var(--sp-3); border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: var(--sp-2); flex-shrink: 0; }
  .shortcuts-list-scroll { flex: 1; overflow-y: auto; padding: var(--sp-2); }
  .shortcut-card {
