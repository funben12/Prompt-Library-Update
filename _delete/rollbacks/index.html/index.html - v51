  /* ============================================================
     PROMPT PLAYGROUND WORKSPACE
     A full-screen scratch-pad for drafting, splitting, and
     comparing prompts before adding them to the library.
     ============================================================ */

  #playgroundWorkspace {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 100);
