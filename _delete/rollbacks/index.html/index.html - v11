    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .detail-actions { display: flex; gap: 2px; }
  .detail-tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
    padding: 0 var(--sp-4);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
