  .empty h2 em { font-style: italic; color: var(--accent); font-variation-settings: "opsz" 96, "SOFT" 80; }
  .empty p { font-size: var(--fs-md); color: var(--ink-2); margin-bottom: var(--sp-5); max-width: 52ch; line-height: 1.6; }
  .empty .empty-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  .detail-header {
