    font-variation-settings: "opsz" 64, "SOFT" 40;
  }
  .modal-header h3 { font-family: var(--ff-display); font-size: var(--fs-lg); font-weight: 500; letter-spacing: -0.015em; }
  .modal-header p { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 2px; }
  .modal-body { padding: var(--sp-2) var(--sp-5) var(--sp-5); overflow-y: auto; flex: 1 1 auto; min-height: 0; }
  .modal-footer { flex: 0 0 auto; }
  .modal-footer {
    display: flex; align-items: center; justify-content: flex-end; gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); margin-bottom: var(--sp-4); }
  .form-row.single { grid-template-columns: 1fr; }
  .form-group label.form-label {
    display: block;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .form-label .req { color: var(--danger); }

  .colour-swatches { display: flex; gap: 6px; flex-wrap: wrap; }
  .swatch {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 2px solid var(--line);
    cursor: pointer;
    transition: transform var(--t-fast), border-color var(--t-fast);
  }
  .swatch:hover { transform: scale(1.12); }
  .swatch.active { border-color: var(--ink); transform: scale(1.12); }
  .swatch.none { background: repeating-linear-gradient(45deg, var(--surface-3) 0 4px, var(--surface-2) 4px 8px); }
  .swatch.c-red    { background: var(--c-red); }
  .swatch.c-orange { background: var(--c-orange); }
  .swatch.c-yellow { background: var(--c-yellow); }
  .swatch.c-green  { background: var(--c-green); }
  .swatch.c-teal   { background: var(--c-teal); }
  .swatch.c-blue   { background: var(--c-blue); }
  .swatch.c-purple { background: var(--c-purple); }
  .swatch.c-pink   { background: var(--c-pink); }

  /* Editor tabs (inside the prompt modal) */
  .editor-tabs {
    display: flex; gap: 2px;
    border-bottom: 1px solid var(--line);
    margin: var(--sp-4) 0 var(--sp-4);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .editor-tabs::-webkit-scrollbar { display: none; }
  .editor-tab {
    padding: 8px 12px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .editor-tab:hover { color: var(--ink); }
  .editor-tab.active { color: var(--ink); border-color: var(--accent); font-weight: 600; }
  .editor-pane { display: none; }
  .editor-pane.active { display: block; }

  .editor-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    min-height: 320px;
  }
  .editor-grid-2 textarea {
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.65;
    padding: var(--sp-3);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: var(--ink);
    min-height: 320px;
    resize: vertical;
  }
  .editor-grid-2 textarea:focus { border-color: var(--accent); box-shadow: var(--ring); outline: none; }
  #editorPreview {
    padding: var(--sp-3);
    background: var(--surface-2);
    border: 1px dashed var(--line);
    border-radius: var(--r-sm);
    font-family: var(--ff-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink);
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 320px;
  }
  #editorPreview .hint { color: var(--ink-4); font-style: italic; font-family: var(--ff-sans); }

  .vars-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; font-weight: 600; color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: var(--sp-2);
  }
  .vars-badge .material-symbols-outlined { font-size: 13px; }

  /* Variable meta editor row */
  .var-meta-row {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .var-meta-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--sp-2);
  }
  .var-meta-name {
    font-family: var(--ff-mono);
    font-size: 13px; font-weight: 600;
    color: var(--accent);
  }
  .var-meta-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
  .var-meta-fields select, .var-meta-fields input {
    padding: 6px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 12px;
    color: var(--ink);
  }
  .var-meta-fields select:focus, .var-meta-fields input:focus { border-color: var(--accent); box-shadow: var(--ring); outline: none; }
  .visibility-toggle { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: var(--ink-3); cursor: pointer; }

  .dropdown-options { margin-top: var(--sp-2); display: flex; flex-direction: column; gap: 4px; }
  .dropdown-option-row { display: flex; gap: 4px; }
  .dropdown-option-row input { flex: 1; padding: 5px 8px; font-size: 12px; }

  /* Chat turns (system/user/assistant) */
  .chat-turn {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
    align-items: flex-start;
  }
  .chat-turn select { width: 100%; padding: 6px 8px; font-size: 12px; }
  .chat-turn textarea { min-height: 60px; font-size: 13px; }
  .chat-turn-add {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--accent);
    font-size: 12px; font-weight: 600;
    padding: 6px 10px;
    border-radius: var(--r-sm);
  }
  .chat-turn-add:hover { background: var(--accent-soft); }

  /* Export modal options */
  .export-option {
    width: 100%;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    margin-bottom: var(--sp-2);
    text-align: left;
    color: var(--ink);
    transition: background var(--t-fast), border-color var(--t-fast);
    cursor: pointer;
  }
  .export-option:hover { background: var(--surface-2); border-color: var(--line-strong); }
  .export-option .material-symbols-outlined { color: var(--ink-3); font-size: 22px; }
  .export-option-body { flex: 1; min-width: 0; }
  .export-option-title { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); }
  .export-option-desc { font-size: 11.5px; color: var(--ink-3); margin-top: 1px; }
  .export-option .premium-mark { color: var(--gold); font-size: 16px; margin-left: auto; }

  .premium-hero {
    text-align: center;
    padding: var(--sp-7) var(--sp-5) var(--sp-5);
    background:
      radial-gradient(circle at 20% 0%, oklch(80% 0.13 85 / 0.18), transparent 50%),
      radial-gradient(circle at 80% 0%, oklch(72% 0.13 245 / 0.15), transparent 50%);
  }
  .premium-mark-big {
    width: 56px; height: 56px;
    margin: 0 auto var(--sp-4);
    border-radius: var(--r-md);
    background: var(--ink);
    color: var(--gold);
    display: grid; place-items: center;
  }
  .premium-mark-big .material-symbols-outlined { font-size: 30px; font-variation-settings: "FILL" 1; }

  .feature-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .feature-item {
    display: flex; align-items: flex-start; gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .feature-item .material-symbols-outlined {
    font-size: 18px;
    color: var(--success);
    flex-shrink: 0;
    font-variation-settings: "FILL" 1;
  }

  .licence-row {
    display: flex; gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  .licence-row input { flex: 1; }
  #licenceError {
    font-size: 12px; color: var(--danger);
    display: none;
    margin-bottom: var(--sp-3);
  }
  #licenceError.show { display: block; }

  .premium-links {
    display: flex; gap: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
    font-size: 12px;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .stats-bar-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-4) var(--sp-4) var(--sp-3);
    transition: border-color var(--t-fast), background var(--t-fast);
    position: relative;
  }
  .stats-bar-card:hover { border-color: var(--line-strong); background: var(--surface-3); }
  .stats-bar-icon {
    color: var(--ink-3);
    font-size: 18px !important;
    margin-bottom: var(--sp-3);
    display: block;
  }
  .stats-bar-value {
    font-family: var(--ff-display);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variation-settings: "opsz" 64, "SOFT" 30;
    font-variant-numeric: tabular-nums;
    margin-bottom: 4px;
  }
  .stats-bar-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .stat-cell {
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .stat-value {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 400;
    color: var(--ink);
    margin-top: 4px;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 72, "SOFT" 30;
    font-variant-numeric: tabular-nums;
  }
  .stats-section { margin-bottom: var(--sp-5); }
  .stats-section h3 { font-family: var(--ff-display); font-size: var(--fs-md); font-weight: 500; letter-spacing: -0.015em; margin-bottom: var(--sp-3); }
  .top-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .top-list-item {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
  }
  .top-list-item .name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
  .top-list-item .count { font-variant-numeric: tabular-nums; color: var(--ink-3); font-size: 12px; }
  .bar-row { display: grid; grid-template-columns: 1fr 60px; gap: var(--sp-3); align-items: center; padding: 4px 0; }
  .bar-bg { height: 8px; background: var(--surface-3); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; transition: width var(--t-slow) var(--ease-out-expo); }

  #cmdPalette {
    position: fixed; inset: 0;
    z-index: var(--z-palette);
    display: none;
    background: oklch(15% 0.012 75 / 0.4);
    backdrop-filter: blur(2px);
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }
  #cmdPalette.active { display: flex; }
  :root[data-theme="dark"] #cmdPalette { background: oklch(0% 0 0 / 0.55); }
  .cmd-box {
    width: min(620px, 92vw);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .cmd-input-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .cmd-input-row .material-symbols-outlined { color: var(--ink-3); font-size: 20px; }
  #cmdInput {
    flex: 1; background: transparent; border: 0; outline: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-md);
    color: var(--ink);
    font-variation-settings: "opsz" 24, "SOFT" 40;
  }
  #cmdInput::placeholder { color: var(--ink-4); }
  .cmd-results {
    max-height: 50vh;
    overflow-y: auto;
    padding: var(--sp-2);
  }
  .cmd-result {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-sm);
    cursor: pointer;
    color: var(--ink);
  }
  .cmd-result .material-symbols-outlined { color: var(--ink-3); font-size: 18px; }
  .cmd-result:hover, .cmd-result.active { background: var(--surface-2); }
  .cmd-result .name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-sm); font-weight: 500; }
  .cmd-result .hint { font-size: 11px; color: var(--ink-3); }
  .cmd-empty { padding: var(--sp-5); text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }
  .cmd-footer {
    display: flex; gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    font-size: 11px;
    color: var(--ink-3);
  }
  .cmd-kbd {
    font-family: var(--ff-mono);
    font-size: 10.5px;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 4px;
  }

  #toastContainer {
    position: fixed;
    bottom: var(--sp-5);
    right: var(--sp-5);
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-2);
    z-index: var(--z-toast);
    pointer-events: none;
  }
  .toast {
    pointer-events: auto;
    display: flex; align-items: center; gap: var(--sp-3);
    padding: 10px var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-sm); color: var(--ink);
    animation: toast-in var(--t-base) var(--ease-out-quart);
    min-width: 240px;
    max-width: 380px;
  }
  .toast.success { border-color: var(--success); }
  .toast.success .material-symbols-outlined { color: var(--success); }
  .toast.error   { border-color: var(--danger); }
  .toast.error   .material-symbols-outlined { color: var(--danger); }
  .toast.warning { border-color: var(--warn); }
  .toast.warning .material-symbols-outlined { color: var(--warn); }
  .toast.info    .material-symbols-outlined { color: var(--accent); }

  /* Skeleton loading */
  .skeleton {
    background: linear-gradient(90deg,
      var(--surface-2) 0%,
      var(--surface-3) 50%,
      var(--surface-2) 100%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.6s infinite linear;
    border-radius: var(--r-sm);
  }
  .skeleton-card { height: 90px; margin-bottom: var(--sp-3); }
}

/* =============================================================
   LAYER: motion - keyframes and reduced-motion override.
   ============================================================= */
@layer motion {
  @keyframes toast-in {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes skeleton-shimmer {
    from { background-position: 200% 0; }
    to   { background-position: -200% 0; }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    #detailPanel, .modal-box, .modal-box-sm { transition: none !important; }
  }
}

/* =============================================================
   TAG CHIP INPUT COMPONENT
   ============================================================= */
@layer components {
  .tag-input-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    padding: 5px 10px;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    min-height: 40px;
    cursor: text;
    box-shadow: var(--neu-inset);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
    position: relative;
  }
  .tag-input-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: var(--ring), var(--neu-inset);
  }
  .tag-chip-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px 2px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-line);
    white-space: nowrap;
    user-select: none;
    line-height: 1.4;
  }
  .tag-chip-item.is-cat {
    background: var(--surface-3);
    color: var(--ink-2);
    border-color: var(--line-strong);
  }
  .tag-chip-x {
    width: 16px; height: 16px;
    display: grid; place-items: center;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity var(--t-fast), background var(--t-fast);
    flex-shrink: 0;
  }
  .tag-chip-x:hover { opacity: 1; background: oklch(0% 0 0 / 0.12); }
  .tag-chip-x .material-symbols-outlined { font-size: 11px; }
  .tag-input-field {
    border: 0; outline: 0;
    background: transparent;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-family: var(--ff-sans);
    min-width: 80px;
    flex: 1;
    padding: 2px 0;
  }
  .tag-input-field::placeholder { color: var(--ink-4); }
  .tag-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: var(--z-overlay);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md), var(--neu-raised);
    max-height: 180px;
    overflow-y: auto;
    min-width: 180px;
    width: 100%;
  }
  .tag-dropdown-item {
    padding: 7px 12px;
    font-size: var(--fs-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    transition: background var(--t-fast);
  }
  .tag-dropdown-item:hover, .tag-dropdown-item.kbd-active {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .tag-dropdown-item .td-count { font-size: 11px; color: var(--ink-4); }
  .tag-dropdown-create {
    font-style: italic;
    color: var(--accent);
    border-top: 1px solid var(--line);
  }

  /* Chain run UX in detail panel */
  .chain-runner {
    margin-top: var(--sp-3);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--neu-raised-sm);
  }
  .chain-runner-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm); font-weight: 600;
  }
  .chain-runner-step {
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .chain-runner-step:last-child { border-bottom: 0; }
  .chain-runner-step.current { background: var(--accent-soft); }
  .chain-runner-step.done { opacity: 0.5; }
  .chain-step-num-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--surface-3);
    color: var(--ink-3);
    font-size: 11px; font-weight: 700;
    flex-shrink: 0;
  }
  .chain-step-num-badge.current { background: var(--accent); color: white; }
  .chain-step-num-badge.done { background: var(--success); color: white; }
  /* Phase context carry-forward indicator */
  .chain-phase-context {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    background: var(--accent-soft);
    border-top: 1px solid var(--line);
    font-size: 11px; font-weight: 600; color: var(--accent);
  }
  /* AI response capture area between phases */
  .chain-output-capture {
    padding: var(--sp-4);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  /* Per-phase summary row shown at completion */
  .chain-phase-summary {
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .chain-phase-summary:last-child { border-bottom: 0; }
  /* Clipped preview of captured AI response */
  .chain-output-preview {
    margin-top: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border-radius: var(--r-sm);
    font-size: 11px; color: var(--ink-2);
    border-left: 3px solid var(--success);
    white-space: pre-wrap; word-break: break-word;
  }
  .chain-runner-actions {
    display: flex; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-2);
    border-top: 1px solid var(--line);
  }

  /* Import format tabs */
  .import-format-tabs {
    display: flex; gap: 2px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 3px;
    margin-bottom: var(--sp-3);
  }
  .import-fmt-tab {
    flex: 1;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: var(--fs-sm); font-weight: 500;
    color: var(--ink-3);
    text-align: center;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .import-fmt-tab.active {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }
}

/* =============================================================
   LAYER: utilities - final overrides.
   ============================================================= */
@layer utilities {
  .hidden { display: none !important; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .premium-locked {
    opacity: 0.72;
    position: relative;
    cursor: pointer;
  }
  .premium-locked:hover {
    opacity: 1;
    color: var(--accent);
  }
  .premium-locked .nav-lock,
  .premium-locked .lock { display: inline-flex; }
}

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 8px; border: 2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: var(--ink-4); }
::-webkit-scrollbar-track { background: transparent; }
@layer utilities {
  #content {
    background:
      linear-gradient(90deg, transparent 0, transparent calc(100% - 1px), var(--line) calc(100% - 1px)) 0 0 / min(100%, 920px) 100% no-repeat;
  }

  #promptsContainer.list-view {
    max-width: var(--content-max);
  }

  #promptsContainer.list-view .prompt-card {
    min-height: 116px;
    padding-right: var(--sp-4);
  }

  #promptsContainer.list-view .card-actions {
    opacity: 1;
    background: color-mix(in oklch, var(--bg), transparent 6%);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 2px;
  }

  .card-title,
  h1, h2, h3, h4 {
    letter-spacing: 0;
  }

  .empty {
    max-width: min(860px, 100%);
    padding: clamp(var(--sp-7), 9vh, var(--sp-9)) 0;
  }
  .empty-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: clamp(var(--sp-6), 5vw, var(--sp-8));
    align-items: start;
  }
  .empty h2 {
    max-width: 12ch;
    letter-spacing: 0;
  }
  .empty-proof {
    border-left: 1px solid var(--line);
    padding-left: var(--sp-5);
    display: grid;
    gap: var(--sp-3);
    color: var(--ink-3);
    font-size: var(--fs-sm);
  }
  .empty-proof-item {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--sp-3);
    align-items: start;
  }
  .empty-proof-item .material-symbols-outlined {
    color: var(--accent);
    font-size: 18px;
  }

  .premium-hero {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  .modal-box {
    width: min(980px, 92vw);
  }

  .editor-grid-2 {
    grid-template-columns: minmax(320px, 1fr) minmax(300px, 0.85fr);
  }

  .modal-overlay.active .modal-box,
  .modal-overlay.active .modal-box-sm {
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 980px) {
    .empty-shell {
      grid-template-columns: 1fr;
    }
    .empty-proof {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: var(--sp-5);
    }
    .editor-grid-2 {
      grid-template-columns: 1fr;
    }
  }
}

  /* ============================================================
     ROLES WORKSPACE
     ============================================================ */
  #rolesWorkspace {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 100);
    background: var(--surface);
    flex-direction: column;
  }
  #rolesWorkspace.open { display: flex; }
  .roles-header {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid var(--line);
    background: var(--surface); flex-shrink: 0;
  }
  .roles-header h2 { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); margin: 0; flex: 1; }
  .roles-body { display: grid; grid-template-columns: 280px 1fr; flex: 1; overflow: hidden; }
  .roles-list-pane { border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow: hidden; }
  .roles-list-search { padding: var(--sp-3); border-bottom: 1px solid var(--line); flex-shrink: 0; }
  .roles-list-scroll { flex: 1; overflow-y: auto; padding: var(--sp-2); }
  .role-list-item {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3); border-radius: var(--radius);
    cursor: pointer; transition: background var(--t-base); position: relative;
  }
  .role-list-item:hover { background: var(--surface-3); }
  .role-list-item.active { background: var(--accent-soft); }
  .role-list-item.active .role-item-name { color: var(--accent); font-weight: 600; }
  .role-color-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .role-item-icon { font-size: 18px; line-height: 1; }
  .role-item-name { font-size: var(--fs-sm); color: var(--ink); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .role-item-fav {
    font-size: 14px; color: var(--ink-4); cursor: pointer; padding: 2px;
    border-radius: 4px; background: none; border: none; transition: color var(--t-base);
  }
  .role-item-fav:hover { color: var(--warning, #f59e0b); }
  .role-item-fav.active { color: var(--warning, #f59e0b); }
  .roles-list-empty { text-align: center; padding: var(--sp-8) var(--sp-4); color: var(--ink-3); font-size: var(--fs-sm); }
  .roles-editor-pane { display: flex; flex-direction: column; overflow: hidden; }
  .roles-editor-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; flex: 1; gap: var(--sp-3); color: var(--ink-3);
  }
  .roles-editor-empty .material-symbols-outlined { font-size: 48px; }
  .roles-editor-scroll { flex: 1; overflow-y: auto; padding: var(--sp-5); }
  .roles-editor-toolbar {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-5); border-top: 1px solid var(--line);
    background: var(--surface); flex-shrink: 0;
  }
  .role-meta-row {
    display: grid; grid-template-columns: auto 60px 1fr;
    gap: var(--sp-3); align-items: center; margin-bottom: var(--sp-4);
  }
  .role-icon-picker {
    font-size: 28px; cursor: pointer; padding: var(--sp-2);
    border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--surface-2); transition: background var(--t-base);
    text-align: center; line-height: 1.2; min-width: 48px;
  }
  .role-icon-picker:hover { background: var(--surface-3); }
  .role-color-swatch { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--line); cursor: pointer; flex-shrink: 0; }
  .role-prompt-builder { margin-top: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-lg, 10px); overflow: hidden; }
  .role-prompt-builder-header {
    display: flex; align-items: center; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4); background: var(--surface-2); border-bottom: 1px solid var(--line);
  }
  .role-prompt-builder-header span { font-size: var(--fs-sm); font-weight: 600; color: var(--ink); }
  .role-prompt-preview {
    padding: var(--sp-4); font-size: var(--fs-sm); color: var(--ink-2);
    white-space: pre-wrap; font-family: monospace; min-height: 120px;
    background: var(--surface); line-height: 1.6;
  }
  .role-prompt-preview em { color: var(--ink-4); font-style: italic; }
  .role-prompt-copy-row {
    display: flex; gap: var(--sp-2); padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line); background: var(--surface-2); flex-wrap: wrap;
  }
</style>
</head>
<body>

<div id="app">

  <!-- ============================================================
       SIDEBAR
       ============================================================ -->
  <aside id="sidebar">
    <div class="brand">
      <div class="brand-mark">P</div>
      <div>
        <span class="brand-name">Prompt Library</span>
        <span class="brand-pro" id="premiumBadge" hidden>PRO</span>
      </div>
    </div>

    <nav class="nav-section">
      <button class="nav-item active" data-view="library">
        <span class="material-symbols-outlined">menu_book</span>
        <span>Library</span>
        <span class="nav-count" id="libraryCount">0</span>
      </button>
      <button class="nav-item" data-view="favorites">
        <span class="material-symbols-outlined">star</span>
        <span>Favourites</span>
        <span class="nav-count" id="favCount">0</span>
      </button>
      <button class="nav-item premium-locked" data-view="analytics" data-premium="true" id="analyticsNavBtn">
        <span class="material-symbols-outlined">monitoring</span>
        <span>Analytics</span>
        <span class="nav-lock material-symbols-outlined">lock</span>
      </button>
      <button class="nav-item" data-view="roles" id="rolesNavBtn">
        <span class="material-symbols-outlined">person_play</span>
        <span>Roles</span>
        <span class="nav-count" id="rolesCount">0</span>
      </button>
    </nav>

    <div id="sidebarScroll">

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="folders" aria-expanded="true">
          <span>Folders</span>
          <span style="display:inline-flex; align-items:center; gap:4px;">
            <button class="nav-icon-btn" id="newFolderBtn" title="New folder" aria-label="New folder">
              <span class="material-symbols-outlined">add</span>
            </button>
            <span class="material-symbols-outlined chev">expand_more</span>
          </span>
        </div>
        <div class="nav-section-content" id="folders-content">
          <div id="foldersList" class="filter-list"></div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="categories" aria-expanded="true">
          <span>Categories</span>
          <span class="material-symbols-outlined chev">expand_more</span>
        </div>
        <div class="nav-section-content" id="categories-content">
          <div id="categoriesList" class="filter-list"></div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label" data-toggle="tags" aria-expanded="true">
          <span>Tags</span>
          <span class="material-symbols-outlined chev">expand_more</span>
        </div>
        <div class="nav-section-content" id="tags-content">
          <div id="tagsList" class="filter-list"></div>
        </div>
      </div>

    </div>

    <div class="sidebar-footer">
      <div class="sidebar-footer-row">
        <button class="sidebar-footer-btn" id="importBtn">
          <span class="material-symbols-outlined">upload</span>
          <span>Import</span>
        </button>
        <button class="sidebar-footer-btn" id="exportBtn">
          <span class="material-symbols-outlined">download</span>
          <span>Export</span>
        </button>
      </div>
      <button class="sidebar-footer-btn" id="themeToggleBtn">
        <span class="material-symbols-outlined" id="themeIcon">dark_mode</span>
        <span id="themeLabel">Dark mode</span>
      </button>
      <button class="sidebar-footer-btn" id="licenceBtn">
        <span class="material-symbols-outlined">workspace_premium</span>
        <span id="licenceBtnLabel">Unlock Pro</span>
      </button>
    </div>
  </aside>

  <!-- ============================================================
       MAIN
       ============================================================ -->
  <main id="main">

    <header id="contentHeader">
      <div class="header-top">
        <div class="header-title-group">
          <div id="breadcrumb"></div>
          <h1 id="viewTitle">Library</h1>
        </div>
        <div class="header-actions">
          <button class="icon-btn" id="sidebarToggleBtn" title="Toggle sidebar" aria-label="Toggle sidebar">
            <span class="material-symbols-outlined">menu_open</span>
          </button>
          <button class="icon-btn" id="cmdBtn" title="Command palette (Ctrl+K)" aria-label="Open command palette">
            <span class="material-symbols-outlined">search</span>
          </button>
          <button class="btn btn-accent" id="newPromptBtn">
            <span class="material-symbols-outlined">add</span>
            <span>New prompt</span>
          </button>
        </div>
      </div>

      <div id="folderViewActions" class="filter-bar" style="display:none; margin-bottom: var(--sp-3);"></div>

      <div class="filter-bar" id="libraryFilterBar">
        <div id="searchWrap">
          <span class="material-symbols-outlined">search</span>
          <input type="search" id="searchInput" placeholder="Search prompts, descriptions, tags..." autocomplete="off" />
          <span class="search-kbd">/</span>
        </div>
        <button class="chip" id="filterFavChip">
          <span class="material-symbols-outlined">star</span>
          Favourites
        </button>
        <button class="chip premium-locked" id="filterRatedChip" data-premium="true">
          <span class="material-symbols-outlined">star_rate</span>
          Rated
        </button>
        <button class="chip" id="activeFilterPill" hidden>
          <span class="material-symbols-outlined">close</span>
          <span id="activeFilterLabel"></span>
        </button>
        <span id="viewCount">0 prompts</span>
      </div>

      <div class="sort-bar">
        <span>Sort</span>
        <select id="sortSelect">
          <option value="updated">Recently updated</option>
          <option value="created">Date created</option>
          <option value="title">Title A-Z</option>
          <option value="used">Most used</option>
          <option value="rating">Top rated</option>
        </select>
        <div class="view-toggle" id="viewToggle">
          <button data-mode="list" class="active">
            <span class="material-symbols-outlined">view_agenda</span>
            List
          </button>
          <button data-mode="grid">
            <span class="material-symbols-outlined">grid_view</span>
            Grid
          </button>
        </div>
        <button class="chip" id="groupFolderBtn">
          <span class="material-symbols-outlined">folder_special</span>
          Group by folder
        </button>
      </div>
    </header>

    <div id="content">
      <div id="promptsContainer" class="list-view"></div>
    </div>

    <!-- ============================================================
         DETAIL PANEL
         ============================================================ -->
    <aside id="detailPanel" aria-hidden="true">
      <div class="detail-header">
        <div class="detail-actions">
          <button class="icon-btn" id="panelFavBtn" title="Toggle favourite">
            <span class="material-symbols-outlined">favorite</span>
          </button>
          <button class="icon-btn premium-locked" id="panelDuplicateBtn" data-premium="true" title="Duplicate">
            <span class="material-symbols-outlined">content_copy</span>
          </button>
          <button class="icon-btn" id="panelEditBtn" title="Edit">
            <span class="material-symbols-outlined">edit</span>
          </button>
          <button class="icon-btn danger" id="panelDeleteBtn" title="Delete">
            <span class="material-symbols-outlined">delete</span>
          </button>
        </div>
        <button class="icon-btn" id="closeDetailPanel" title="Close" aria-label="Close panel">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <nav class="detail-tabs">
        <button class="detail-tab active" data-tab="prompt">Prompt</button>
        <button class="detail-tab premium-locked" data-tab="notes" data-premium="true">Notes &amp; rating <span class="lock material-symbols-outlined">lock</span></button>
        <button class="detail-tab premium-locked" data-tab="chain" data-premium="true">Chain <span class="lock material-symbols-outlined">lock</span></button>
        <button class="detail-tab premium-locked" data-tab="history" data-premium="true">History <span class="lock material-symbols-outlined">lock</span></button>
      </nav>

      <div id="detailBody">

        <div class="detail-tab-pane active" id="tab-prompt">
          <div id="detailChips" class="detail-chips"></div>
          <h2 id="detailTitle"></h2>
          <p id="detailDesc"></p>

          <div class="detail-section-label">
            Prompt
            <span class="vars-badge" id="detailVarBadge" hidden>
              <span class="material-symbols-outlined">token</span>
              <span id="detailVarCount">0 variables</span>
            </span>
          </div>
          <div id="detailPromptText"></div>

          <div id="usePromptSection" hidden>
            <div class="detail-section-label">Fill variables</div>
            <div id="variableFields"></div>
          </div>

          <div class="meta-grid">
            <div class="meta-cell">
              <span class="material-symbols-outlined">calendar_month</span>
              <div>
                <div class="meta-label">Created</div>
                <div class="meta-value" id="metaCreated">-</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">bolt</span>
              <div>
                <div class="meta-label">Total uses</div>
                <div class="meta-value" id="metaUseCount">0</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">folder</span>
              <div>
                <div class="meta-label">Folder</div>
                <div class="meta-value" id="metaFolder">-</div>
              </div>
            </div>
            <div class="meta-cell">
              <span class="material-symbols-outlined">schedule</span>
              <div>
                <div class="meta-label">Last used</div>
                <div class="meta-value" id="metaLastUsed">Never</div>
              </div>
            </div>
          </div>
        </div>

        <div class="detail-tab-pane" id="tab-notes">
          <div class="detail-section-label">Rating</div>
          <div class="stars" id="detailRatingStars"></div>
          <div class="detail-section-label" style="margin-top: var(--sp-5)">Personal notes</div>
          <textarea class="form-textarea" id="detailNotes" rows="6" placeholder="Notes, reminders, things to revise..."></textarea>
          <button class="btn btn-primary" id="saveNotesBtn" style="margin-top: var(--sp-3); width: 100%; justify-content: center;">
            <span class="material-symbols-outlined">save</span>
            Save notes &amp; rating
          </button>
        </div>

        <div class="detail-tab-pane" id="tab-chain">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--sp-3);">
            <p style="font-size: var(--fs-sm); color: var(--ink-3); margin:0;">
              Steps in this prompt's workflow.
            </p>
            <button class="btn btn-accent" id="runChainBtn" style="display:none; font-size: 12px; padding: 6px 12px;">
              <span class="material-symbols-outlined" style="font-size:15px;">play_arrow</span>
              Run chain
            </button>
          </div>
          <div id="detailChainSteps"></div>
          <div id="chainRunnerWrap" style="display:none;"></div>
          <p id="detailChainEmpty" class="hidden" style="font-size: var(--fs-sm); color: var(--ink-3);">
            No chain yet. Edit this prompt to add steps.
          </p>
        </div>

        <div class="detail-tab-pane" id="tab-history">
          <p style="font-size: var(--fs-sm); color: var(--ink-3); margin-bottom: var(--sp-3);">
            Up to 20 versions kept per prompt. Click any version to restore.
          </p>
          <div id="versionList"></div>
          <p id="versionEmpty" class="hidden" style="font-size: var(--fs-sm); color: var(--ink-3);">
            No previous versions.
          </p>
        </div>

      </div>

      <div class="detail-footer">
        <button class="icon-btn" id="footerExportBtn" title="Export this prompt as JSON">
          <span class="material-symbols-outlined">ios_share</span>
        </button>
        <button class="icon-btn premium-locked" id="footerMdBtn" data-premium="true" title="Export as Markdown">
          <span class="material-symbols-outlined">description</span>
        </button>
        <button class="btn btn-accent" id="copyToClipboardBtn">
          <span class="material-symbols-outlined">content_copy</span>
          Copy to clipboard
        </button>
      </div>
    </aside>

  
  <!-- ROLES WORKSPACE -->
  <div id="rolesWorkspace" role="dialog" aria-modal="true" aria-label="Roles workspace">
    <div class="roles-header">
      <span class="material-symbols-outlined" style="font-size:24px;color:var(--accent)">person_play</span>
      <h2>Roles</h2>
      <button class="btn btn-ghost" id="rolesNewBtn"><span class="material-symbols-outlined">add</span> New role</button>
      <button class="icon-btn" id="rolesCloseBtn" title="Close" aria-label="Close"><span class="material-symbols-outlined">close</span></button>
    </div>
    <div class="roles-body">
      <div class="roles-list-pane">
        <div class="roles-list-search">
          <input type="search" id="rolesSearch" class="form-input" placeholder="Search roles…" autocomplete="off" />
        </div>
        <div class="roles-list-scroll" id="rolesListScroll">
          <div class="roles-list-empty" id="rolesListEmpty" style="display:none;">
            <span class="material-symbols-outlined" style="font-size:32px;display:block;margin-bottom:8px;">person_off</span>
            No roles yet. Create one to get started.
          </div>
          <div id="rolesList"></div>
        </div>
      </div>
      <div class="roles-editor-pane" id="rolesEditorPane">
        <div class="roles-editor-empty" id="rolesEditorEmpty">
          <span class="material-symbols-outlined">arrow_back</span>
          <p style="font-size:var(--fs-sm);margin:0;">Select a role or create a new one</p>
        </div>
        <div id="rolesEditorForm" style="display:none;flex:1;overflow:hidden;flex-direction:column;">
          <div class="roles-editor-scroll">
            <div class="role-meta-row">
              <button type="button" class="role-icon-picker" id="roleIconBtn" title="Click to change icon">🎯</button>
              <input type="color" id="roleColourPicker" class="role-color-swatch" value="#6366f1" title="Role colour" />
              <div>
                <label class="form-label" for="roleNameInput">Role name</label>
                <input type="text" id="roleNameInput" class="form-input" placeholder="e.g. Senior Copywriter" maxlength="80" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="rolePersonaInput">Persona <span style="color:var(--ink-4);font-weight:400;">(system prompt / who the AI should be)</span></label>
              <textarea id="rolePersonaInput" class="form-input" rows="5" placeholder="You are a senior copywriter with 10 years of experience…"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" for="roleToneInput">Tone</label>
              <input type="text" id="roleToneInput" class="form-input" placeholder="e.g. Confident, concise, no fluff" />
            </div>
            <div class="form-group">
              <label class="form-label" for="roleExpertiseInput">Expertise</label>
              <input type="text" id="roleExpertiseInput" class="form-input" placeholder="e.g. Email marketing, SaaS landing pages, B2B sales copy" />
