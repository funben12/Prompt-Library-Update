    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-variation-settings: "opsz" 36, "SOFT" 50;
    overflow: hidden; text-overflow: ellipsis;
    /* standard property for compatibility */
    line-clamp: 1;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
    flex: 1; min-width: 0;
  }
  .card-fav { color: var(--gold); font-size: 16px; }
  .card-rating { color: var(--gold); font-size: 12px; letter-spacing: 1px; font-variant-numeric: tabular-nums; }

  .card-desc {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    overflow: hidden; text-overflow: ellipsis;
