    font-size: 12px; color: var(--ink-3);
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .card-meta-item { display: inline-flex; align-items: center; gap: 4px; }
  .card-meta-item .material-symbols-outlined { font-size: 13px; }
