  .detail-tabs::-webkit-scrollbar { display: none; }
  .detail-tab {
    padding: 12px 14px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .detail-tab:hover { color: var(--ink); }
  .detail-tab.active { color: var(--ink); border-color: var(--accent); font-weight: 600; }
  .detail-tab .lock { font-size: 12px; opacity: 0.6; margin-left: 4px; vertical-align: -2px; }

  #detailBody {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-5);
  }
  .detail-tab-pane { display: none; }
  .detail-tab-pane.active { display: block; }

  .detail-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: var(--sp-3); }
  #detailTitle {
    font-family: var(--ff-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: var(--sp-2);
    font-variation-settings: "opsz" 72, "SOFT" 40;
  }
  #detailDesc { font-size: var(--fs-sm); color: var(--ink-3); margin-bottom: var(--sp-5); }

  .detail-section-label {
    display: flex; align-items: center; justify-content: space-between;
    color: var(--ink-3);
