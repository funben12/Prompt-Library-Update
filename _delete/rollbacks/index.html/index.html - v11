  .modal-overlay {
    position: fixed; inset: 0;
    background: oklch(15% 0.012 75 / 0.4);
    backdrop-filter: blur(2px);
    display: none;
    z-index: var(--z-overlay);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out-quart);
  }
  .modal-overlay.active { display: grid; place-items: center; opacity: 1; }
