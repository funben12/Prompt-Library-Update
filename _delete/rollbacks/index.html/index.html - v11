  #searchInput { flex: 1; background: transparent; border: 0; outline: 0; font-size: var(--fs-sm); color: var(--ink); }
  #searchInput::placeholder { color: var(--ink-4); }

  .search-kbd {
    font-family: var(--ff-mono);
    font-size: 11px;
    color: var(--ink-3);
    background: var(--surface);
    border: 1px solid var(--line);
