    font-size: 12px; font-weight: 500;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .view-toggle button:hover { color: var(--ink); }
  .view-toggle button.active { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-sm); }
  .view-toggle .material-symbols-outlined { font-size: 14px; }

  #viewCount {
    margin-left: auto;
    color: var(--ink-3);
    font-size: 12px; font-variant-numeric: tabular-nums;
  }
}
@layer components {
  #promptsContainer { container-type: inline-size; }

  /* List view: editorial rows. Each row = a manuscript page. */
  #promptsContainer.list-view .prompt-card {
    display: grid;
    grid-template-columns: 4px 1fr auto;
    gap: var(--sp-5);
    align-items: stretch;
    padding: var(--sp-5) var(--sp-5) var(--sp-5) 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    cursor: pointer;
    transition: background var(--t-fast);
  }
  #promptsContainer.list-view .prompt-card:hover { background: var(--surface-2); }
  #promptsContainer.list-view .prompt-card.active { background: var(--accent-soft); }
  #promptsContainer.list-view .card-rule { width: 4px; border-radius: 2px; }
  #promptsContainer.list-view .card-actions {
    align-self: flex-start;
    opacity: 0;
    transition: opacity var(--t-fast);
  }
  #promptsContainer.list-view .prompt-card:hover .card-actions { opacity: 1; }

  /* Grid view: cards. */
  #promptsContainer.grid-view {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: var(--sp-4);
  }
  #promptsContainer.grid-view .prompt-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-4) var(--sp-5);
    cursor: pointer;
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: var(--sp-4);
    box-shadow: var(--neu-raised);
    transition: border-color var(--t-fast), background var(--t-fast),
                transform var(--t-fast), box-shadow var(--t-fast);
  }
  #promptsContainer.grid-view .prompt-card:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
    transform: translateY(-2px);
    box-shadow: var(--neu-raised), 0 4px 12px oklch(18% 0.04 260 / 0.08);
  }
  #promptsContainer.grid-view .prompt-card.active { border-color: var(--accent); background: var(--accent-soft); }
  #promptsContainer.grid-view .card-rule { width: 4px; border-radius: 2px; }
  #promptsContainer.grid-view .card-actions { display: none; }

  .prompt-card .card-rule { background: var(--line-strong); }
  .prompt-card .card-rule.c-red    { background: var(--c-red); }
  .prompt-card .card-rule.c-orange { background: var(--c-orange); }
  .prompt-card .card-rule.c-yellow { background: var(--c-yellow); }
  .prompt-card .card-rule.c-green  { background: var(--c-green); }
  .prompt-card .card-rule.c-teal   { background: var(--c-teal); }
  .prompt-card .card-rule.c-blue   { background: var(--c-blue); }
  .prompt-card .card-rule.c-purple { background: var(--c-purple); }
  .prompt-card .card-rule.c-pink   { background: var(--c-pink); }

  .card-body { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .card-title-row { display: flex; align-items: baseline; gap: var(--sp-3); }
  .card-title {
