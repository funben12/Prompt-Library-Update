  .card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .card-tag {
    font-size: 11px; padding: 2px 8px;
    background: var(--surface-2);
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-weight: 500;
  }
  .card-tag.cat { background: var(--accent-soft); color: var(--accent); border-color: var(--accent-line); }

  .card-actions { display: flex; gap: 2px; }
  .card-actions .icon-btn { width: 30px; height: 30px; }
  .card-actions .icon-btn .material-symbols-outlined { font-size: 16px; }
  .card-actions .icon-btn.fav-on { color: var(--gold); }
  .card-actions .icon-btn.fav-on .material-symbols-outlined { font-variation-settings: "FILL" 1; }

  /* Folder grouping headers */
  .folder-group-header {
    display: flex; align-items: baseline; gap: var(--sp-3);
